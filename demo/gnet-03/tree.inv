fn tree(n: u32, seed: u32) -> u32 {
    if n < 2u32 { return seed; }
    if seed % 3u32 == 0u32 { return tree(n - 1u32, wrapping_add(wrapping_mul(seed, 7u32), 1u32)); }
    let a = tree(n - 1u32, wrapping_add(seed, 1u32));
    let b = tree(n - 2u32, wrapping_mul(seed, 5u32));
    return wrapping_add(a, b);
}
fn sum(n: u32) -> i32 { let xs = filled_i32(n, 3); var s = 0; for i in 0u32..n { s = s + xs[i]; } return s; }
fn run(n: u32, seed: u32) -> u32 { let t = tree(n, seed); if sum(n) < 0 { return 0u32; } return t; }
