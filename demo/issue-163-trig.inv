// #163: f32 sin and cos are invar-math-cr-v1 on every engine, and CUDA,
// Metal and the general net now lower them instead of keeping `run` on the CPU.
fn run(x: f32) -> f32 { return sin(x) * cos(x); }
fn bump(xs: read Array<u32>) -> Array<u32> {
    var ys = filled_u32(len(xs), 0u32);
    for i in 0u32..len(xs) { ys[i] = wrapping_add(xs[i], 3u32); }
    return ys;
}
fn main() -> i32 {
    let xs: Array<u32> = filled_u32(4096u32, 7u32);
    let ys = bump(xs);
    let w = run(0.5);
    if w > 0.42 and w < 0.43 and ys[4095u32] == 10u32 { return 7; }
    return 0;
}
