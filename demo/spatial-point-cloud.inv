fn main() -> i32 {
    let xs = scan_x();
    let ys = scan_y();
    let zs = scan_z();
    let grid = voxel_grid_build(xs, ys, zs, 0.05);
    let qx: Array<f32> = [-0.933870018, 0.172020003, 0.563510001, -0.714709997, -0.335869998, 0.0283049997, 0.436569989, -1.04400003, -0.168880001, 0.0102479998, 0.303579986, 0.109310001, -0.631829977, 0.19337, -0.416649997, 0.406709999];
    let qy: Array<f32> = [-0.682500005, -0.687950015, -0.679430008, -0.653620005, -0.620490015, -0.586179972, -0.543309987, -0.502349973, -0.457920015, -0.401670009, -0.324290007, 0.00034631, 0.0445999987, 0.0975920036, 0.173189998, 0.282660007];
    let qz: Array<f32> = [-1.18649995, -1.1918, -1.2062, -1.24129999, -1.30309999, -1.37339997, -1.43260002, -1.51349998, -1.60119998, -1.71099997, -1.84920001, -1.12979996, -1.05630004, -1.15740001, -1.28289998, -1.47710001];
    let near = radius_neighbors(grid, qx, qy, qz, 0.05, 32u32);
    let counts = move near.counts;
    var neighbor_count: i32 = 0;
    for i in 0u32..16u32 {
        var remaining = counts[i];
        while remaining > 0u32 {
            neighbor_count = neighbor_count + 1;
            remaining = remaining - 1u32;
        }
    }
    return neighbor_count;
}
