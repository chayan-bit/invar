// #362: a pair outside the loop no longer costs the loop its parallel admission.
fn main() -> i32 {
    let p: (u32, u32) = (3u32, 4u32);
    let xs: Array<u32> = filled_u32(4096u32, 7u32);
    var acc: u32 = 0u32;
    for i in 0u32 .. len(xs) {
        acc = wrapping_add(acc, xs[i]);
    }
    if acc == 28672u32 and p.0 == 3u32 { return 1; }
    return 0;
}
