// #204: the first overflow in source order wins, even when a later chunk
// also leaves the i32 range; every engine traps at the same `+` and fuel.
fn main() -> i32 {
    var a = filled_i32(1000u32, 3100000);
    a[900u32] = -2147483647;
    var s: i32 = 0;
    for i in 0u32..1000u32 { s = s + a[i]; }
    return s;
}
