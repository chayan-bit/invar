// #256: for i in lo .. hi step k counts ceil((hi - lo) / k) trips.
fn main() -> i32 {
    let xs: Array<u32> = [1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 7u32];
    var odd: u32 = 0u32;
    var trips: u32 = 0u32;
    for i in 0u32 .. len(xs) step 2u32 {
        odd += xs[i];
        trips += 1u32;
    }
    for j in 5u32 .. 2u32 step 1u32 {
        trips += 100u32;
    }
    if odd == 16u32 and trips == 4u32 {
        return 1;
    }
    return 0;
}
