{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chayan-bit/invar/blob/main/schema/invar-diagnostics-v3.schema.json",
  "title": "invar-diagnostics-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "invar-diagnostics-v3"
    },
    "schema_version": {
      "const": 3
    },
    "status": {
      "enum": [
        "ok",
        "source_error",
        "tool_error",
        "trap",
        "evaluation_limit"
      ]
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "i32"
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "checks_completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks_pending": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "span"
      ],
      "properties": {
        "category": {
          "enum": [
            "INTEGER_OVERFLOW",
            "DIVISION_BY_ZERO",
            "INDEX_OUT_OF_BOUNDS",
            "UNIT_CONVERSION_INEXACT"
          ]
        },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            }
          }
        }
      }
    },
    "fuel_limit": {
      "type": "integer",
      "minimum": 1
    },
    "steps_used": {
      "type": "integer",
      "minimum": 0
    },
    "tool_code": {
      "type": "string"
    },
    "cleanup_trace": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "length"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "length": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "steps_used_at_limit": {
      "type": "integer",
      "minimum": 0
    },
    "normal_form": {
      "description": "P6(a) normal-form route (#54): the laws the law executor applied with the checked certificate identity, or why the serial path ran.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "laws",
            "certificates",
            "fingerprint",
            "certificate_digest",
            "lanes"
          ],
          "properties": {
            "status": {
              "const": "routed"
            },
            "laws": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^L[0-9]+$"
              }
            },
            "certificates": {
              "type": "integer",
              "minimum": 1
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "certificate_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "lanes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "fallback"
            },
            "reason": {
              "anyOf": [
                {
                  "enum": [
                    "recursion-law-not-routed",
                    "certificate-rejected",
                    "residue-law-not-routed",
                    "executor-refused",
                    "no-law-applied",
                    "law-state-violation",
                    "call-depth-unproven",
                    "fuel-unproven",
                    "live-elements-unproven",
                    "executor-tool-limit"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^no-lowering:[a-z]+/[a-z]+(-[a-z]+)*$"
                }
              ]
            }
          }
        }
      ]
    },
    "placement": {
      "type": "object",
      "required": [
        "profile_id",
        "profile_schema_version",
        "resource_identity",
        "trust_provisional",
        "engine",
        "choices"
      ],
      "properties": {
        "profile_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_schema_version": {
          "enum": [
            1,
            null
          ]
        },
        "profile_identity": {
          "type": [
            "object",
            "null"
          ]
        },
        "resource_identity": {
          "type": "object"
        },
        "trust_provisional": {
          "type": "boolean"
        },
        "engine": {
          "enum": [
            "cpu",
            "cuda",
            "metal",
            "none"
          ]
        },
        "refusal_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_cost": {
          "type": "object"
        },
        "variants": {
          "type": "array"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "profile_id",
              "profile_schema_version",
              "engine",
              "family",
              "numeric_contract_version",
              "cpu_ms",
              "variants",
              "published"
            ],
            "properties": {
              "engine": {
                "enum": [
                  "cpu",
                  "cuda",
                  "metal"
                ]
              },
              "published": {
                "type": "boolean"
              },
              "cpu_ms": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "reductions": {
          "description": "Float reduction receipts of the run, as the established auto path records them in device_execution.choices (#50). Recorded on the reference route; absent on the native route (route.host native), whose compiled code keeps no per-call receipts.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "function": {
                "type": "string"
              },
              "span": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "start",
                  "end"
                ]
              },
              "backend": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "cuda-failed-before-publication",
                  "cuda-feature-unavailable",
                  "device-plan-ineligible",
                  "device-unavailable",
                  "forced-device",
                  "live-guard-false",
                  "measured-cpu-cost",
                  "measured-device-cost",
                  "metal-buffer-slot-limit",
                  "metal-failed-before-publication",
                  "metal-no-f64",
                  "publication-guard-false",
                  "sort-cost-unmeasured",
                  "spatial-cost-unmeasured",
                  "spatial-host-work",
                  "staged-consumer",
                  "toolchain-unavailable"
                ]
              },
              "kind": {
                "type": "string"
              },
              "cost_ms": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "cpu": {
                        "type": "number"
                      },
                      "device": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "cpu",
                      "device"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "implementation": {
                "type": "string",
                "minLength": 1
              },
              "family_id": {
                "enum": [
                  "spatial.voxel_grid_build.f32",
                  "spatial.radius_neighbors.f32",
                  "spatial.knn.f32",
                  "spatial.grid_excluded.f32"
                ]
              }
            },
            "required": [
              "function",
              "span",
              "backend",
              "reason"
            ]
          }
        },
        "intrinsics": {
          "description": "Sort and spatial sites of the run, run on the established CPU engines and recorded as the established auto path records them in device_execution.choices (#50). Recorded on the reference route; absent on the native route (route.host native), whose compiled code keeps no per-call receipts.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "function": {
                "type": "string"
              },
              "span": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "start",
                  "end"
                ]
              },
              "backend": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "cuda-failed-before-publication",
                  "cuda-feature-unavailable",
                  "device-plan-ineligible",
                  "device-unavailable",
                  "forced-device",
                  "live-guard-false",
                  "measured-cpu-cost",
                  "measured-device-cost",
                  "metal-buffer-slot-limit",
                  "metal-failed-before-publication",
                  "metal-no-f64",
                  "publication-guard-false",
                  "sort-cost-unmeasured",
                  "spatial-cost-unmeasured",
                  "spatial-host-work",
                  "staged-consumer",
                  "toolchain-unavailable"
                ]
              },
              "kind": {
                "type": "string"
              },
              "cost_ms": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "cpu": {
                        "type": "number"
                      },
                      "device": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "cpu",
                      "device"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "implementation": {
                "type": "string",
                "minLength": 1
              },
              "family_id": {
                "enum": [
                  "spatial.voxel_grid_build.f32",
                  "spatial.radius_neighbors.f32",
                  "spatial.knn.f32",
                  "spatial.grid_excluded.f32"
                ]
              }
            },
            "required": [
              "function",
              "span",
              "backend",
              "reason"
            ]
          }
        },
        "legality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "reason",
            "engines"
          ],
          "properties": {
            "policy": {
              "const": "legal-set-cpu"
            },
            "reason": {
              "const": "uncalibrated"
            },
            "engines": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "engine",
                    "legal",
                    "compiled",
                    "reason"
                  ],
                  "properties": {
                    "engine": {
                      "const": "cpu"
                    },
                    "legal": {
                      "const": true
                    },
                    "compiled": {
                      "type": "boolean"
                    },
                    "reason": {
                      "enum": [
                        null,
                        "native-feature-unavailable"
                      ]
                    }
                  },
                  "if": {
                    "properties": {
                      "compiled": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "reason": {
                        "const": null
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "reason": {
                        "const": "native-feature-unavailable"
                      }
                    }
                  }
                },
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/device_legality"
                    },
                    {
                      "properties": {
                        "engine": {
                          "const": "cuda"
                        }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/device_legality"
                    },
                    {
                      "properties": {
                        "engine": {
                          "const": "metal"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "reason"
          ],
          "properties": {
            "host": {
              "enum": [
                "native",
                "reference"
              ]
            },
            "reason": {
              "enum": [
                null,
                "native-feature-unavailable",
                "profiled-regions"
              ]
            }
          },
          "if": {
            "properties": {
              "host": {
                "const": "native"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "route",
              "legality"
            ]
          },
          "then": {
            "if": {
              "properties": {
                "route": {
                  "properties": {
                    "reason": {
                      "const": "native-feature-unavailable"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "legality": {
                  "properties": {
                    "engines": {
                      "prefixItems": [
                        {
                          "properties": {
                            "compiled": {
                              "const": false
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "legality": {
                  "properties": {
                    "engines": {
                      "prefixItems": [
                        {
                          "properties": {
                            "compiled": {
                              "const": true
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "route"
            ],
            "properties": {
              "route": {
                "properties": {
                  "host": {
                    "const": "native"
                  }
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reductions"
                  ]
                },
                {
                  "required": [
                    "intrinsics"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "route",
              "engine"
            ],
            "properties": {
              "route": {
                "properties": {
                  "host": {
                    "const": "reference"
                  }
                }
              },
              "engine": {
                "not": {
                  "const": "none"
                }
              }
            }
          },
          "then": {
            "required": [
              "reductions",
              "intrinsics"
            ]
          }
        }
      ]
    },
    "auto_path": {
      "description": "Present on --engine auto runs only: which auto path ran.",
      "enum": [
        "established",
        "placement"
      ]
    },
    "numeric_contracts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "binary64": {
          "const": "strict-f64-v1"
        },
        "math": {
          "const": "invar-math-cr-v1"
        },
        "trig": {
          "const": "invar-trig-f32-v1"
        },
        "fold": {
          "description": "Each declared fold tier a lowered fold used, to the algorithm that ran. A Strict function's reassoc_add folds record as relaxed.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "tree": {
              "const": "tree"
            },
            "exact": {
              "const": "exact"
            },
            "relaxed": {
              "enum": [
                "tree",
                "exact"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start",
        "end",
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_column": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span",
        "replacement"
      ],
      "properties": {
        "span": {
          "$ref": "#/$defs/span"
        },
        "replacement": {
          "type": "string",
          "maxLength": 65536
        }
      }
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "edits"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 256
        },
        "edits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/edit"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "path",
        "span",
        "secondary_spans",
        "suggested_fixes",
        "notes",
        "ir_path"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^(?:[A-Z][A-Z0-9_]*|S1[0-9]{3})$"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "note"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        },
        "secondary_spans": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "span",
              "label"
            ],
            "properties": {
              "span": {
                "$ref": "#/$defs/span"
              },
              "label": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        },
        "suggested_fixes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/fix"
          }
        },
        "notes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "ir_path": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "device_legality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "legal",
        "refusal",
        "forks",
        "serialized"
      ],
      "properties": {
        "engine": {
          "enum": [
            "cuda",
            "metal"
          ]
        },
        "legal": {
          "type": "boolean"
        },
        "refusal": {
          "enum": [
            "net_structural_budget",
            "net_boundary",
            "source",
            "admission_budget",
            "input",
            "oversize",
            "alias",
            "wrong_layout",
            "unsupported_type",
            "borrowed",
            "backend",
            "image",
            "fence",
            "host_protocol",
            "unsupported_rule",
            "unsupported_call",
            "owner_entry_result",
            "compiler_structural_budget",
            "entry",
            "compiler_boundary",
            null
          ]
        },
        "forks": {
          "type": "integer",
          "minimum": 0
        },
        "serialized": {
          "type": "array",
          "items": {
            "enum": [
              "affine_argument",
              "owner_result",
              "dependent_argument",
              "ordered_prelude",
              "projection_limit"
            ]
          }
        }
      },
      "if": {
        "properties": {
          "legal": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "refusal": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "refusal": {
            "type": "string"
          },
          "forks": {
            "const": 0
          },
          "serialized": {
            "maxItems": 0
          }
        }
      }
    }
  },
  "if": {
    "required": [
      "auto_path"
    ],
    "properties": {
      "auto_path": {
        "const": "placement"
      }
    }
  },
  "then": {
    "required": [
      "placement"
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "placement"
          ]
        }
      ]
    }
  }
}
