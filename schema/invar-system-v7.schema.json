{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invar.dev/schema/invar-system-v7.schema.json",
  "title": "Invar checked system IR v7: bounded planner wire contract",
  "type": "object",
  "required": [
    "schema",
    "version",
    "system",
    "frames",
    "components",
    "extern_components",
    "connections",
    "flows",
    "products",
    "planner_contract"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "invar-system-v7"
    },
    "version": {
      "const": 7
    },
    "system": {
      "$ref": "#/$defs/system"
    },
    "frames": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/frame"
      }
    },
    "components": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "extern_components": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "products": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "robots": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/robot_model"
      }
    },
    "cells": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/cell_model"
      }
    },
    "planner_contract": {
      "const": "invar-planner-wire-v1"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "decimal": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "quantity": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/decimal"
        },
        "unit": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "quantities": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "$ref": "#/$defs/quantity"
      }
    },
    "frame": {
      "type": "object",
      "required": [
        "id",
        "name",
        "parent"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "port": {
      "type": "object",
      "required": [
        "name",
        "direction",
        "type",
        "rate",
        "latency",
        "optional",
        "layout",
        "bus"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "direction": {
          "enum": [
            "in",
            "out"
          ]
        },
        "type": {
          "$ref": "#/$defs/name"
        },
        "rate": {
          "$ref": "#/$defs/quantity"
        },
        "latency": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "layout": {
          "type": [
            "string",
            "null"
          ]
        },
        "bus": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "expression",
        "link",
        "modified",
        "replaceable",
        "network_exposed",
        "grant"
      ],
      "additionalProperties": false,
      "properties": {
        "expression": {
          "$ref": "#/$defs/name"
        },
        "link": {
          "type": [
            "string",
            "null"
          ]
        },
        "modified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "replaceable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "network_exposed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "grant": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "implementation": {
      "type": "object",
      "required": [
        "kind",
        "target",
        "link"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "extern",
            "invar"
          ]
        },
        "target": {
          "$ref": "#/$defs/name"
        },
        "link": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "abi": {
      "type": "object",
      "required": [
        "kind",
        "prefix"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "c"
        },
        "prefix": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "name",
        "external",
        "ports",
        "params",
        "resources",
        "license",
        "isolation",
        "wcet",
        "deadline",
        "implementation",
        "abi",
        "lifecycle",
        "golden",
        "properties",
        "shim",
        "config",
        "inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "external": {
          "type": "boolean"
        },
        "ports": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "params": {
          "$ref": "#/$defs/parameters"
        },
        "resources": {
          "$ref": "#/$defs/quantities"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "isolation": {
          "enum": [
            "in-process",
            "separate-process",
            "separate-partition"
          ]
        },
        "wcet": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "implementation": {
          "anyOf": [
            {
              "$ref": "#/$defs/implementation"
            },
            {
              "type": "null"
            }
          ]
        },
        "abi": {
          "anyOf": [
            {
              "$ref": "#/$defs/abi"
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycle": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "golden": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/golden"
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "shim": {
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/config"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "connection": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "policy"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "source": {
          "$ref": "#/$defs/name"
        },
        "target": {
          "$ref": "#/$defs/name"
        },
        "policy": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "flow": {
      "type": "object",
      "required": [
        "id",
        "name",
        "ports",
        "within"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "ports": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "within": {
          "$ref": "#/$defs/quantity"
        }
      }
    },
    "product": {
      "type": "object",
      "required": [
        "id",
        "name",
        "distribution",
        "commercial",
        "robot",
        "capacity"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "distribution": {
          "enum": [
            "internal",
            "proprietary-binary",
            "open"
          ]
        },
        "commercial": {
          "type": "boolean"
        },
        "robot": {
          "$ref": "#/$defs/name"
        },
        "capacity": {
          "$ref": "#/$defs/quantities"
        }
      }
    },
    "system": {
      "type": "object",
      "required": [
        "id",
        "name",
        "product",
        "instances"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "product": {
          "$ref": "#/$defs/name"
        },
        "instances": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "component"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/name"
              },
              "name": {
                "$ref": "#/$defs/name"
              },
              "component": {
                "$ref": "#/$defs/name"
              }
            }
          }
        }
      }
    },
    "identity_transform": {
      "type": "object",
      "required": [
        "kind",
        "type",
        "from",
        "to",
        "translation",
        "rotation_wxyz"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "identity-transform"
        },
        "type": {
          "type": "string",
          "pattern": "^Transform<[^,<>]+,[^,<>]+>$"
        },
        "from": {
          "$ref": "#/$defs/name"
        },
        "to": {
          "$ref": "#/$defs/name"
        },
        "translation": {
          "const": [
            "0",
            "0",
            "0"
          ]
        },
        "rotation_wxyz": {
          "const": [
            "1",
            "0",
            "0",
            "0"
          ]
        }
      }
    },
    "parameters": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/quantity"
          },
          {
            "$ref": "#/$defs/quantity_range"
          },
          {
            "$ref": "#/$defs/identity_transform"
          }
        ]
      }
    },
    "config": {
      "type": "object",
      "required": [
        "layout",
        "size",
        "align",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "layout": {
          "$ref": "#/$defs/name"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "align": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "name",
              "type",
              "offset"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "type": {
                "enum": [
                  "borrowed_utf8",
                  "u32",
                  "f64"
                ]
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              },
              "borrow": {
                "enum": [
                  "configure-call"
                ]
              }
            }
          }
        }
      }
    },
    "golden": {
      "type": "object",
      "required": [
        "path",
        "tolerances"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/name"
        },
        "tolerances": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/quantity"
          }
        }
      }
    },
    "quantity_range": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "range"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/decimal"
        },
        "unit": {
          "$ref": "#/$defs/name"
        },
        "range": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "$ref": "#/$defs/decimal"
            },
            "max": {
              "$ref": "#/$defs/decimal"
            }
          }
        }
      }
    },
    "robot_pose": {
      "type": "object",
      "required": [
        "xyz",
        "quat"
      ],
      "additionalProperties": false,
      "properties": {
        "xyz": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/quantity"
          }
        },
        "quat": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/decimal"
          }
        }
      }
    },
    "robot_geometry": {
      "type": "object",
      "required": [
        "role",
        "kind",
        "dimensions",
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "visual",
            "collision"
          ]
        },
        "kind": {
          "enum": [
            "box",
            "sphere",
            "cylinder",
            "capsule",
            "mesh"
          ]
        },
        "dimensions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/decimal"
          }
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "robot_link": {
      "type": "object",
      "required": [
        "name",
        "parent",
        "origin",
        "mass",
        "inertial_origin",
        "inertia",
        "geometries"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "parent": {
          "$ref": "#/$defs/name"
        },
        "origin": {
          "$ref": "#/$defs/robot_pose"
        },
        "mass": {
          "$ref": "#/$defs/quantity"
        },
        "inertial_origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/robot_pose"
            },
            {
              "type": "null"
            }
          ]
        },
        "inertia": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/decimal"
          }
        },
        "geometries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/robot_geometry"
          }
        }
      }
    },
    "robot_joint": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "parent",
        "child",
        "axis",
        "position",
        "velocity",
        "effort"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "kind": {
          "enum": [
            "revolute",
            "prismatic",
            "fixed"
          ]
        },
        "parent": {
          "$ref": "#/$defs/name"
        },
        "child": {
          "$ref": "#/$defs/name"
        },
        "axis": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/decimal"
          }
        },
        "position": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "lower",
                "upper"
              ],
              "additionalProperties": false,
              "properties": {
                "lower": {
                  "$ref": "#/$defs/quantity"
                },
                "upper": {
                  "$ref": "#/$defs/quantity"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "velocity": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "robot_actuator": {
      "type": "object",
      "required": [
        "name",
        "mode",
        "target_kind",
        "target",
        "gear",
        "control"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "mode": {
          "enum": [
            "position",
            "velocity",
            "motor-torque"
          ]
        },
        "gear": {
          "$ref": "#/$defs/decimal"
        },
        "control": {
          "type": "object",
          "required": [
            "lower",
            "upper"
          ],
          "additionalProperties": false,
          "properties": {
            "lower": {
              "$ref": "#/$defs/quantity"
            },
            "upper": {
              "$ref": "#/$defs/quantity"
            }
          }
        },
        "target_kind": {
          "enum": [
            "joint",
            "tendon"
          ]
        },
        "target": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "robot_sensor": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "source",
        "intrinsics"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "kind": {
          "enum": [
            "joint-position",
            "joint-velocity",
            "force-torque",
            "camera"
          ]
        },
        "source": {
          "$ref": "#/$defs/name"
        },
        "intrinsics": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/camera_intrinsics"
            }
          ]
        }
      }
    },
    "camera_intrinsics": {
      "type": "object",
      "required": [
        "schema",
        "scalar",
        "width_px",
        "height_px",
        "fx_px",
        "fy_px",
        "cx_px",
        "cy_px",
        "distortion"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "invar-camera-intrinsics-v1"
        },
        "scalar": {
          "const": "f64"
        },
        "width_px": {
          "$ref": "#/$defs/decimal"
        },
        "height_px": {
          "$ref": "#/$defs/decimal"
        },
        "fx_px": {
          "$ref": "#/$defs/decimal"
        },
        "fy_px": {
          "$ref": "#/$defs/decimal"
        },
        "cx_px": {
          "$ref": "#/$defs/decimal"
        },
        "cy_px": {
          "$ref": "#/$defs/decimal"
        },
        "distortion": {
          "type": "object",
          "required": [
            "model",
            "coefficients"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "const": "none"
            },
            "coefficients": {
              "const": []
            }
          }
        }
      }
    },
    "robot_asset": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "mjcf",
            "urdf"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "robot_model": {
      "type": "object",
      "required": [
        "id",
        "name",
        "license",
        "asset",
        "asset_files",
        "source_tree",
        "links",
        "joints",
        "actuators",
        "sensors"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/robot_asset"
            },
            {
              "type": "null"
            }
          ]
        },
        "asset_files": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "source_tree": {
          "anyOf": [
            {
              "$ref": "#/$defs/xml_element"
            },
            {
              "type": "null"
            }
          ]
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/robot_link"
          }
        },
        "joints": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/robot_joint"
          }
        },
        "actuators": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/robot_actuator"
          }
        },
        "sensors": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/robot_sensor"
          }
        },
        "tool": {
          "type": "object",
          "required": [
            "link",
            "pose"
          ],
          "additionalProperties": false,
          "properties": {
            "link": {
              "$ref": "#/$defs/name"
            },
            "pose": {
              "$ref": "#/$defs/robot_pose"
            }
          }
        }
      }
    },
    "xml_element": {
      "type": "object",
      "required": [
        "tag",
        "attrs",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attrs": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "children": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/xml_element"
          }
        }
      }
    },
    "cell_object": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "pose",
        "geometries"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "fixture",
            "object"
          ]
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "pose": {
          "$ref": "#/$defs/robot_pose"
        },
        "geometries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/robot_geometry"
          }
        },
        "dynamic": {
          "type": "object",
          "required": [
            "mass",
            "attachable"
          ],
          "additionalProperties": false,
          "properties": {
            "mass": {
              "$ref": "#/$defs/quantity"
            },
            "attachable": {
              "const": true
            }
          }
        }
      }
    },
    "cell_io": {
      "type": "object",
      "required": [
        "name",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "direction": {
          "enum": [
            "digital-in",
            "digital-out"
          ]
        }
      }
    },
    "cell_model": {
      "type": "object",
      "required": [
        "id",
        "name",
        "robot",
        "mount",
        "objects",
        "io"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "robot": {
          "$ref": "#/$defs/name"
        },
        "mount": {
          "$ref": "#/$defs/robot_pose"
        },
        "objects": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/cell_object"
          }
        },
        "io": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/cell_io"
          }
        }
      }
    }
  }
}
