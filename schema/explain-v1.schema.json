{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chayan-bit/invar/blob/main/schema/explain-v1.schema.json",
  "title": "invar-explain-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "diagnostics",
    "source_identity",
    "regions"
  ],
  "properties": {
    "schema": {
      "const": "invar-explain-v1"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "ok"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 0
    },
    "source_identity": {
      "type": "string"
    },
    "regions": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "function": {
            "type": "string"
          },
          "span": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "candidate_identity": {
            "type": "string"
          },
          "status": {
            "enum": [
              "admitted",
              "rejected"
            ]
          },
          "first_rejected_obligation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "rule_revision": {
            "type": "string"
          },
          "rule_identities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "numeric_policy": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "chosen_plan": {
            "type": "string"
          },
          "fallback_plan": {
            "type": "string"
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string"
              },
              "partner": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "start",
                      "end"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "law": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "prefix": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "intermediate": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind",
              "partner",
              "law",
              "prefix",
              "intermediate"
            ]
          },
          "runtime_guard": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "upper": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "constant": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "constant"
                        ]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "length": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "length"
                        ]
                      }
                    ]
                  },
                  "inputs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "output": {
                    "type": "string"
                  }
                },
                "required": [
                  "upper",
                  "inputs",
                  "output"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "facts": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reads": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "owner": {
                          "type": "string"
                        },
                        "element_type": {
                          "type": "string"
                        },
                        "offset": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "owner",
                        "element_type",
                        "offset"
                      ]
                    }
                  },
                  "writes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "owner": {
                          "type": "string"
                        },
                        "element_type": {
                          "type": "string"
                        },
                        "offset": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "owner",
                        "element_type",
                        "offset"
                      ]
                    }
                  },
                  "ownership": {
                    "type": "string"
                  },
                  "loan_state": {
                    "type": "string"
                  },
                  "effect_order": {
                    "type": "string"
                  },
                  "trap_summary": {
                    "type": "string"
                  },
                  "termination": {
                    "type": "string"
                  },
                  "physical_alias": {
                    "type": "string"
                  },
                  "cleanup": {
                    "type": "string"
                  }
                },
                "required": [
                  "reads",
                  "writes",
                  "ownership",
                  "loan_state",
                  "effect_order",
                  "trap_summary",
                  "termination",
                  "physical_alias",
                  "cleanup"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "obligations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "evidence",
                "detail"
              ]
            }
          }
        },
        "required": [
          "function",
          "span",
          "candidate_identity",
          "status",
          "first_rejected_obligation",
          "rule_revision",
          "rule_identities",
          "numeric_policy",
          "target",
          "chosen_plan",
          "fallback_plan",
          "execution",
          "runtime_guard",
          "facts",
          "obligations"
        ]
      }
    },
    "device_schema": {
      "const": "invar-explain-device-v1"
    },
    "device_execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_engine": {
          "enum": [
            "cuda",
            "metal",
            "auto"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "function": {
                "type": "string"
              },
              "span": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "start",
                  "end"
                ]
              },
              "backend": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "cuda-failed-before-publication",
                  "cuda-feature-unavailable",
                  "device-plan-ineligible",
                  "device-unavailable",
                  "forced-device",
                  "live-guard-false",
                  "measured-cpu-cost",
                  "measured-device-cost",
                  "metal-buffer-slot-limit",
                  "metal-failed-before-publication",
                  "metal-no-f64",
                  "publication-guard-false",
                  "staged-consumer",
                  "toolchain-unavailable"
                ]
              },
              "kind": {
                "type": "string"
              },
              "cost_ms": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "cpu": {
                        "type": "number"
                      },
                      "device": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "cpu",
                      "device"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "function",
              "span",
              "backend",
              "reason"
            ]
          }
        },
        "result": {
          "type": "integer"
        },
        "module_cache_hits": {
          "type": "integer",
          "minimum": 0
        },
        "schedule_hint_hits": {
          "type": "integer",
          "minimum": 0
        },
        "schedule_hint_invalids": {
          "type": "integer",
          "minimum": 0
        },
        "normal_form": {
          "description": "P6(a) normal-form route (#54): the laws the law executor applied with the checked certificate identity, or why the serial path ran.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "laws",
                "certificates",
                "fingerprint",
                "certificate_digest",
                "lanes"
              ],
              "properties": {
                "status": {
                  "const": "routed"
                },
                "laws": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^L[0-9]+$"
                  }
                },
                "certificates": {
                  "type": "integer",
                  "minimum": 1
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "certificate_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "lanes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "const": "fallback"
                },
                "reason": {
                  "anyOf": [
                    {
                      "enum": [
                        "recursion-law-not-routed",
                        "certificate-rejected",
                        "residue-law-not-routed",
                        "executor-refused",
                        "no-law-applied",
                        "law-state-violation",
                        "call-depth-unproven",
                        "fuel-unproven",
                        "live-elements-unproven",
                        "executor-tool-limit"
                      ]
                    },
                    {
                      "type": "string",
                      "pattern": "^no-lowering:[a-z]+/[a-z]+(-[a-z]+)*$"
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "requested_engine",
        "choices",
        "result",
        "module_cache_hits",
        "schedule_hint_hits",
        "schedule_hint_invalids"
      ]
    },
    "numeric_contracts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "binary64": {
          "const": "strict-f64-v1"
        },
        "math": {
          "const": "invar-math-cr-v1"
        },
        "trig": {
          "const": "invar-trig-f32-v1"
        }
      }
    }
  }
}
