// Finite binary32 fma needs at most426 exact magnitude bits;512 is bounded slack.
struct GnetF32Big { gnet_u w[8]; };
GNET_FN bool gnet_f32_nan(gnet_u a) { return (a&2139095040ULL)==2139095040ULL && (a&8388607ULL)!=0; }
GNET_FN bool gnet_f32_inf(gnet_u a) { return (a&2147483647ULL)==2139095040ULL; }
GNET_FN bool gnet_f32_zero(gnet_u a) { return (a&2147483647ULL)==0; }
GNET_FN gnet_u gnet_f32_sig(gnet_u a) { return (a&8388607ULL) | ((a&2139095040ULL)?8388608ULL:0); }
GNET_FN int gnet_f32_power(gnet_u a) { int e=(int)((a>>23)&255); return e?e-150:-149; }
GNET_FN GnetF32Big gnet_f32_big(gnet_u a,int shift) { GnetF32Big r={}; int i=shift/64,b=shift%64; r.w[i]=a<<b; if(b && i+1<8) r.w[i+1]=a>>(64-b); return r; }
GNET_FN int gnet_f32_order(GNET_PRIVATE const GnetF32Big& a,GNET_PRIVATE const GnetF32Big& b) { for(int i=7;i>=0;--i) { if(a.w[i]<b.w[i]) return -1; if(a.w[i]>b.w[i]) return 1; } return 0; }
GNET_FN GnetF32Big gnet_f32_plus(GNET_PRIVATE const GnetF32Big& a,GNET_PRIVATE const GnetF32Big& b) { GnetF32Big r={}; gnet_u carry=0; for(int i=0;i<8;++i) { gnet_u x=a.w[i]+b.w[i],c=x<a.w[i]; r.w[i]=x+carry; carry=c|(r.w[i]<x); } return r; }
GNET_FN GnetF32Big gnet_f32_minus(GNET_PRIVATE const GnetF32Big& a,GNET_PRIVATE const GnetF32Big& b) { GnetF32Big r={}; gnet_u borrow=0; for(int i=0;i<8;++i) { gnet_u x=a.w[i]-b.w[i],c=a.w[i]<b.w[i]; r.w[i]=x-borrow; borrow=c|(x<borrow); } return r; }
GNET_FN int gnet_f32_length(gnet_u x) { int n=0; while(x) { ++n; x>>=1; } return n; }
GNET_FN int gnet_f32_top(GNET_PRIVATE const GnetF32Big& a) { for(int i=7;i>=0;--i) if(a.w[i]) return i*64+gnet_f32_length(a.w[i]); return 0; }
GNET_FN bool gnet_f32_bit(GNET_PRIVATE const GnetF32Big& a,int bit) { return bit>=0 && bit<512 && ((a.w[bit/64]>>(bit%64))&1)!=0; }
GNET_FN bool gnet_f32_below(GNET_PRIVATE const GnetF32Big& a,int bit) { for(int i=0;i<8;++i) { if(bit>=64) { if(a.w[i]) return true; bit-=64; } else { return bit>0 && (a.w[i]&((1ULL<<bit)-1))!=0; } } return false; }
GNET_FN gnet_u gnet_f32_shift(GNET_PRIVATE const GnetF32Big& a,int bit) { if(bit<0) return a.w[0]<<(-bit); if(bit>=512) return 0; int i=bit/64,b=bit%64; gnet_u x=a.w[i]>>b; if(b && i+1<8) x|=a.w[i+1]<<(64-b); return x; }
GNET_FN gnet_u gnet_f32_pack(gnet_u q,int exponent,gnet_u sign) { if(q==16777216ULL) { q>>=1; ++exponent; } if(exponent>127) return sign|2139095040ULL; return sign|((gnet_u)(exponent+127)<<23)|(q&8388607ULL); }
GNET_FN gnet_u gnet_f32_round(GNET_PRIVATE const GnetF32Big& a,int power,gnet_u sign) { int n=gnet_f32_top(a); if(!n) return sign; int exponent=n-1+power; if(exponent>127) return sign|2139095040ULL; int shift=exponent<-126?-149-power:n-24; gnet_u q=gnet_f32_shift(a,shift); if(shift>0 && gnet_f32_bit(a,shift-1) && (gnet_f32_below(a,shift-1)||(q&1))) ++q; if(exponent<-126) return sign|q; return gnet_f32_pack(q,exponent,sign); }
GNET_FN gnet_u gnet_f32_sum(GNET_PRIVATE const GnetF32Big& a,gnet_u sa,GNET_PRIVATE const GnetF32Big& b,gnet_u sb,int power,gnet_u zero_sign) { if(sa==sb) return gnet_f32_round(gnet_f32_plus(a,b),power,sa); int order=gnet_f32_order(a,b); if(!order) return zero_sign; return order>0?gnet_f32_round(gnet_f32_minus(a,b),power,sa):gnet_f32_round(gnet_f32_minus(b,a),power,sb); }
GNET_FN gnet_u gnet_f32_add(gnet_u a,gnet_u b) { if(gnet_f32_nan(a)||gnet_f32_nan(b)) return 2143289344ULL; gnet_u sa=a&2147483648ULL,sb=b&2147483648ULL; if(gnet_f32_inf(a)) return gnet_f32_inf(b)&&sa!=sb?2143289344ULL:a; if(gnet_f32_inf(b)) return b; int pa=gnet_f32_power(a),pb=gnet_f32_power(b),base=pa<pb?pa:pb; return gnet_f32_sum(gnet_f32_big(gnet_f32_sig(a),pa-base),sa,gnet_f32_big(gnet_f32_sig(b),pb-base),sb,base,sa&sb); }
GNET_FN gnet_u gnet_f32_sub(gnet_u a,gnet_u b) { return gnet_f32_add(a,b^2147483648ULL); }
GNET_FN gnet_u gnet_f32_mul(gnet_u a,gnet_u b) { gnet_u sign=(a^b)&2147483648ULL; if(gnet_f32_nan(a)||gnet_f32_nan(b)||(gnet_f32_inf(a)&&gnet_f32_zero(b))||(gnet_f32_inf(b)&&gnet_f32_zero(a))) return 2143289344ULL; if(gnet_f32_inf(a)||gnet_f32_inf(b)) return sign|2139095040ULL; return gnet_f32_round(gnet_f32_big(gnet_f32_sig(a)*gnet_f32_sig(b),0),gnet_f32_power(a)+gnet_f32_power(b),sign); }
GNET_FN gnet_u gnet_f32_fma(gnet_u a,gnet_u b,gnet_u c) { gnet_u sign=(a^b)&2147483648ULL,sc=c&2147483648ULL; if(gnet_f32_nan(a)||gnet_f32_nan(b)||gnet_f32_nan(c)||(gnet_f32_inf(a)&&gnet_f32_zero(b))||(gnet_f32_inf(b)&&gnet_f32_zero(a))) return 2143289344ULL; if(gnet_f32_inf(a)||gnet_f32_inf(b)) return gnet_f32_inf(c)&&sign!=sc?2143289344ULL:sign|2139095040ULL; if(gnet_f32_inf(c)) return c; int pp=gnet_f32_power(a)+gnet_f32_power(b),pc=gnet_f32_power(c),base=pp<pc?pp:pc; gnet_u zero_sign=(gnet_f32_zero(a)||gnet_f32_zero(b))&&gnet_f32_zero(c)?sign&sc:0; return gnet_f32_sum(gnet_f32_big(gnet_f32_sig(a)*gnet_f32_sig(b),pp-base),sign,gnet_f32_big(gnet_f32_sig(c),pc-base),sc,base,zero_sign); }
GNET_FN gnet_u gnet_f32_div(gnet_u a,gnet_u b) { gnet_u sign=(a^b)&2147483648ULL; if(gnet_f32_nan(a)||gnet_f32_nan(b)||(gnet_f32_inf(a)&&gnet_f32_inf(b))||(gnet_f32_zero(a)&&gnet_f32_zero(b))) return 2143289344ULL; if(gnet_f32_inf(a)||gnet_f32_zero(b)) return sign|2139095040ULL; if(gnet_f32_inf(b)||gnet_f32_zero(a)) return sign; gnet_u x=gnet_f32_sig(a),y=gnet_f32_sig(b); int k=gnet_f32_length(x)-gnet_f32_length(y); if(k>=0?x<(y<<k):(x<<(-k))<y) --k; int power=gnet_f32_power(a)-gnet_f32_power(b),e=k+power; if(e>127) return sign|2139095040ULL; if(e<-150) return sign; int shift=e<-126?power+149:23-k; gnet_u n=shift>=0?x<<shift:x,d=shift<0?y<<(-shift):y,q=n/d,r=n%d; if(r>d-r || (r==d-r && (q&1))) ++q; if(e<-126) return sign|q; return gnet_f32_pack(q,e,sign); }
GNET_FN bool gnet_f32_eq(gnet_u a,gnet_u b) { return !gnet_f32_nan(a)&&!gnet_f32_nan(b)&&(a==b||(gnet_f32_zero(a)&&gnet_f32_zero(b))); }
GNET_FN gnet_u gnet_f32_key(gnet_u a) { return (a&2147483648ULL)?(~a&4294967295ULL):(a|2147483648ULL); }
GNET_FN bool gnet_f32_lt(gnet_u a,gnet_u b) { return !gnet_f32_nan(a)&&!gnet_f32_nan(b)&&!gnet_f32_eq(a,b)&&gnet_f32_key(a)<gnet_f32_key(b); }
GNET_FN gnet_u gnet_f32_from_u32(gnet_u a) { return gnet_f32_round(gnet_f32_big(a,0),0,0); }
GNET_FN gnet_u gnet_f32_from_i32(gnet_w a) { return gnet_f32_round(gnet_f32_big((gnet_u)(a<0?-a:a),0),0,a<0?2147483648ULL:0); }
