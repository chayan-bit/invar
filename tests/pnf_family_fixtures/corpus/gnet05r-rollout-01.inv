    w[o + 118u32] = w[o + 99u32] * 0.0 + w[o + 100u32] * 0.04 + w[o + 101u32] * 0.0584 + w[o + 106u32];
    w[o + 114u32] = w[o + 102u32] * 1.0 + w[o + 103u32] * 0.0 + w[o + 104u32] * 0.0;
    w[o + 115u32] = w[o + 102u32] * 0.0 + w[o + 103u32] * 1.0 + w[o + 104u32] * 0.0;
    w[o + 116u32] = w[o + 102u32] * 0.0 + w[o + 103u32] * 0.0 + w[o + 104u32] * 1.0;
    w[o + 119u32] = w[o + 102u32] * 0.0 + w[o + 103u32] * 0.04 + w[o + 104u32] * 0.0584 + w[o + 107u32];
