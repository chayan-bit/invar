fn tool(t: read Array<f32>, i: u32) -> f32 {
    let r = 96u32 + 3u32 * i;
    return t[r] * 0.0 + t[r + 1u32] * 0.0 + t[r + 2u32] * 0.0 + t[96u32 + 9u32 + i];
}
fn run(seed: u32, n: u32, h: u32) -> Array<f32> {
    let lo: Array<f32> = [(-2.8973), (-1.7628), (-2.8973), (-3.0718), (-2.8973), (-0.0175), (-2.8973)];
    let span: Array<f32> = [5.7946, 3.5256, 5.7946, 3.002, 5.7946, 3.77, 5.7946];
    let hi: Array<f32> = [2.8973, 1.7628, 2.8973, (-0.0698), 2.8973, 3.7525, 2.8973];
    var x = stream(wrapping_mul(seed, 747796405u32), 0u32);
    x = lcg(x);
    let tx = 1.2 * unit(x) - 0.6;
    x = lcg(x);
    let ty = 1.2 * unit(x) - 0.6;
    x = lcg(x);
    let tz = 0.8 * unit(x) + 0.1;
    var out = filled_f32(n * h * 8u32, 0.0);
    var q = filled_f32(7u32, 0.0);
    var v = filled_f32(7u32, 0.0);
    var cs = filled_f32(14u32, 0.0);
    var t = filled_f32(132u32, 0.0);
    for b in 0u32..n {
        var y = stream(seed, b);
        for j0 in 0u32..7u32 {
            y = lcg(y);
            q[j0] = lo[j0] + span[j0] * unit(y);
            v[j0] = 0.0;
        }
        for k in 0u32..h {
            var uu = 0.0;
            for j in 0u32..7u32 {
                y = lcg(y);
                let u = (2.0 * unit(y) - 1.0) * 2.0;
                uu = uu + u * u;
                v[j] = v[j] + 0.01 * u;
                var p = q[j] + 0.01 * v[j];
                if p < lo[j] {
                    p = lo[j];
                    v[j] = 0.0;
                }
                if p > hi[j] {
                    p = hi[j];
                    v[j] = 0.0;
                }
                q[j] = p;
                sincos(p, cs, j);
            }
            fk(t, 0u32, cs);
            let ex = tool(t, 0u32) - tx;
            let ey = tool(t, 1u32) - ty;
            let ez = tool(t, 2u32) - tz;
            let o = (b * h + k) * 8u32;
            for j2 in 0u32..7u32 {
                out[o + j2] = q[j2];
            }
            out[o + 7u32] = ex * ex + ey * ey + ez * ez + 0.001 * uu;
        }
    }
    return out;
}
fn main() -> i32 {
    let out = run(1890228921u32, 1u32, 2u32);
    if len(out) > 0u32 {
        return 1;
    }
    return 0;
}
