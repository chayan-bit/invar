    w[o + 121u32] = w[o + 96u32] * 0.0 + w[o + 97u32] * (-1.0) + w[o + 98u32] * 0.0;
    w[o + 122u32] = w[o + 96u32] * 0.0 + w[o + 97u32] * 0.0 + w[o + 98u32] * 1.0;
