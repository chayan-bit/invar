// GNET-05 robotics corpus: fk (panda, trigonometric, table).
fn lcg(x: u32) -> u32 {
    return wrapping_add(wrapping_mul(x, 1664525u32), 1013904223u32);
}
fn unit(x: u32) -> f32 {
    return f32_from_u32(x / 256u32) * 0.000000059604645;
}
fn stream(seed: u32, i: u32) -> u32 {
    return lcg(wrapping_add(wrapping_mul(i, 2654435761u32), seed));
}
fn sincos(x: f32, cs: mut Array<f32>, j: u32) -> Unit {
    var k = 0.0;
    var m = 0u32;
    while x * 0.63661975 - k > 0.5 {
        k = k + 1.0;
        m = m + 1u32;
    }
    while x * 0.63661975 - k < (-0.5) {
        k = k - 1.0;
        m = m + 3u32;
    }
    let r = x - k * 1.5703125 - k * 0.0004837513 - k * 0.0000000754979;
    let z = r * r;
    let s = (((-0.00019515296) * z + 0.008332161) * z - 0.16666655) * z * r + r;
    let c = ((0.000024433157 * z - 0.0013887316) * z + 0.041666646) * z * z - 0.5 * z + 1.0;
    let q = m % 4u32;
    var sn = s;
    var cn = c;
    if q == 1u32 {
        sn = c;
        cn = -s;
    } else if q == 2u32 {
        sn = -s;
        cn = -c;
    } else if q == 3u32 {
        sn = -c;
        cn = s;
    }
    cs[2u32 * j] = cn;
    cs[2u32 * j + 1u32] = sn;
}
fn angles(cs: mut Array<f32>, seed: u32, b: u32, lo: read Array<f32>, span: read Array<f32>) -> Unit {
    var x = stream(seed, b);
    for j in 0u32..len(lo) {
        x = lcg(x);
        sincos(lo[j] + span[j] * unit(x), cs, j);
    }
}
fn fk(w: mut Array<f32>, o: u32, cs: read Array<f32>, par: read Array<u32>, fix: read Array<f32>, ax: read Array<u32>, jt: read Array<u32>, jm: mut Array<f32>) -> Unit {
    for e in 0u32..12u32 {
        w[o + e] = fix[e];
    }
    for i in 1u32..len(par) {
        let so = o + i * 12u32;
        let po = o + par[i] * 12u32;
        let ao = i * 12u32;
        let a = ax[i];
        let c = cs[2u32 * jt[i]];
        let s = cs[2u32 * jt[i] + 1u32];
        for k in 0u32..3u32 {
            let f = ao + 3u32 * k;
            let x = fix[f];
            let y = fix[f + 1u32];
            let z = fix[f + 2u32];
            jm[3u32 * k] = x;
            jm[3u32 * k + 1u32] = y;
            jm[3u32 * k + 2u32] = z;
            if a == 3u32 {
                jm[3u32 * k] = c * x + s * y;
                jm[3u32 * k + 1u32] = c * y - s * x;
            } else if a == 2u32 {
                jm[3u32 * k] = c * x - s * z;
                jm[3u32 * k + 2u32] = s * x + c * z;
            } else if a == 1u32 {
                jm[3u32 * k + 1u32] = c * y + s * z;
                jm[3u32 * k + 2u32] = c * z - s * y;
            }
        }
        for r in 0u32..3u32 {
            let pr = po + r * 3u32;
            for col in 0u32..3u32 {
                w[so + r * 3u32 + col] = w[pr] * jm[col] + w[pr + 1u32] * jm[3u32 + col] + w[pr + 2u32] * jm[6u32 + col];
            }
            w[so + 9u32 + r] = w[pr] * fix[ao + 9u32] + w[pr + 1u32] * fix[ao + 10u32] + w[pr + 2u32] * fix[ao + 11u32] + w[po + 9u32 + r];
        }
    }
}
fn tool(t: read Array<f32>, i: u32) -> f32 {
    let r = 96u32 + 3u32 * i;
    return t[r] * 0.0 + t[r + 1u32] * 0.0 + t[r + 2u32] * 0.0 + t[96u32 + 9u32 + i];
}
fn run(seed: u32, n: u32) -> Array<f32> {
