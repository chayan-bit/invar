    let ax: Array<u32> = [0u32, 3u32, 3u32, 3u32, 3u32, 3u32, 3u32, 3u32, 0u32, 0u32, 0u32];
    let jt: Array<u32> = [0u32, 0u32, 1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 0u32, 0u32, 0u32];
    var jm = filled_f32(9u32, 0.0);
