fn w(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 26) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 5 + n * 3) % 4;
    if sel == 0 {
        let v0_0 = t(n - 1, (s * 29 + 6) % 1009);
        let v0_1 = t(n - 2, (s * 18 + 54) % 1009);
        return (v0_0 * v0_1 + v0_0 * 5 + v0_1) % 10007;
    }
    if sel == 1 {
        let v1_0 = t(n - 1, (s * 19 + 85) % 1009);
        let v1_1 = t(n - 2, (s * 2 + 97) % 1009);
        let v1_2 = t(n - 1, (s * 22 + 54) % 1009);
        return (v1_0 * v1_1 + v1_0 * 9 + v1_1 + v1_2) % 10007;
    }
    if sel == 2 {
        let v2_0 = t(n - 1, (s * 16 + 84) % 1009);
        let v2_1 = t(n - 1, (s * 21 + 89) % 1009);
        let v2_2 = t(n - 2, (s * 7 + 48) % 1009);
        return (v2_0 * v2_1 + v2_0 * 6 + v2_1 + v2_2) % 10007;
    }
    return t(n - 1, (s * 21 + 43) % 1009);
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(4, 705); }
