fn leaf(x: i32) -> i32 {
    var s = x % 101;
    var i = 0;
    while i < x % 9 {
        s = (s * 3 + i) % 10007;
        i = i + 1;
    }
    return s;
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 4 { return leaf(lo * 7 + hi); }
    if d <= 0 { return leaf(hi - lo + 6); }
    let m1 = lo + 1 + ((hi - lo - 2) * (1 + (lo % 3 + 3) % 3)) / 5;
    let m2 = m1 + 1 + ((hi - m1 - 2) * 2) / 5;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, m2, d - 1);
    let c = dc(m2, hi, d - 1);
    if a > b { return (a * 3 + b + c) % 10007; }
    return (b * b % 10007 + a + b + c) % 10007;
}
fn run(a: i32, b: i32) -> i32 { return dc(24, 24 + a, b); }
fn main() -> i32 { return run(40, 3); }
