fn leaf(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 49) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 6 { return leaf(lo * 9 + hi); }
    if d <= 0 { return leaf(hi - lo + 6); }
    let m1 = lo + 1 + ((hi - lo - 2) * (4 + (lo % 2 + 2) % 2)) / 6;
    let m2 = m1 + 1 + ((hi - m1 - 2) * 4) / 8;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, m2, d - 1);
    let c = dc(m2, hi, d - 2);
    if a > b { return (a * 3 + b + c) % 10007; }
    return (b * b % 10007 + a + b + c) % 10007;
}
fn run(a: i32, b: i32) -> i32 { return dc(28, 28 + a, b); }
fn main() -> i32 { return run(22, 2); }
