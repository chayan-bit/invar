fn sum(xs:read Array<f32>,i:u32)->f32 {if i==len(xs) {return 0.0;}return xs[i]+sum(xs,i+1u32);} fn fill(xs:mut Array<f32>,i:u32)->i32 {if i==len(xs) {return 0;}xs[i]=f32_from_u32(i);return fill(xs,i+1u32);} fn take_back(xs:take Array<f32>)->Array<f32> {return xs;} fn ints(n:u32)->Array<u32> {var ys=filled_u32(n,1u32);for i in 0u32..n {ys[i]=ys[i]+i;}return ys;} fn main()->i32 {var xs=filled_f32(4u32,-0.0);let z=fill(xs,0u32);let ys=ints(3u32);let moved=take_back(move xs);let s=sum(moved,0u32);if s==6.0 and ys[2u32]==3u32 and z==0 {return 7;}return 0;}
