fn map(xs: read Array<u32>) -> Array<u32> {
    var ys: Array<u32> = filled_u32(len(xs), 0u32);
    for i in 0u32 .. len(xs) { ys[i] = wrapping_add(xs[i], 7u32); }
    return ys;
}
fn main() -> i32 {
    let seeds: Array<u32> = [0u32, 1u32, 4294967295u32, 4294967289u32, 4294967290u32, 2147483647u32, 2147483648u32, 123456789u32];
    let gold: Array<u32> = [7u32, 8u32, 6u32, 0u32, 1u32, 2147483654u32, 2147483655u32, 123456796u32];
    var xs: Array<u32> = filled_u32(1u32, 0u32);
    for i in 0u32 .. len(xs) { xs[i] = seeds[i % 8u32]; }
    let ys: Array<u32> = map(xs);
    for j in 0u32 .. len(xs) { if ys[j] != gold[j % 8u32] { return 1; } }
    return 0;
}
