 fn work(xs: read Array<u32>) -> i32 { let pad: u32 = 3u32; var first: Array<u32> = filled_u32(len(xs), 0u32); for row in 0u32 .. len(xs) { first[row] = wrapping_add(xs[row], 7u32); } let mid: Array<u32> = move first; var second: Array<u32> = filled_u32(len(mid), 0u32); for j in 0u32 .. len(mid) { second[j] = wrapping_add(9u32, mid[j]); } var h: u32 = 1u32; for k in 0u32 .. len(second) { h = wrapping_add(wrapping_mul(h, 31u32), second[k]); } var tail: u32 = pad; tail = tail + 1u32; if h == tail { return 1; } return 0; } fn main() -> i32 { let values: Array<u32> = []; return work(values); }