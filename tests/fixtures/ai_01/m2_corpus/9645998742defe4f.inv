fn step(x: u32) -> u32 { return x + 4294967295u32; } fn work(xs: read Array<u32>) -> i32 { let pad: u32 = 3u32; var ys: Array<u32> = filled_u32(len(xs), 0u32); for i in 0u32 .. len(xs) { ys[i] = step(xs[i]); } return 0; } fn main() -> i32 { let values: Array<u32> = [23505u32]; return work(values); }