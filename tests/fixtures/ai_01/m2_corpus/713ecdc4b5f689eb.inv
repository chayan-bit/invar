 fn main() -> i32 { let xs: Array<u32> = filled_u32(63u32, 4294967293u32); let pad: u32 = 3u32; var carry: u32 = pad; var outcome: Array<u32> = filled_u32(len(xs), 0u32); for row in 0u32 .. len(xs) { outcome[row] = carry; carry = wrapping_add(xs[row], wrapping_mul(carry, 65537u32)); } var h: u32 = 1u32; for k in 0u32 .. len(outcome) { h = wrapping_add(wrapping_mul(h, 31u32), outcome[k]); } var tail: u32 = pad; tail = tail + 1u32; if h == tail { return 1; } return 0; }