 fn main() -> i32 { let pad: u32 = 3u32; let xs: Array<u32> = []; var s: u32 = pad; var ys: Array<u32> = filled_u32(len(xs), 0u32); for i in 0u32 .. len(xs) { s = wrapping_add(wrapping_mul(7u32, s), xs[i]); ys[i] = s; } var h: u32 = 1u32; for k in 0u32 .. len(ys) { h = wrapping_add(wrapping_mul(h, 31u32), ys[k]); } var tail: u32 = pad; tail = tail + 1u32; if h == tail { return 1; } return 0; }