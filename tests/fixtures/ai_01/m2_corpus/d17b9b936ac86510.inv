 fn main() -> i32 { let pad: u32 = 3u32; let xs: Array<u32> = [23505u32,2654413408u32,1013885107u32,3668326082u32,2027797781u32,387267492u32,3041690103u32,1401161734u32,4055602777u32,2415074536u32,774544187u32,3428999498u32,1788473245u32,147945004u32,2802383999u32,1161853582u32,3816276161u32,2175749904u32,535221667u32,3189658610u32,1549130245u32,4203520084u32,2562993895u32,922465590u32,3576902473u32,1936374168u32,295829547u32,2950270586u32,1309742221u32,3964179164u32,2323650927u32,683141054u32,3337580017u32,1697051648u32,56521299u32,2710960354u32,1070417717u32,3724856644u32,2084326295u32,443798054u32,3098237049u32,1457661576u32,4112100571u32,2471570282u32,831041981u32,3485482956u32,1844938271u32,204410030u32,2858846945u32,1218318640u32,3872759619u32,2232247698u32,591719461u32,3246156404u32,1605628039u32,4260069078u32,2619524457u32,978994104u32,3633433035u32,1992904730u32,352378541u32,3006768380u32,1366237967u32,4020676958u32]; var carry: u32 = pad; var outcome: Array<u32> = filled_u32(len(xs), 0u32); for row in 0u32 .. len(xs) { outcome[row] = carry; carry = wrapping_add(xs[row], wrapping_mul(carry, 65537u32)); } var h: u32 = 1u32; for k in 0u32 .. len(outcome) { h = wrapping_add(wrapping_mul(h, 31u32), outcome[k]); } var tail: u32 = pad; tail = tail + 1u32; if h == tail { return 1; } return 0; }