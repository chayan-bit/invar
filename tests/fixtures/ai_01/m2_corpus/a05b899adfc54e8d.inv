 fn work(xs: read Array<u32>) -> i32 { let pad: u32 = 3u32; var ys: Array<u32> = filled_u32(len(xs), 0u32); for i in 0u32 .. len(xs) { ys[i] = wrapping_add(xs[i], 4294967295u32); } var h: u32 = 1u32; for k in 0u32 .. len(ys) { h = wrapping_add(wrapping_mul(h, 31u32), ys[k]); } var tail: u32 = pad; tail = tail + 1u32; if h == tail { return 1; } return 0; } fn main() -> i32 { let values: Array<u32> = [23505u32]; return work(values); }