fn main() -> i32 { let xs: Array<u32> = filled_u32(0u32,1u32); let ys: Array<u32> = filled_u32(1u32,4u32); let zs: Array<u32> = filled_u32(2u32,7u32); var a: Array<u32> = filled_u32(len(xs),0u32); for i in 0u32 .. len(xs) { a[i] = wrapping_add(xs[i],ys[i]); } let first: Array<u32> = move a; var b: Array<u32> = filled_u32(len(first),0u32); for j in 0u32 .. len(first) { b[j] = wrapping_mul(first[j],zs[j]); }  return 0; }