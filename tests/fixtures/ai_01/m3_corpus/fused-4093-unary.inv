fn main() -> i32 { let xs: Array<u32> = filled_u32(4093u32,1u32); var a: Array<u32> = filled_u32(len(xs),0u32); for i in 0u32 .. len(xs) { a[i] = wrapping_add(xs[i],3u32); } let first: Array<u32> = move a; var b: Array<u32> = filled_u32(len(first),0u32); for j in 0u32 .. len(first) { b[j] = wrapping_mul(first[j],7u32); } let second: Array<u32> = move b; var c: Array<u32> = filled_u32(len(second),0u32); for k in 0u32 .. len(second) { c[k] = wrapping_add(second[k],11u32); } if c[0u32] != 39u32 { return 1; } if c[4092u32] != 39u32 { return 1; } return 0; }