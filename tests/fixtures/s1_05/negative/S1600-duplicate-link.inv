robot Planar {
    license "Apache-2.0";
    link base {
        parent world;
        origin xyz (0 m, 0 m, 0 m) quat (1, 0, 0, 0);
        mass 1 kg;
        inertia (0.01, 0.01, 0.01, 0, 0, 0) kg*m*m;
        visual box (0.1, 0.1, 0.1) m;
        collision box (0.1, 0.1, 0.1) m;
    }
    link base {
        parent base;
        origin xyz (0 m, 0 m, 0.2 m) quat (1, 0, 0, 0);
        mass 0.5 kg;
        inertial_origin xyz (0 m, 0 m, 0.1 m) quat (1, 0, 0, 0);
        inertia (0.001, 0.001, 0.001, 0, 0, 0) kg*m*m;
        visual capsule (0.02, 0.1) m;
        collision capsule (0.02, 0.1) m;
    }
    joint shoulder {
        kind revolute;
        parent base;
        child arm;
        axis (0, 0, 1);
        position -1 rad .. 1 rad;
        velocity 2 rad/s;
        effort 5 N*m;
    }
    actuator shoulder_drive {
        mode position;
        joint shoulder;
        gear 1;
        control -1 rad .. 1 rad;
    }
    sensor encoder {
        kind joint-position;
        source shoulder;
    }
}

cell Bench {
    robot Planar;
    mount xyz (0 m, 0 m, 0 m) quat (1, 0, 0, 0);
    fixture table {
        pose xyz (0 m, 0 m, -0.1 m) quat (1, 0, 0, 0);
        collision box (0.5, 0.5, 0.05) m;
    }
    object cube {
        pose xyz (0.3 m, 0 m, 0.1 m) quat (1, 0, 0, 0);
        visual box (0.04, 0.04, 0.04) m;
        collision box (0.04, 0.04, 0.04) m;
    }
    io estop: digital-in;
}

product Demo {
    distribution internal;
    commercial false;
    robot Planar;
    capacity cpu_cores = 1, memory = 1 GiB;
}
system demo for Demo {}
