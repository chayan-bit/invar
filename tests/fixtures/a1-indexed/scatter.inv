fn work(a: read Array<u32>, ix: read Array<u32>, n: u32) -> Array<u32> { var out = filled_u32(n,0u32); for i in 0u32..len(ix) { out[ix[i]] = a[i]; } return out; }
fn main() -> i32 { let a: Array<u32> = [7u32,11u32,19u32]; let ix: Array<u32> = [2u32,0u32,1u32]; let out = work(a,ix,3u32); if out[0u32] == 11u32 and out[1u32] == 19u32 and out[2u32] == 7u32 { return 7; } return 0; }
