fn work(a: read Array<u32>) -> Array<u32> { var out = filled_u32(5u32,0u32); for i in 0u32..3u32 { out[2u32*i] = a[i]; } return out; }
fn main() -> i32 { let a: Array<u32> = [7u32,11u32,19u32]; let out = work(a); if out[0u32] == 7u32 and out[1u32] == 0u32 and out[2u32] == 11u32 and out[3u32] == 0u32 and out[4u32] == 19u32 { return 7; } return 0; }
