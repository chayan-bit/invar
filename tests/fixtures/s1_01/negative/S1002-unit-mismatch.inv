frame world;
fn f() -> i32 { return 0; }
component Source {
    port out x: Quantity<i32,m> @ 1 Hz;
    license "MIT";
    isolation in-process;
    impl invar f;
}
component Sink {
    port in x: Quantity<i32,mm> @ 1 Hz;
    license "MIT";
    isolation in-process;
    impl invar f;
}
connect source.x -> sink.x policy sample-and-hold;
product P { distribution internal; commercial false; robot menagerie::franka_emika_panda; }
system s for P { source: Source; sink: Sink; }
