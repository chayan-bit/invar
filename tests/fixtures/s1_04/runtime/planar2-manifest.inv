frame world;
frame base: world;
frame tool: base;
extern component planar2 {
    abi c "invar_planar2_bridge_v1";
    lifecycle init, configure, step, shutdown;
    config c "inv_planar2_config_v1";
    port in q: std::robotics::JointPositions<f64,2> @ 100 Hz layout c "inv_joint2_f64";
    port out pose: std::robotics::Pose<f64,base,tool> @ 100 Hz layout c "inv_pose_f64";
    resource cpu_cores = 1, memory = 1 MiB;
    license "BSD-2-Clause" link dynamic;
    isolation in-process;
    wcet 1 ms;
    deadline 10 ms;
    golden "planar2_goldens.json" tolerance abs 0.000000000001 m, abs 0.000000000001 rad;
    property "pose.rotation is unit norm within 0.000000000001";
    shim "bridge.c";
    input "planar2.c";
    input "planar2.h";
    input "generate_goldens.py";
}
