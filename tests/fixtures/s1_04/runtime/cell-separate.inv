frame world;
frame base: world;
frame tool: base;
fn run() -> i32 { return 0; }

extern component planar2 {
    abi c "invar_planar2_bridge_v1";
    lifecycle init, configure, step, shutdown;
    config c "inv_planar2_config_v1";
    port in q: std::robotics::JointPositions<f64,2> @ 100 Hz layout c "inv_joint2_f64";
    port out pose: std::robotics::Pose<f64,base,tool> @ 100 Hz layout c "inv_pose_f64";
    resource cpu_cores = 1, memory = 1 MiB;
    license "BSD-2-Clause" link dynamic;
    isolation separate-process;
    wcet 1 ms;
    deadline 10 ms;
    golden "planar2_goldens.json" tolerance abs 0.000000000001 m, abs 0.000000000001 rad;
    property "pose.rotation is unit norm within 0.000000000001";
    shim "bridge.c";
    input "planar2.c";
    input "planar2.h";
    input "generate_goldens.py";
}
component Source {
    port out q: std::robotics::JointPositions<f64,2> @ 100 Hz;
    resource cpu_cores = 1, memory = 1 MiB;
    license "MIT";
    isolation in-process;
    wcet 1 ms;
    deadline 10 ms;
    impl invar run;
}
component Sink {
    port in pose: std::robotics::Pose<f64,base,tool> @ 100 Hz;
    resource cpu_cores = 1, memory = 1 MiB;
    license "MIT";
    isolation in-process;
    wcet 1 ms;
    deadline 10 ms;
    impl invar run;
}
component Controller {
    port out cmd: Quantity<i32,m> @ 100 Hz;
    resource cpu_cores = 1, memory = 1 MiB;
    license "MIT";
    isolation in-process;
    wcet 1 ms;
    deadline 10 ms;
    impl invar run;
}
component Hardware {
    port in cmd: Quantity<i32,m> @ 100 Hz;
    resource cpu_cores = 1, memory = 1 MiB;
    license "MIT";
    isolation in-process;
    wcet 1 ms;
    deadline 10 ms;
    impl invar run;
}
connect source.q -> planar2.q policy queue(4);
connect planar2.pose -> sink.pose policy queue(4);
connect controller.cmd -> hardware.cmd policy sample-and-hold;
product Cell {
    distribution internal;
    commercial false;
    robot menagerie::franka_emika_panda;
    capacity cpu_cores = 5, memory = 5 MiB;
}
system cell for Cell {
    source: Source;
    planar2: planar2;
    sink: Sink;
    controller: Controller;
    hardware: Hardware;
}
