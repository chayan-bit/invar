frame world;
frame base: world;
fn run() -> i32 { return 0; }
extern component lib {
    abi c "lib_";
    lifecycle init, configure, step, shutdown;
    port out data: Quantity<i32,m> @ 10 Hz layout c "int32_t";
    license "AGPL-3.0-only" link process;
    isolation separate-process;
}
component Source {
    port out data: Quantity<i32,m> @ 10 Hz bus ethercat;
    port out tf: Transform<base,world> @ 10 Hz;
    resource cpu_cores = 1, memory = 1 MiB, gpu_memory = 1 MiB;
    license "AGPL-3.0-only" link process modified false network_exposed true;
    isolation separate-process;
    wcet 1 ms;
    deadline 100 ms;
    impl extern lib;
}
component Sink {
    port in data: Quantity<i32,m> @ 10 Hz;
    resource cpu_cores = 1, memory = 1 MiB, gpu_memory = 1 MiB;
    license "MIT";
    isolation in-process;
    wcet 1 ms;
    deadline 100 ms;
    impl invar run;
}
connect source.data -> sink.data policy queue(4);
flow path: source.data -> sink.data within 2 ms;
product P {
    distribution proprietary-binary;
    commercial true;
    robot menagerie::franka_emika_panda;
    capacity cpu_cores = 2, memory = 2 MiB, gpu_memory = 2 MiB, bus.ethercat = 0.00032 Mbit/s;
}
system s for P { source: Source; sink: Sink; }
