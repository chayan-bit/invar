frame world;
frame base: world;
fn run() -> i32 { return 0; }
component Source {
    port out data: Quantity<i32,m> @ 1000 Hz bus ethercat;
    port out tf: Transform<base,world> @ 10 Hz;
    resource cpu_cores = 1, memory = 1 MiB, gpu_memory = 1 MiB;
    license "MIT" modified false;
    isolation in-process;
    wcet 0.5 ms;
    deadline 1 ms;
    impl invar run;
}
component Sink {
    port in data: Quantity<i32,m> @ 500 Hz;
    resource cpu_cores = 1, memory = 1 MiB, gpu_memory = 1 MiB;
    license "MIT";
    isolation in-process;
    wcet 0.5 ms;
    deadline 2 ms;
    impl invar run;
}
connect source.data -> sink.data policy decimate(2);
flow path: source.data -> sink.data within 3 ms;
product P {
    distribution proprietary-binary;
    commercial true;
    robot menagerie::franka_emika_panda;
    capacity cpu_cores = 2, memory = 2 MiB, gpu_memory = 2 MiB, bus.ethercat = 0.032 Mbit/s;
}
system s for P { source: Source; sink: Sink; }
