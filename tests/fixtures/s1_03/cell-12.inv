frame world;
frame base: world;
fn run() -> i32 { return 0; }

component Camera {
    port in input: Quantity<i32,m> @ 10 Hz optional;
    port out output: Quantity<i32,m> @ 10 Hz bus ethercat;
    port in tf: Transform<base,world> @ 10 Hz optional;
    param camera_mount: Transform<base,world> = identity;
    resource cpu_cores = 1, memory = 1 MiB, gpu_memory = 1 MiB;
    license "MIT" modified false;
    isolation in-process;
    wcet 1 ms;
    deadline 100 ms;
    impl invar run;
}

component Perception {
    port in input: Quantity<i32,m> @ 10 Hz;
    port out output: Quantity<i32,m> @ 10 Hz;
    resource cpu_cores = 1, memory = 1 MiB, gpu_memory = 1 MiB;
    license "MIT";
    isolation in-process;
    wcet 1 ms;
    deadline 100 ms;
    impl invar run;
}

component Planner {
    port in input: Quantity<i32,m> @ 10 Hz;
    port out output: Quantity<i32,m> @ 10 Hz;
    resource cpu_cores = 1, memory = 1 MiB, gpu_memory = 1 MiB;
    license "MIT";
    isolation in-process;
    wcet 1 ms;
    deadline 100 ms;
    impl invar run;
}

