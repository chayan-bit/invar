fn copy_f32(xs: read Array<f32>, out: mut Array<f32>) -> u32 {
    for i in 0u32..len(xs) { out[i] = xs[i]; }
    return len(out);
}
fn half_f32(xs: read Array<f32>, out: mut Array<f32>) -> u32 {
    for i in 0u32..len(xs) { out[i] = xs[i] * 0.5; }
    return len(out);
}
fn poke_f32(xs: mut Array<f32>, i: u32) -> u32 {
    xs[0u32] = 1.0;
    xs[i] = -0.0;
    return len(xs);
}
fn count_f32(xs: read Array<f32>) -> u32 { return len(xs); }
fn main() -> i32 { return 0; }
