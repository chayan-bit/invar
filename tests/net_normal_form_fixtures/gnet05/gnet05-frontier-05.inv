fn work(x: i32) -> i32 {
    var v = x % 997 + 1;
    var k = 0;
    while v != 1 {
        if k == 37 { return k; }
        if v % 2 == 0 { v = v / 2; } else { v = v * 3 + 1; }
        k = k + 1;
    }
    return k;
}
fn visit(v: i32, n: i32, d: i32) -> i32 {
    if d <= 0 { return work(v); }
    let deg = (v * 11 + d) % 4;
    if deg == 0 { return work(v); }
    if deg == 1 {
        let w1_0 = visit((v * 17 + 71) % n, n, d - 1);
        return (w1_0 + v) % 10007;
    }
    if deg == 2 {
        let w2_0 = visit((v * 25 + 69) % n, n, d - 1);
        let w2_1 = visit((v * 34 + 12) % n, n, d - 1);
        return (w2_0 + w2_1 + v) % 10007;
    }
    let w3_0 = visit((v * 8 + 65) % n, n, d - 1);
    let w3_1 = visit((v * 13 + 27) % n, n, d - 1);
    let w3_2 = visit((v * 17 + 39) % n, n, d - 1);
    return (w3_0 + w3_1 + w3_2 + v) % 10007;
}
fn run(a: i32, b: i32) -> i32 {
    let n = a + 16;
    return visit(b % n, n, 1 + (a + b) % 5);
}
fn main() -> i32 { return run(44, 5); }
