fn w(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 11) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 16 + n * 2) % 3;
    if sel == 0 {
        let v0_0 = t(n - 1, (s * 9 + 78) % 1009);
        let v0_1 = t(n - 1, (s * 15 + 54) % 1009);
        let v0_2 = t(n - 2, (s * 22 + 49) % 1009);
        return (v0_0 * 1 + v0_1 + v0_2) % 10007;
    }
    if sel == 1 {
        let v1_0 = t(n - 2, (s * 17 + 67) % 1009);
        let v1_1 = t(n - 1, (s * 25 + 38) % 1009);
        let v1_2 = t(n - 1, (s * 6 + 3) % 1009);
        return (v1_0 * 9 + v1_1 + v1_2) % 10007;
    }
    return t(n - 1, (s * 18 + 55) % 1009);
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(4, 294); }
