fn w(x: i32) -> i32 {
    var s = x % 101;
    var i = 0;
    while i < x % 11 {
        s = (s * 2 + i) % 10007;
        i = i + 1;
    }
    return s;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 2 + n * 4) % 4;
    if sel == 0 {
        let v0_0 = t(n - 1, (s * 15 + 23) % 1009);
        let v0_1 = t(n - 1, (s * 24 + 80) % 1009);
        return (v0_0 * 9 + v0_1) % 10007;
    }
    if sel == 1 {
        let v1_0 = t(n - 2, (s * 4 + 56) % 1009);
        let v1_1 = t(n - 2, (s * 29 + 90) % 1009);
        return (v1_0 * 9 + v1_1) % 10007;
    }
    if sel == 2 {
        let v2_0 = t(n - 2, (s * 28 + 40) % 1009);
        let v2_1 = t(n - 2, (s * 6 + 54) % 1009);
        let v2_2 = t(n - 1, (s * 8 + 28) % 1009);
        return (v2_0 * 8 + v2_1 + v2_2) % 10007;
    }
    return t(n - 1, (s * 18 + 47) % 1009);
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 2 { return t((lo * 8 + hi) % 2, (lo * 8 + hi) % 1009); }
    if d <= 0 { return t((hi - lo + 9) % 2, (hi - lo + 9) % 1009); }
    let m1 = lo + 1 + ((hi - lo - 2) * (2 + (lo % 1 + 1) % 1)) / 6;
    let m2 = m1 + 1 + ((hi - m1 - 2) * 3) / 6;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, m2, d - 1);
    let c = dc(m2, hi, d - 1);
    return (a * 1 + b + c * 4) % 100003;
}
fn run(a: i32, b: i32) -> i32 { return dc(48, 48 + a, b); }
fn main() -> i32 { return run(45, 2); }
