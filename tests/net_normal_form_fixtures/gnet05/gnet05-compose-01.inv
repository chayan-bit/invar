fn w(x: i32) -> i32 {
    var s = x % 101;
    var i = 0;
    while i < x % 15 {
        s = (s * 9 + i) % 10007;
        i = i + 1;
    }
    return s;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 2 + n * 3) % 4;
    if sel == 0 {
        let v0_0 = t(n - 1, (s * 3 + 75) % 1009);
        let v0_1 = t(n - 1, (s * 18 + 69) % 1009);
        return (v0_0 * 5 + v0_1) % 10007;
    }
    if sel == 1 {
        return t(n - 1, (s * 7 + 45) % 1009);
    }
    if sel == 2 {
        return t(n - 1, (s * 9 + 43) % 1009);
    }
    return (w(s) + n) % 10007;
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 4 { return t((lo * 8 + hi) % 2, (lo * 8 + hi) % 1009); }
    if d <= 0 { return t((hi - lo + 0) % 2, (hi - lo + 0) % 1009); }
    let m1 = lo + 1 + ((hi - lo - 2) * (3 + (lo % 2 + 2) % 2)) / 7;
    let m2 = m1 + 1 + ((hi - m1 - 2) * 1) / 6;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, m2, d - 1);
    let c = dc(m2, hi, d - 2);
    return (a * 1 + b + c * 1) % 100003;
}
fn run(a: i32, b: i32) -> i32 { return dc(39, 39 + a, b); }
fn main() -> i32 { return run(25, 2); }
