fn w(x: i32) -> i32 {
    var v = x % 997 + 1;
    var k = 0;
    while v != 1 {
        if k == 52 { return k; }
        if v % 2 == 0 { v = v / 2; } else { v = v * 3 + 1; }
        k = k + 1;
    }
    return k;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 28 + n * 1) % 3;
    if sel == 0 {
        let v0_0 = t(n - 2, (s * 15 + 58) % 1009);
        let v0_1 = t(n - 1, (s * 24 + 79) % 1009);
        return (v0_0 * 4 + v0_1) % 10007;
    }
    if sel == 1 {
        let v1_0 = t(n - 2, (s * 23 + 35) % 1009);
        let v1_1 = t(n - 1, (s * 6 + 11) % 1009);
        let v1_2 = t(n - 2, (s * 27 + 55) % 1009);
        return (v1_0 * 5 + v1_1 + v1_2) % 10007;
    }
    return (w(s) + n) % 10007;
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(3, 492); }
