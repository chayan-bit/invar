fn w(x: i32) -> i32 {
    var v = x % 997 + 1;
    var k = 0;
    while v != 1 {
        if k == 54 { return k; }
        if v % 2 == 0 { v = v / 2; } else { v = v * 3 + 1; }
        k = k + 1;
    }
    return k;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 22 + n * 2) % 4;
    if sel == 0 {
        let v0_0 = t(n - 2, (s * 3 + 97) % 1009);
        let v0_1 = t(n - 1, (s * 14 + 84) % 1009);
        let v0_2 = t(n - 1, (s * 3 + 79) % 1009);
        return (v0_0 * 1 + v0_1 + v0_2) % 10007;
    }
    if sel == 1 {
        let v1_0 = t(n - 1, (s * 28 + 96) % 1009);
        let v1_1 = t(n - 2, (s * 12 + 26) % 1009);
        let v1_2 = t(n - 2, (s * 7 + 63) % 1009);
        return (v1_0 * 7 + v1_1 + v1_2) % 10007;
    }
    if sel == 2 {
        let v2_0 = t(n - 2, (s * 18 + 76) % 1009);
        let v2_1 = t(n - 2, (s * 18 + 2) % 1009);
        let v2_2 = t(n - 1, (s * 5 + 93) % 1009);
        return (v2_0 * 8 + v2_1 + v2_2) % 10007;
    }
    return (w(s) + n) % 10007;
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 2 { return t((lo * 8 + hi) % 2, (lo * 8 + hi) % 1009); }
    if d <= 0 { return t((hi - lo + 0) % 2, (hi - lo + 0) % 1009); }
    let m1 = lo + 1 + ((hi - lo - 2) * (3 + (lo % 2 + 2) % 2)) / 7;
    let m2 = m1 + 1 + ((hi - m1 - 2) * 2) / 6;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, m2, d - 1);
    let c = dc(m2, hi, d - 1);
    return (a * 2 + b + c * 3) % 100003;
}
fn run(a: i32, b: i32) -> i32 { return dc(10, 10 + a, b); }
fn main() -> i32 { return run(54, 2); }
