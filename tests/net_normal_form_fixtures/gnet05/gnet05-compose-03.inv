fn w(x: i32) -> i32 {
    var s = x % 101;
    var i = 0;
    while i < x % 14 {
        s = (s * 13 + i) % 10007;
        i = i + 1;
    }
    return s;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 5 + n * 7) % 3;
    if sel == 0 {
        let v0_0 = t(n - 1, (s * 15 + 91) % 1009);
        let v0_1 = t(n - 1, (s * 5 + 75) % 1009);
        return (v0_0 * 8 + v0_1) % 10007;
    }
    if sel == 1 {
        let v1_0 = t(n - 2, (s * 24 + 30) % 1009);
        let v1_1 = t(n - 2, (s * 6 + 36) % 1009);
        return (v1_0 * 6 + v1_1) % 10007;
    }
    return t(n - 1, (s * 4 + 8) % 1009);
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 6 { return t((lo * 8 + hi) % 2, (lo * 8 + hi) % 1009); }
    if d <= 0 { return t((hi - lo + 3) % 2, (hi - lo + 3) % 1009); }
    let m1 = lo + 1 + ((hi - lo - 2) * (1 + (lo % 1 + 1) % 1)) / 8;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, hi, d - 2);
    return (a * 1 + b) % 100003;
}
fn run(a: i32, b: i32) -> i32 { return dc(43, 43 + a, b); }
fn main() -> i32 { return run(54, 2); }
