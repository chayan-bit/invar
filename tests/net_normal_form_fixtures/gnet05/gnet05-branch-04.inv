fn w(x: i32) -> i32 {
    var s = x % 101;
    var i = 0;
    while i < x % 16 {
        s = (s * 9 + i) % 10007;
        i = i + 1;
    }
    return s;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 24 + n * 7) % 3;
    if sel == 0 {
        let v0_0 = t(n - 1, (s * 7 + 78) % 1009);
        let v0_1 = t(n - 2, (s * 29 + 47) % 1009);
        return (v0_0 * 3 + v0_1) % 10007;
    }
    if sel == 1 {
        return (w(s) + n) % 10007;
    }
    return t(n - 1, (s * 13 + 92) % 1009);
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(3, 770); }
