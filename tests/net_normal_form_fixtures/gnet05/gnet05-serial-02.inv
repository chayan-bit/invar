fn f(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 45) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn g(x: i32, k: i32) -> i32 { return (f(x) * 7 + k) % 10007; }
fn down(n: i32) -> i32 {
    if n <= 0 { return 0; }
    return 1 + down(n - 1);
}
fn run(a: i32, b: i32) -> i32 {
    let s1 = f(a);
    let s2 = g(s1 + b, 1);
    let s3 = f(s2 + 13);
    let e = down(s3 % 3 + b);
    return (s3 + e) % 10007;
}
fn main() -> i32 { return run(171, 9); }
