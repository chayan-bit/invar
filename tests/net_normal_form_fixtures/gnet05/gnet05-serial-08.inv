fn f(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 40) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn g(x: i32, k: i32) -> i32 { return (f(x) * 11 + k) % 10007; }
fn run(a: i32, b: i32) -> i32 {
    let s1 = f(a);
    let s2 = g(s1 + b, 96);
    let s3 = f(s2 + 55);
    return (s3) % 10007;
}
fn main() -> i32 { return run(101, 2); }
