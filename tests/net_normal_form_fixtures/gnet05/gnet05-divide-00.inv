fn leaf(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 16) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 5 { return leaf(lo * 4 + hi); }
    if d <= 0 { return leaf(hi - lo + 7); }
    let m1 = lo + 1 + ((hi - lo - 2) * (3 + (lo % 1 + 1) % 1)) / 9;
    let m2 = m1 + 1 + ((hi - m1 - 2) * 3) / 6;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, m2, d - 1);
    let c = dc(m2, hi, d - 1);
    return (a * 5 + b + c * 2) % 100003;
}
fn run(a: i32, b: i32) -> i32 { return dc(45, 45 + a, b); }
fn main() -> i32 { return run(63, 2); }
