fn work(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 42) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn visit(v: i32, n: i32, d: i32) -> i32 {
    if d <= 0 { return work(v); }
    let deg = (v * 16 + d) % 4;
    if deg == 0 { return work(v); }
    if deg == 1 {
        let w1_0 = visit((v * 27 + 23) % n, n, d - 1);
        return (w1_0 + v) % 10007;
    }
    if deg == 2 {
        let w2_0 = visit((v * 7 + 92) % n, n, d - 1);
        let w2_1 = visit((v * 25 + 65) % n, n, d - 1);
        return (w2_0 + w2_1 + v) % 10007;
    }
    let w3_0 = visit((v * 36 + 26) % n, n, d - 1);
    let w3_1 = visit((v * 22 + 35) % n, n, d - 1);
    let w3_2 = visit((v * 15 + 6) % n, n, d - 1);
    return (w3_0 + w3_1 + w3_2 + v) % 10007;
}
fn run(a: i32, b: i32) -> i32 {
    let n = a + 26;
    return visit(b % n, n, 1 + (a + b) % 4);
}
fn main() -> i32 { return run(36, 51); }
