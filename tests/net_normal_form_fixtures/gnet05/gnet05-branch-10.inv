fn w(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 32) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 29 + n * 3) % 3;
    if sel == 0 {
        let v0_0 = t(n - 2, (s * 19 + 45) % 1009);
        let v0_1 = t(n - 2, (s * 20 + 91) % 1009);
        let v0_2 = t(n - 2, (s * 25 + 73) % 1009);
        return (v0_0 * 2 + v0_1 + v0_2) % 10007;
    }
    if sel == 1 {
        return t(n - 1, (s * 17 + 57) % 1009);
    }
    return t(n - 1, (s * 2 + 96) % 1009);
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(4, 325); }
