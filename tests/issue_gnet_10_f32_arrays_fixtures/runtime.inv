fn copy_elements(xs:read Array<f32>)->Array<f32> {var b=filled_f32(len(xs),0.0);for i in 0u32..len(xs) {b[i]=xs[i];}return b;} fn move_back(xs:take Array<f32>)->Array<f32> {return xs;} fn make(n:u32,x:f32)->Array<f32> {if true {let dead=filled_i32(2u32,4);}let integers=filled_u32(1u32,4294967295u32);let xs=filled_f32(n,x);let b=copy_elements(xs);return move_back(move b);} fn run(n:u32,x:f32)->f32 {let xs=make(n,x);return xs[0u32];} fn main()->i32 {return 7;}
