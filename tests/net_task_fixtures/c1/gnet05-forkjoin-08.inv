fn leaf(x: i32) -> i32 {
    var s = x % 101;
    var i = 0;
    while i < x % 3 {
        s = (s * 8 + i) % 10007;
        i = i + 1;
    }
    return s;
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 2 { return leaf(lo * 5 + hi); }
    if d <= 0 { return leaf(hi - lo + 2); }
    let m1 = lo + 1 + ((hi - lo - 2) * (3 + (lo % 1 + 1) % 1)) / 5;
    let m2 = m1 + 1 + ((hi - m1 - 2) * 1) / 6;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, m2, d - 1);
    let c = dc(m2, hi, d - 1);
    if (a + b) % 2 == 0 {
        let extra = dc(lo, m1, d - 2);
        return (extra * a + b + c) % 10007;
    }
    return (a * 6 + b + c) % 10007;
}
fn run(a: i32, b: i32) -> i32 { return dc(10, 10 + a, b); }
fn main() -> i32 { return run(52, 2); }
