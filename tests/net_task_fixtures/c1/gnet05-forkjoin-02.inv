fn w(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 9) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 22 + n * 7) % 3;
    if sel == 0 {
        let v0_0 = t(n - 1, (s * 23 + 50) % 1009);
        let v0_1 = t(n - 2, (s * 12 + 8) % 1009);
        let v0_2 = t(n - 1, (s * 16 + 88) % 1009);
        if (v0_0 + v0_1) % 2 == 0 {
            let extra0 = t(n - 2, (s * 16 + 84) % 1009);
            return (extra0 * v0_0 + v0_1 + v0_2) % 10007;
        }
        return (v0_0 * 4 + v0_1 + v0_2) % 10007;
    }
    if sel == 1 {
        return t(n - 1, (s * 3 + 7) % 1009);
    }
    return t(n - 1, (s * 21 + 44) % 1009);
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(3, 611); }
