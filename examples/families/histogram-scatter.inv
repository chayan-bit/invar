// Weighted histogram: duplicate bin indices combine with the wrapping_add law, so order does not matter.
fn hist(a: read Array<u32>, ix: read Array<u32>, n: u32) -> Array<u32> {
    var out = filled_u32(n, 0u32);
    for i in 0u32 .. len(ix) {
        out[ix[i]] = wrapping_add(out[ix[i]], a[i]);
    }
    return out;
}

fn main() -> i32 {
    let a: Array<u32> = [1u32, 2u32, 3u32, 4u32];
    let ix: Array<u32> = [2u32, 0u32, 2u32, 2u32];
    let bins = hist(a, ix, 3u32);
    if bins[0u32] == 2u32 and bins[1u32] == 0u32 and bins[2u32] == 8u32 {
        return 7;
    }
    return 0;
}
