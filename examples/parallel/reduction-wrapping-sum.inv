// A modular u32 sum is a lawful reduction: wrapping_add is associative with identity 0.
fn main() -> i32 {
    let xs: Array<u32> = [4294967295u32, 1u32, 7u32];
    var acc: u32 = 0u32;
    for i in 0u32 .. len(xs) {
        acc = wrapping_add(acc, xs[i]);
    }
    if acc == 7u32 {
        return 7;
    }
    return 0;
}
