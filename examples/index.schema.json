{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chayan-bit/invar/blob/main/examples/index.schema.json",
  "title": "invar-examples-index-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "spec", "pending_families", "examples"],
  "properties": {
    "schema": { "const": "invar-examples-index-v1" },
    "spec": { "type": "string", "pattern": "^docs/spec/[A-Za-z0-9._-]+\\.md$" },
    "pending_families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "reason"],
        "properties": {
          "family": { "$ref": "#/$defs/family" },
          "reason": { "type": "string", "minLength": 10 }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/example" }
    }
  },
  "$defs": {
    "family": {
      "enum": [
        "core", "ownership", "modules", "records", "variants", "result", "views", "generics",
        "closures", "bytes-text", "c-abi", "units-frames", "f32", "map", "reduction", "scan",
        "transpose", "stencil", "matrix", "segmented", "gather-scatter", "frontier", "summaries",
        "system", "graph-checks", "foreign-manifest", "cell", "float-reductions", "sort", "f64"
      ]
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "intent", "family", "tags", "spec_section", "engines", "expect"],
      "properties": {
        "path": { "type": "string", "pattern": "^examples/.+\\.inv$" },
        "intent": { "type": "string", "minLength": 10, "maxLength": 300 },
        "family": { "$ref": "#/$defs/family" },
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
        "spec_section": { "type": "string", "pattern": "^([0-9]+|[A-Z])(\\.[0-9]+)*$" },
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["reference", "mir", "cpu-parallel", "native-serial", "check", "system", "generate", "explain", "recognize"] }
        },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status"],
      "properties": {
        "command": { "enum": ["run", "check", "system"] },
        "status": { "enum": ["ok", "source_error", "tool_error", "trap", "evaluation_limit"] },
        "value": { "type": "integer" },
        "category": { "type": "string" },
        "code": { "type": "string" },
        "diagnostics": { "type": "array", "items": { "type": "string", "pattern": "^S?[A-Z0-9_]+:(error|warning|note)$" } },
        "ir_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "generate": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "files", "tree_sha256"],
            "properties": {
              "target": { "enum": ["ros2", "mjcf", "urdf"] },
              "files": { "type": "integer", "minimum": 1 },
              "tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "explain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["regions"],
          "properties": {
            "regions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["function", "status", "kind"],
                "properties": {
                  "function": { "type": "string" },
                  "status": { "enum": ["admitted", "rejected"] },
                  "kind": { "type": "string" }
                }
              }
            }
          }
        },
        "recognize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "entry"],
          "properties": { "module": { "type": "string", "pattern": "^[a-z_]+_source$" }, "entry": { "type": "string" } }
        }
      }
    }
  }
}
