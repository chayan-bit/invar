fn mat(a:read Array<f32>,b:read Array<f32>,rows:u32,inner:u32,cols:u32)->Array<f32>{var c=filled_f32(rows*cols,0.0);for i in 0u32..rows{for j in 0u32..cols{var sum:f32=0.0;for k in 0u32..inner{sum=sum+a[i*inner+k]*b[k*cols+j];}c[i*cols+j]=sum;}}return c;} fn main()->i32{let a:Array<f32> = [1.0,2.0];let b:Array<f32> = [3.0,4.0];let c=mat(a,b,1u32,2u32,1u32);let d:Array<f32> = [1.0,2.0,3.0,4.0];let e=mat(d,d,2u32,2u32,2u32);if c[0u32]==11.0 and e[3u32]==22.0{return 7;}return 0;}
