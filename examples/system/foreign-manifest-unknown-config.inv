frame world;
frame base: world;
frame tool: base;

extern component fk {
    abi c "invar_fk_bridge_v1";
    lifecycle init, configure, step, shutdown;
    config c "unknown_layout";
    port in q: std::robotics::JointPositions<f64,7> @ 10 Hz layout c "inv_joint7_f64";
    port out pose: std::robotics::Pose<f64,base,tool> @ 10 Hz layout c "inv_pose_f64";
    resource cpu_cores = 1, memory = 64 MiB;
    license "BSD-2-Clause" link dynamic;
    isolation in-process;
    golden "golden/panda_fk.json" tolerance abs 0.000000000001 m, abs 0.000000000001 rad;
    property "pose.rotation is unit norm within 0.000000000001";
    shim "shim/fk_bridge.c";
}
