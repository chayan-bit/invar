// Production endpoint contract candidate; no passing record or live qualification.
frame world; frame base: world; frame tool: base; frame cube: world;
extern component curobo_planner {
    abi c "invar_curobo_bridge_v1";
    lifecycle init, configure, step, shutdown;
    config c "inv_planner_config_v1";
    port in request: std::robotics::PlannerRequest<f64,7,base,tool,cube> @ 0.2 Hz layout c "inv_planner_request7_f64_v2";
    port out trajectory: std::robotics::PlannerTrajectory<f64,7> @ 0.2 Hz layout c "inv_planner_trajectory7_f64_v1";
    resource cpu_cores = 1, memory = 1 GiB, gpu_memory = 2 GiB;
    wcet 5 s; deadline 5 s;
    license "Apache-2.0"; isolation separate-process;
    golden "endpoint-source-panda-v3.json" tolerance abs 0.002 m, abs 0.017453292519943295 rad;
    property "trajectory is finite";
    shim "bridge.c";
    input "../../../../../tests/fixtures/foreign-components/CMakeLists.txt";
    input "../../../../../tests/fixtures/foreign-components/curobo_planner/check_panda_spheres.py";
    input "../../../../../tests/fixtures/foreign-components/curobo_planner/compare_model_fk.py";
    input "../../../../../tests/fixtures/foreign-components/curobo_planner/fit_panda_spheres.py";
    input "../../../../../tests/fixtures/foreign-components/curobo_planner/model_sources.json";
    input "../../../../../tests/fixtures/foreign-components/curobo_planner/panda_spheres.json";
    input "../../../../../tests/fixtures/foreign-components/curobo_planner/prepare_models.py";
    input "../../../../../tests/fixtures/foreign-components/generate_pinocchio_goldens.py";
    input "../../../../../tests/fixtures/foreign-components/models/franka_emika_panda/LICENSE";
    input "../../../../../tests/fixtures/foreign-components/models/franka_emika_panda/panda.xml";
    input "../../../../../tests/fixtures/foreign-components/pinocchio_goldens.json";
    input "../pinocchio_fk/abi_exports.map";
    input "../pinocchio_fk/abi_reference.cpp";
    input "../pinocchio_fk/abi_reference.h";
    input "../pinocchio_fk/bridge.c";
    input "../pinocchio_fk/bridge_exports.map";
    input "../pinocchio_fk/core.cpp";
    input "../pinocchio_fk/core.hpp";
    input "../pinocchio_fk/golden/panda_fk.json";
    input "../pinocchio_fk/manifest.inv";
    input "artifacts/panda/fk-evidence.json";
    input "artifacts/panda/libinvar_curobo_bridge_v1.so";
    input "artifacts/panda/libinvar_pinocchio_bridge_v1.so";
    input "artifacts/panda/panda.urdf";
    input "artifacts/panda/panda.yml";
    input "artifacts/panda/scene.yml";
    input "planner_reference.c";
    input "planner_reference.h";
    input "planner_server.py";
    input "runtime-source-panda-v3.json";
    input "../../cell.inv";
    input "../../assets/menagerie/franka_emika_panda/panda.xml";
    input "../../assets/menagerie/franka_emika_panda/scene.xml";
}
