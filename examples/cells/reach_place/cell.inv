fn run() -> i32 { return 0; }

component joint_state_broadcaster {
    port out q: std::robotics::JointPositions<f64,robot_dof> @ 100 Hz;
    param base_mount: Transform<base,robot_base> = identity;
    resource cpu_cores = 1, memory = 32 MiB;
    license "Apache-2.0";
    isolation in-process;
    wcet 1 ms;
    deadline 10 ms;
    impl invar run;
}

component joint_trajectory_controller {
    port out cmd: Quantity<i32,one> @ 100 Hz;
    resource cpu_cores = 1, memory = 32 MiB;
    license "Apache-2.0";
    isolation separate-process;
    wcet 1 ms;
    deadline 10 ms;
    impl invar run;
}
component mujoco_sim {
    port in cmd: Quantity<i32,one> @ 100 Hz;
    resource cpu_cores = 1, memory = 512 MiB;
    license "Apache-2.0";
    isolation separate-process;
    wcet 1 ms;
    deadline 10 ms;
    impl invar run;
}
connect controller.cmd -> hardware.cmd policy sample-and-hold;
connect joint_states.q -> fk.q policy sample-and-hold;

cell ReachPlaceCell {
    robot menagerie::franka_emika_panda;
    mount xyz (0 m, 0 m, 0 m) quat (1, 0, 0, 0) on table
        exclude (menagerie::universal_robots_ur5e::base, menagerie::universal_robots_ur5e::shoulder_link);
    fixture table {
        pose xyz (0.4 m, 0 m, -0.05 m) quat (1, 0, 0, 0);
        collision box (0.5, 0.5, 0.05) m;
    }
    object cube {
        pose xyz (0.3 m, 0 m, 0.025 m) quat (1, 0, 0, 0);
        dynamic mass 0.1 kg attachable;
        grasp pose xyz(0 m, 0 m, 0.025 m) quat(0, 1, 0, 0);
        visual box (0.025, 0.025, 0.025) m;
        collision box (0.025, 0.025, 0.025) m;
    }
    fixture place_target {
        pose xyz (0.5 m, 0.2 m, 0.025 m) quat (1, 0, 0, 0);
        visual sphere 0.0125 m;
    }
    io attach: digital-out;
    io release: digital-out;
}

product ReachPlace {
    distribution proprietary-binary;
    commercial true;
    robot menagerie::franka_emika_panda;
    capacity cpu_cores = 6, memory = 2 GiB, gpu_memory = 4 GiB;
}
system reach_place for ReachPlace {
    controller: joint_trajectory_controller;
    hardware: mujoco_sim;
    joint_states: joint_state_broadcaster;
    fk: pinocchio_fk;
}
