FROM ros:lyrical-ros-base@sha256:0c19f326a339ed770ef1d4c0646a8b53bdb49dd5ff74b6de41ebdb8ac21e1806

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip=25.1.1+dfsg-1ubuntu2 \
    python3-venv=3.14.3-0ubuntu2 \
    ros-lyrical-ros2-control=6.10.1-1resolute.20260915.111302 \
    ros-lyrical-ros2-controllers=6.9.0-1resolute.20260915.152705 \
    ros-lyrical-controller-manager=6.10.1-1resolute.20260915.093533 \
    ros-lyrical-mujoco-ros2-control=0.1.2-1resolute.20260915.151755 \
    ros-lyrical-mujoco-ros2-control-demos=0.1.2-1resolute.20260915.155654 \
    ros-lyrical-mujoco-vendor=0.1.0-1resolute.20260826.114034 \
    ros-lyrical-generate-parameter-library=1.3.0-1resolute.20260915.081108 \
    ros-lyrical-rmw-zenoh-cpp=0.10.6-1resolute.20260915.025944 \
    ros-lyrical-rosbag2-storage-mcap=0.33.3-1resolute.20260915.090607 \
    ros-lyrical-ros2bag=0.33.3-1resolute.20260915.110720 \
    ros-lyrical-ros2launch=0.29.9-1resolute.20260915.085616 \
    ros-lyrical-pinocchio=4.1.0-1resolute.20260825.014748 \
    && rm -rf /var/lib/apt/lists/*

# The base image has August interface libraries, while the September
# controller-manager build requires the corresponding September symbols.
RUN set -eu; \
    mkdir -p /tmp/ros-interface-fix; \
    for spec in \
      'builtin-interfaces 2.4.5-1resolute.20260915.031157 dee6396621880ecfe451ff37c762c85307c9efa78b116c80cf3f41ea5ce11bc6' \
      'geometry-msgs 5.9.3-1resolute.20260915.045122 c21ce9ae38c1e08951b4a04be0f3cdc0db2e453e11fdb788f6fbca17504d93be' \
      'lifecycle-msgs 2.4.5-1resolute.20260915.045218 421bfda503a7450d53c17b62e9eb8052f5cff96443ed66b6796064aabfe8d5bb' \
      'sensor-msgs 5.9.3-1resolute.20260915.051912 fb822ad5540b05180e58f9b9bda2ffd22ecc682e47d2e9423571db6fc77f2a4e' \
      'service-msgs 2.4.5-1resolute.20260915.032658 f960bc5b9350293f0e20a30160c41719dcc79590d28985c0a54b22383875a962' \
      'std-msgs 5.9.3-1resolute.20260915.043001 4a96b08da7529506056272abdffc63e0a42ba78925757fe62559c21424d79a72'; do \
      read -r package version checksum <<< "$spec"; \
      file="ros-lyrical-${package}_${version}_amd64.deb"; \
      curl -fsSL --retry 3 \
        "https://repo.ros2.org/ubuntu/main/pool/main/r/ros-lyrical-${package}/${file}" \
        -o "/tmp/ros-interface-fix/${file}"; \
      printf '%s  %s\n' "$checksum" "/tmp/ros-interface-fix/${file}" | sha256sum -c -; \
    done; \
    dpkg -i /tmp/ros-interface-fix/*.deb; \
    rm -rf /tmp/ros-interface-fix

COPY mujoco-requirements.txt /tmp/mujoco-requirements.txt
RUN python3 -m venv --system-site-packages /opt/invar-ros-python \
    && /opt/invar-ros-python/bin/pip install --no-cache-dir --require-hashes \
         -r /tmp/mujoco-requirements.txt \
    && rm /tmp/mujoco-requirements.txt

ENV PATH="/opt/invar-ros-python/bin:${PATH}"
