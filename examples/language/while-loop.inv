// while re-evaluates its condition each iteration; for iterates a half-open u32 range.
fn main() -> i32 {
    var n: i32 = 0;
    var steps: i32 = 0;
    while n < 10 {
        n = n + 3;
        steps = steps + 1;
    }
    var count: i32 = 0;
    for i in 2u32 .. 5u32 {
        count = count + 1;
    }
    return steps * 10 + count;
}
