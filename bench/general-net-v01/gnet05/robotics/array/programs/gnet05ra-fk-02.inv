    w[o + 129u32] = w[o + 96u32] * 0.0 + w[o + 97u32] * (-0.04) + w[o + 98u32] * 0.0584 + w[o + 105u32];
    w[o + 123u32] = w[o + 99u32] * (-1.0) + w[o + 100u32] * 0.0 + w[o + 101u32] * 0.0;
    w[o + 124u32] = w[o + 99u32] * 0.0 + w[o + 100u32] * (-1.0) + w[o + 101u32] * 0.0;
    w[o + 125u32] = w[o + 99u32] * 0.0 + w[o + 100u32] * 0.0 + w[o + 101u32] * 1.0;
    w[o + 130u32] = w[o + 99u32] * 0.0 + w[o + 100u32] * (-0.04) + w[o + 101u32] * 0.0584 + w[o + 106u32];
    w[o + 126u32] = w[o + 102u32] * (-1.0) + w[o + 103u32] * 0.0 + w[o + 104u32] * 0.0;
    w[o + 127u32] = w[o + 102u32] * 0.0 + w[o + 103u32] * (-1.0) + w[o + 104u32] * 0.0;
    w[o + 128u32] = w[o + 102u32] * 0.0 + w[o + 103u32] * 0.0 + w[o + 104u32] * 1.0;
    w[o + 131u32] = w[o + 102u32] * 0.0 + w[o + 103u32] * (-0.04) + w[o + 104u32] * 0.0584 + w[o + 107u32];
}
fn fk(w: mut Array<f32>, o: u32, cs: read Array<f32>) -> Unit {
    w[o + 0u32] = 1.0;
    w[o + 1u32] = 0.0;
    w[o + 2u32] = 0.0;
    w[o + 3u32] = 0.0;
    w[o + 4u32] = 1.0;
    w[o + 5u32] = 0.0;
    w[o + 6u32] = 0.0;
    w[o + 7u32] = 0.0;
    w[o + 8u32] = 1.0;
    w[o + 9u32] = 0.0;
    w[o + 10u32] = 0.0;
    w[o + 11u32] = 0.0;
    link1(w, o, cs[0u32], cs[1u32]);
    link2(w, o, cs[2u32], cs[3u32]);
    link3(w, o, cs[4u32], cs[5u32]);
    link4(w, o, cs[6u32], cs[7u32]);
    link5(w, o, cs[8u32], cs[9u32]);
    link6(w, o, cs[10u32], cs[11u32]);
    link7(w, o, cs[12u32], cs[13u32]);
    link8(w, o);
    link9(w, o);
    link10(w, o);
}
fn tool(t: read Array<f32>, i: u32) -> f32 {
    let r = 96u32 + 3u32 * i;
    return t[r] * 0.0 + t[r + 1u32] * 0.0 + t[r + 2u32] * 0.0 + t[96u32 + 9u32 + i];
}
fn run(a: read Array<f32>, out: mut Array<f32>) -> u32 {
    let n = len(a) / 7u32;
    var cs = filled_f32(14u32, 0.0);
    for b in 0u32..n {
        for jf in 0u32..7u32 {
            sincos(a[b * 7u32 + jf], cs, jf);
        }
        fk(out, b * 132u32, cs);
    }
    return n;
}
fn main() -> i32 {
    return 0;
}
