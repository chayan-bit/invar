fn distance(gw: read Array<f32>, g: u32, gi: read Array<u32>, gt: read Array<f32>, ox: f32, oy: f32, oz: f32, orad: f32) -> f32 {
    let k = g * 10u32;
    let w = 6u32 * g;
    let cx = gw[w];
    let cy = gw[w + 1u32];
    let cz = gw[w + 2u32];
    let ax = gw[w + 3u32];
    let ay = gw[w + 4u32];
    let az = gw[w + 5u32];
    let r = gt[k];
    let h = gt[k + 1u32];
    if gi[2u32 * g + 1u32] == 0u32 {
        let p0x = cx - h * ax;
        let p0y = cy - h * ay;
        let p0z = cz - h * az;
        let dx = gt[k + 2u32] * ax;
        let dy = gt[k + 2u32] * ay;
        let dz = gt[k + 2u32] * az;
        var u = ((ox - p0x) * dx + (oy - p0y) * dy + (oz - p0z) * dz) * gt[k + 3u32];
        if u < 0.0 {
            u = 0.0;
        }
        if u > 1.0 {
            u = 1.0;
        }
        let ex = ox - (p0x + u * dx);
        let ey = oy - (p0y + u * dy);
        let ez = oz - (p0z + u * dz);
        return root(ex * ex + ey * ey + ez * ez) - (r + orad);
    }
    let vx = ox - cx;
    let vy = oy - cy;
    let vz = oz - cz;
    let along = vx * ax + vy * ay + vz * az;
    let rx = vx - along * ax;
    let ry = vy - along * ay;
    let rz = vz - along * az;
    let radial = root(rx * rx + ry * ry + rz * rz);
    var aa = along;
    if aa < 0.0 {
        aa = -aa;
