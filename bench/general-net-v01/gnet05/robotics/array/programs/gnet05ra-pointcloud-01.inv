// GNET-05 robotics corpus, host-array inputs: pointcloud (none, trigonometric, staged).
fn sincos(x: f32, cs: mut Array<f32>, j: u32) -> Unit {
    var k = 0.0;
    var m = 0u32;
    while x * 0.63661975 - k > 0.5 {
        k = k + 1.0;
        m = m + 1u32;
    }
    while x * 0.63661975 - k < (-0.5) {
        k = k - 1.0;
        m = m + 3u32;
    }
    let r = x - k * 1.5703125 - k * 0.0004837513 - k * 0.0000000754979;
    let z = r * r;
    let s = (((-0.00019515296) * z + 0.008332161) * z - 0.16666655) * z * r + r;
    let c = ((0.000024433157 * z - 0.0013887316) * z + 0.041666646) * z * z - 0.5 * z + 1.0;
    let q = m % 4u32;
    var sn = s;
    var cn = c;
    if q == 1u32 {
        sn = c;
        cn = -s;
    } else if q == 2u32 {
        sn = -s;
        cn = -c;
    } else if q == 3u32 {
        sn = -c;
        cn = s;
    }
    cs[2u32 * j] = cn;
    cs[2u32 * j + 1u32] = sn;
}
fn pose(f: mut Array<f32>, fr: read Array<f32>) -> Unit {
    sincos(fr[0u32], f, 0u32);
    f[2u32] = fr[1u32];
    f[3u32] = fr[2u32];
    f[4u32] = fr[3u32];
}
fn sample(pts: mut Array<f32>, raw: read Array<f32>, i: u32, fr: read Array<f32>) -> Unit {
    let px = raw[3u32 * i];
    let py = raw[3u32 * i + 1u32];
    let pz = raw[3u32 * i + 2u32];
    pts[3u32 * i] = fr[0u32] * px - fr[1u32] * py + fr[2u32];
    pts[3u32 * i + 1u32] = fr[1u32] * px + fr[0u32] * py + fr[3u32];
    pts[3u32 * i + 2u32] = pz + fr[4u32];
}
fn keep(pts: read Array<f32>, i: u32) -> Bool {
    let wx = pts[3u32 * i];
    let wy = pts[3u32 * i + 1u32];
    let wz = pts[3u32 * i + 2u32];
    let r2 = wx * wx + wy * wy + wz * wz;
    return wx >= (-1.5) and wx <= 1.5 and wy >= (-1.5) and wy <= 1.5 and wz >= 0.05 and wz <= 1.8 and r2 >= 0.04 and r2 <= 4.0;
}
fn neighbours(out: read Array<f32>, kept: u32, a: u32) -> f32 {
    let ax = out[1u32 + 3u32 * a];
    let ay = out[2u32 + 3u32 * a];
    let az = out[3u32 + 3u32 * a];
    var count = 0u32;
    for k in 0u32..kept {
        let dx = out[1u32 + 3u32 * k] - ax;
        let dy = out[2u32 + 3u32 * k] - ay;
        let dz = out[3u32 + 3u32 * k] - az;
        if dx * dx + dy * dy + dz * dz <= 0.0225 {
            count = count + 1u32;
        }
    }
    return f32_from_u32(count);
}
fn run(fr: read Array<f32>, raw: read Array<f32>, m: u32, out: mut Array<f32>) -> u32 {
    var fw = filled_f32(5u32, 0.0);
    pose(fw, fr);
    let n = len(raw) / 3u32;
    var pts = filled_f32(3u32 * n, 0.0);
    for i in 0u32..n {
        sample(pts, raw, i, fw);
    }
    var flag = filled_u32(n, 0u32);
    for i2 in 0u32..n {
        if keep(pts, i2) {
            flag[i2] = 1u32;
        }
    }
    var kept = 0u32;
    for i3 in 0u32..n {
        kept = kept + flag[i3];
    }
    out[0u32] = f32_from_u32(kept);
    var w = 0u32;
    for i4 in 0u32..n {
        if flag[i4] == 1u32 {
            out[1u32 + 3u32 * w] = pts[3u32 * i4];
            out[2u32 + 3u32 * w] = pts[3u32 * i4 + 1u32];
            out[3u32 + 3u32 * w] = pts[3u32 * i4 + 2u32];
            w = w + 1u32;
        }
    }
    var q = m;
    if kept < q {
        q = kept;
    }
    for a in 0u32..q {
        let count = neighbours(out, kept, a);
        out[1u32 + 3u32 * kept + a] = count;
    }
    return kept;
}
fn main() -> i32 {
    return 0;
}
