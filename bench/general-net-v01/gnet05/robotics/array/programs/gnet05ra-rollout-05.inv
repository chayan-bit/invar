fn tool(t: read Array<f32>, i: u32) -> f32 {
    let r = 72u32 + 3u32 * i;
    return t[r] * 0.0 + t[r + 1u32] * 0.1 + t[r + 2u32] * 0.0 + t[72u32 + 9u32 + i];
}
fn run(q0: read Array<f32>, u: read Array<f32>, target: read Array<f32>, out: mut Array<f32>) -> u32 {
    let lo: Array<f32> = [(-6.28319), (-6.28319), (-3.1415), (-6.28319), (-6.28319), (-6.28319)];
    let hi: Array<f32> = [6.28319, 6.28319, 3.1415, 6.28319, 6.28319, 6.28319];
    if len(q0) == 0u32 {
        return 0u32;
    }
    let n = len(q0) / 6u32;
    let h = len(u) / len(q0);
    var q = filled_f32(6u32, 0.0);
    var v = filled_f32(6u32, 0.0);
    var cs = filled_f32(12u32, 0.0);
    var t = filled_f32(84u32, 0.0);
    for b in 0u32..n {
        for j0 in 0u32..6u32 {
            q[j0] = q0[b * 6u32 + j0];
            v[j0] = 0.0;
        }
        for k in 0u32..h {
            var uu = 0.0;
            for j in 0u32..6u32 {
                let uj = u[(b * h + k) * 6u32 + j];
                uu = uu + uj * uj;
                v[j] = v[j] + 0.01 * uj;
                var p = q[j] + 0.01 * v[j];
                if p < lo[j] {
                    p = lo[j];
                    v[j] = 0.0;
                }
                if p > hi[j] {
                    p = hi[j];
                    v[j] = 0.0;
                }
                q[j] = p;
                sincos(p, cs, j);
            }
            fk(t, 0u32, cs);
            let ex = tool(t, 0u32) - target[0u32];
            let ey = tool(t, 1u32) - target[1u32];
            let ez = tool(t, 2u32) - target[2u32];
            let o = (b * h + k) * 7u32;
            for j2 in 0u32..6u32 {
                out[o + j2] = q[j2];
            }
            out[o + 6u32] = ex * ex + ey * ey + ez * ez + 0.001 * uu;
        }
    }
    return n;
}
