fn fk(w: mut Array<f32>, o: u32, cs: read Array<f32>) -> Unit {
    w[o + 0u32] = 1.0;
    w[o + 1u32] = 0.0;
    w[o + 2u32] = 0.0;
    w[o + 3u32] = 0.0;
    w[o + 4u32] = 1.0;
