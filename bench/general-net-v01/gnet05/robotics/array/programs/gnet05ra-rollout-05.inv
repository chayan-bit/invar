// GNET-05 robotics corpus, host-array inputs: rollout (ur5e, trigonometric, segments).
fn sincos(x: f32, cs: mut Array<f32>, j: u32) -> Unit {
    var k = 0.0;
    var m = 0u32;
    while x * 0.63661975 - k > 0.5 {
        k = k + 1.0;
        m = m + 1u32;
    }
    while x * 0.63661975 - k < (-0.5) {
        k = k - 1.0;
        m = m + 3u32;
    }
    let r = x - k * 1.5703125 - k * 0.0004837513 - k * 0.0000000754979;
    let z = r * r;
    let s = (((-0.00019515296) * z + 0.008332161) * z - 0.16666655) * z * r + r;
    let c = ((0.000024433157 * z - 0.0013887316) * z + 0.041666646) * z * z - 0.5 * z + 1.0;
    let q = m % 4u32;
    var sn = s;
    var cn = c;
    if q == 1u32 {
        sn = c;
        cn = -s;
    } else if q == 2u32 {
        sn = -s;
        cn = -c;
    } else if q == 3u32 {
        sn = -c;
        cn = s;
    }
    cs[2u32 * j] = cn;
    cs[2u32 * j + 1u32] = sn;
}
