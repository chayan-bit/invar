// GNET-05 robotics corpus: collision (ur5e, precomputed transforms, table).
fn lcg(x: u32) -> u32 {
    return wrapping_add(wrapping_mul(x, 1664525u32), 1013904223u32);
}
fn unit(x: u32) -> f32 {
    return f32_from_u32(x / 256u32) * 0.000000059604645;
}
fn stream(seed: u32, i: u32) -> u32 {
    return lcg(wrapping_add(wrapping_mul(i, 2654435761u32), seed));
}
fn root(x: f32) -> f32 {
    if x <= 0.0 {
        return 0.0;
    }
    var m = x;
    var g = 1.0;
    while m >= 4.0 {
        m = m * 0.25;
        g = g * 2.0;
    }
    while m < 1.0 {
        m = m * 4.0;
        g = g * 0.5;
    }
    var y = 1.1666666 - 0.16666667 * m;
    for i in 0u32..5u32 {
        y = y * (1.5 - 0.5 * m * y * y);
    }
    return m * y * g;
}
fn rational(cs: mut Array<f32>, seed: u32, b: u32, nj: u32) -> Unit {
    var x = stream(seed, b);
    for j in 0u32..nj {
        x = lcg(x);
        let u = 2.0 * unit(x) - 1.0;
        let d = 1.0 + u * u;
        cs[2u32 * j] = (1.0 - u * u) / d;
        cs[2u32 * j + 1u32] = (u + u) / d;
    }
}
fn fk(w: mut Array<f32>, o: u32, cs: read Array<f32>, par: read Array<u32>, fix: read Array<f32>, ax: read Array<u32>, jt: read Array<u32>, jm: mut Array<f32>) -> Unit {
    for e in 0u32..12u32 {
        w[o + e] = fix[e];
    }
    for i in 1u32..len(par) {
        let so = o + i * 12u32;
        let po = o + par[i] * 12u32;
        let ao = i * 12u32;
        let a = ax[i];
        let c = cs[2u32 * jt[i]];
        let s = cs[2u32 * jt[i] + 1u32];
        for k in 0u32..3u32 {
            let f = ao + 3u32 * k;
            let x = fix[f];
            let y = fix[f + 1u32];
            let z = fix[f + 2u32];
            jm[3u32 * k] = x;
            jm[3u32 * k + 1u32] = y;
            jm[3u32 * k + 2u32] = z;
            if a == 3u32 {
                jm[3u32 * k] = c * x + s * y;
                jm[3u32 * k + 1u32] = c * y - s * x;
            } else if a == 2u32 {
                jm[3u32 * k] = c * x - s * z;
                jm[3u32 * k + 2u32] = s * x + c * z;
            } else if a == 1u32 {
                jm[3u32 * k + 1u32] = c * y + s * z;
                jm[3u32 * k + 2u32] = c * z - s * y;
            }
        }
        for r in 0u32..3u32 {
            let pr = po + r * 3u32;
            for col in 0u32..3u32 {
                w[so + r * 3u32 + col] = w[pr] * jm[col] + w[pr + 1u32] * jm[3u32 + col] + w[pr + 2u32] * jm[6u32 + col];
            }
            w[so + 9u32 + r] = w[pr] * fix[ao + 9u32] + w[pr + 1u32] * fix[ao + 10u32] + w[pr + 2u32] * fix[ao + 11u32] + w[po + 9u32 + r];
        }
    }
}
fn tool(t: read Array<f32>, i: u32) -> f32 {
    let r = 72u32 + 3u32 * i;
    return t[r] * 0.0 + t[r + 1u32] * 0.1 + t[r + 2u32] * 0.0 + t[72u32 + 9u32 + i];
}
fn place(gw: mut Array<f32>, t: read Array<f32>, gi: read Array<u32>, gt: read Array<f32>) -> Unit {
    for g in 0u32..len(gi) / 2u32 {
        let bo = gi[2u32 * g] * 12u32;
        let k = g * 10u32;
        for r in 0u32..3u32 {
            let br = bo + 3u32 * r;
            gw[6u32 * g + r] = t[br] * gt[k + 4u32] + t[br + 1u32] * gt[k + 5u32] + t[br + 2u32] * gt[k + 6u32] + t[bo + 9u32 + r];
            gw[6u32 * g + 3u32 + r] = t[br] * gt[k + 7u32] + t[br + 1u32] * gt[k + 8u32] + t[br + 2u32] * gt[k + 9u32];
        }
    }
}
fn distance(gw: read Array<f32>, g: u32, gi: read Array<u32>, gt: read Array<f32>, ox: f32, oy: f32, oz: f32, orad: f32) -> f32 {
    let k = g * 10u32;
    let w = 6u32 * g;
    let cx = gw[w];
    let cy = gw[w + 1u32];
    let cz = gw[w + 2u32];
    let ax = gw[w + 3u32];
    let ay = gw[w + 4u32];
    let az = gw[w + 5u32];
    let r = gt[k];
    let h = gt[k + 1u32];
    if gi[2u32 * g + 1u32] == 0u32 {
        let p0x = cx - h * ax;
        let p0y = cy - h * ay;
        let p0z = cz - h * az;
        let dx = gt[k + 2u32] * ax;
        let dy = gt[k + 2u32] * ay;
        let dz = gt[k + 2u32] * az;
        var u = ((ox - p0x) * dx + (oy - p0y) * dy + (oz - p0z) * dz) * gt[k + 3u32];
        if u < 0.0 {
            u = 0.0;
        }
        if u > 1.0 {
            u = 1.0;
        }
        let ex = ox - (p0x + u * dx);
        let ey = oy - (p0y + u * dy);
        let ez = oz - (p0z + u * dz);
        return root(ex * ex + ey * ey + ez * ez) - (r + orad);
    }
    let vx = ox - cx;
    let vy = oy - cy;
    let vz = oz - cz;
    let along = vx * ax + vy * ay + vz * az;
    let rx = vx - along * ax;
    let ry = vy - along * ay;
    let rz = vz - along * az;
    let radial = root(rx * rx + ry * ry + rz * rz);
    var aa = along;
    if aa < 0.0 {
        aa = -aa;
    }
    let qx = radial - r;
    let qy = aa - h;
    var px = qx;
    if px < 0.0 {
        px = 0.0;
    }
    var py = qy;
    if py < 0.0 {
        py = 0.0;
    }
    var inside = qx;
    if qy > inside {
        inside = qy;
    }
    if inside > 0.0 {
        inside = 0.0;
    }
    return root(px * px + py * py) + inside - orad;
}
