    let gt: Array<f32> = [0.06, 0.06, 0.12, 69.44444, 0.0, 0.0, (-0.04), 0.0, 0.0, 1.0, 0.06, 0.06, 0.12, 69.44444, 0.0, (-0.04), 0.0, 0.0, (-1.0), 0.0000000000000002220446, 0.05, 0.2, 0.4, 6.25, 0.0, 0.0, 0.2, 0.0, 0.0, 1.0, 0.055, 0.06, 0.12, 69.44444, 0.0, 0.08, 0.0, 0.0, (-1.0), 0.0000000000000002220446, 0.038, 0.19, 0.38, 6.9252076, 0.0, 0.0, 0.2, 0.0, 0.0, 1.0, 0.04, 0.07, 0.14, 51.02041, 0.0, 0.05, 0.0, 0.0, (-1.0), 0.0000000000000002220446, 0.04, 0.06, 0.12, 69.44444, 0.0, 0.0, 0.04, 0.0, 0.0, 1.0, 0.04, 0.04, 0.08, 156.25, 0.0, 0.02, 0.1, 0.0, (-1.0), 0.0000000000000002220446, 0.04, 0.02, 0.04, 625.0, 0.0, 0.08, 0.0, 0.0, (-1.0), 0.0000000000000002220446];
