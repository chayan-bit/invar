fn tool(t: read Array<f32>, i: u32) -> f32 {
    let r = 72u32 + 3u32 * i;
    return t[r] * 0.0 + t[r + 1u32] * 0.1 + t[r + 2u32] * 0.0 + t[72u32 + 9u32 + i];
}
fn jacobian(out: mut Array<f32>, o: u32, t: read Array<f32>, jx: read Array<u32>) -> Unit {
    let px = tool(t, 0u32);
    let py = tool(t, 1u32);
    let pz = tool(t, 2u32);
    let n = len(jx) / 2u32;
    for j in 0u32..n {
        let bo = jx[2u32 * j] * 12u32;
        let a = jx[2u32 * j + 1u32] - 1u32;
        let zx = t[bo + a];
        let zy = t[bo + 3u32 + a];
        let zz = t[bo + 6u32 + a];
        let dx = px - t[bo + 9u32];
        let dy = py - t[bo + 10u32];
        let dz = pz - t[bo + 11u32];
        out[o + j] = zy * dz - zz * dy;
        out[o + n + j] = zz * dx - zx * dz;
        out[o + 2u32 * n + j] = zx * dy - zy * dx;
        out[o + 3u32 * n + j] = zx;
        out[o + 4u32 * n + j] = zy;
        out[o + 5u32 * n + j] = zz;
    }
}
fn run(seed: u32, n: u32) -> Array<f32> {
    let lo: Array<f32> = [(-6.28319), (-6.28319), (-3.1415), (-6.28319), (-6.28319), (-6.28319)];
    let span: Array<f32> = [12.56638, 12.56638, 6.283, 12.56638, 12.56638, 12.56638];
    let jx: Array<u32> = [1u32, 3u32, 2u32, 2u32, 3u32, 2u32, 4u32, 2u32, 5u32, 3u32, 6u32, 2u32];
    var out = filled_f32(n * 36u32, 0.0);
    var cs = filled_f32(12u32, 0.0);
    var t = filled_f32(84u32, 0.0);
    for b in 0u32..n {
        angles(cs, seed, b, lo, span);
        fk(t, 0u32, cs);
        jacobian(out, b * 36u32, t, jx);
    }
    return out;
}
fn probe(q0: f32, q1: f32, q2: f32, q3: f32, q4: f32, q5: f32) -> Array<f32> {
