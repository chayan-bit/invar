    sincos(q1, cs, 1u32);
    sincos(q2, cs, 2u32);
    sincos(q3, cs, 3u32);
    sincos(q4, cs, 4u32);
    sincos(q5, cs, 5u32);
    var t = filled_f32(84u32, 0.0);
    fk(t, 0u32, cs);
    var out = filled_f32(36u32, 0.0);
