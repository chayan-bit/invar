fn w(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 38) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 7 + n * 2) % 4;
    if sel == 0 {
        let v0_0 = t(n - 2, (s * 22 + 38) % 1009);
        let v0_1 = t(n - 1, (s * 27 + 96) % 1009);
        let v0_2 = t(n - 2, (s * 24 + 56) % 1009);
        if v0_0 > v0_1 { return (v0_0 * 3 + v0_1 + v0_2) % 10007; }
        return (v0_1 * v0_1 % 10007 + v0_0 + v0_1 + v0_2) % 10007;
    }
    if sel == 1 {
        return t(n - 1, (s * 7 + 88) % 1009);
    }
    if sel == 2 {
        let v2_0 = t(n - 2, (s * 4 + 43) % 1009);
        let v2_1 = t(n - 1, (s * 22 + 43) % 1009);
        let v2_2 = t(n - 2, (s * 16 + 79) % 1009);
        if v2_0 > v2_1 { return (v2_0 * 2 + v2_1 + v2_2) % 10007; }
        return (v2_1 * v2_1 % 10007 + v2_0 + v2_1 + v2_2) % 10007;
    }
    return t(n - 1, (s * 17 + 95) % 1009);
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(4, 654); }
