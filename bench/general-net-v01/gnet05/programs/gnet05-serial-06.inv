fn f(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 22) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn g(x: i32, k: i32) -> i32 { return (f(x) * 2 + k) % 10007; }
fn run(a: i32, b: i32) -> i32 {
    let s1 = f(a);
    let s2 = g(s1 + b, 32);
    let s3 = f(s2 + 21);
    let q = s3 / (b % 7 - 0);
    return (s3 + q) % 10007;
}
fn main() -> i32 { return run(489, 8); }
