fn w(x: i32) -> i32 {
    var s = x % 101;
    var i = 0;
    while i < x % 16 {
        s = (s * 6 + i) % 10007;
        i = i + 1;
    }
    return s;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 4 + n * 1) % 4;
    if sel == 0 {
        let v0_0 = t(n - 1, (s * 29 + 92) % 1009);
        let v0_1 = t(n - 2, (s * 27 + 65) % 1009);
        return (v0_0 * 6 + v0_1) % 10007;
    }
    if sel == 1 {
        let v1_0 = t(n - 1, (s * 21 + 13) % 1009);
        let v1_1 = t(n - 1, (s * 2 + 17) % 1009);
        return (v1_0 * 9 + v1_1) % 10007;
    }
    if sel == 2 {
        return (w(s) + n) % 10007;
    }
    return t(n - 1, (s * 17 + 51) % 1009);
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 6 { return t((lo * 4 + hi) % 2, (lo * 4 + hi) % 1009); }
    if d <= 0 { return t((hi - lo + 4) % 2, (hi - lo + 4) % 1009); }
    let m1 = lo + 1 + ((hi - lo - 2) * (1 + (lo % 1 + 1) % 1)) / 9;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, hi, d - 2);
    return (a * 6 + b) % 100003;
}
fn run(a: i32, b: i32) -> i32 { return dc(10, 10 + a, b); }
fn main() -> i32 { return run(53, 2); }
