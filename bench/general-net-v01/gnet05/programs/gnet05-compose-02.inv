fn w(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 36) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 31 + n * 2) % 3;
    if sel == 0 {
        let v0_0 = t(n - 1, (s * 22 + 84) % 1009);
        let v0_1 = t(n - 2, (s * 23 + 19) % 1009);
        return (v0_0 * 3 + v0_1) % 10007;
    }
    if sel == 1 {
        let v1_0 = t(n - 2, (s * 2 + 28) % 1009);
        let v1_1 = t(n - 2, (s * 29 + 76) % 1009);
        let v1_2 = t(n - 2, (s * 2 + 48) % 1009);
        return (v1_0 * 4 + v1_1 + v1_2) % 10007;
    }
    return t(n - 1, (s * 19 + 13) % 1009);
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 3 { return t((lo * 8 + hi) % 2, (lo * 8 + hi) % 1009); }
    if d <= 0 { return t((hi - lo + 9) % 2, (hi - lo + 9) % 1009); }
    let m1 = lo + 1 + ((hi - lo - 2) * (2 + (lo % 3 + 3) % 3)) / 8;
    let m2 = m1 + 1 + ((hi - m1 - 2) * 2) / 8;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, m2, d - 1);
    let c = dc(m2, hi, d - 1);
    return (a * 6 + b + c * 5) % 100003;
}
fn run(a: i32, b: i32) -> i32 { return dc(5, 5 + a, b); }
fn main() -> i32 { return run(26, 2); }
