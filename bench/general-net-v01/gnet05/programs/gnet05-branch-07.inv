fn w(x: i32) -> i32 {
    var s = x % 101;
    var i = 0;
    while i < x % 4 {
        s = (s * 2 + i) % 10007;
        i = i + 1;
    }
    return s;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 29 + n * 6) % 4;
    if sel == 0 {
        let v0_0 = t(n - 1, (s * 14 + 60) % 1009);
        let v0_1 = t(n - 1, (s * 12 + 66) % 1009);
        return (v0_0 * 7 + v0_1) % 10007;
    }
    if sel == 1 {
        return (w(s) + n) % 10007;
    }
    if sel == 2 {
        let v2_0 = t(n - 1, (s * 6 + 64) % 1009);
        let v2_1 = t(n - 1, (s * 18 + 29) % 1009);
        return (v2_0 * 5 + v2_1) % 10007;
    }
    return t(n - 1, (s * 4 + 22) % 1009);
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(4, 816); }
