fn work(x: i32) -> i32 {
    var v = x % 997 + 1;
    var k = 0;
    while v != 1 {
        if k == 47 { return k; }
        if v % 2 == 0 { v = v / 2; } else { v = v * 3 + 1; }
        k = k + 1;
    }
    return k;
}
fn visit(v: i32, n: i32, d: i32) -> i32 {
    if d <= 0 { return work(v); }
    let deg = (v * 9 + d) % 3;
    if deg == 0 { return work(v); }
    if deg == 1 {
        let w1_0 = visit((v * 25 + 76) % n, n, d - 1);
        return (w1_0 + v) % 10007;
    }
    let w2_0 = visit((v * 29 + 76) % n, n, d - 1);
    let w2_1 = visit((v * 37 + 54) % n, n, d - 1);
    return (w2_0 + w2_1 + v) % 10007;
}
fn run(a: i32, b: i32) -> i32 {
    let n = a + 5;
    return visit(b % n, n, 1 + (a + b) % 5);
}
fn main() -> i32 { return run(29, 87); }
