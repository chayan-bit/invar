fn w(x: i32) -> i32 {
    var s = x % 101;
    var i = 0;
    while i < x % 6 {
        s = (s * 8 + i) % 10007;
        i = i + 1;
    }
    return s;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 4 + n * 3) % 3;
    if sel == 0 {
        let v0_0 = t(n - 1, (s * 18 + 1) % 1009);
        let v0_1 = t(n - 1, (s * 21 + 49) % 1009);
        let v0_2 = t(n - 2, (s * 27 + 25) % 1009);
        return (v0_0 * v0_1 + v0_0 * 5 + v0_1 + v0_2) % 10007;
    }
    if sel == 1 {
        return t(n - 1, (s * 27 + 47) % 1009);
    }
    return t(n - 1, (s * 22 + 80) % 1009);
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(3, 928); }
