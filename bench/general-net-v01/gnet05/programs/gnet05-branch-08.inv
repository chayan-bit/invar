fn w(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 43) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 24 + n * 1) % 4;
    if sel == 0 {
        let v0_0 = t(n - 2, (s * 4 + 17) % 1009);
        let v0_1 = t(n - 2, (s * 26 + 20) % 1009);
        let v0_2 = t(n - 1, (s * 9 + 36) % 1009);
        return (v0_0 * 6 + v0_1 + v0_2) % 10007;
    }
    if sel == 1 {
        return t(n - 1, (s * 3 + 2) % 1009);
    }
    if sel == 2 {
        let v2_0 = t(n - 2, (s * 3 + 13) % 1009);
        let v2_1 = t(n - 1, (s * 20 + 48) % 1009);
        let v2_2 = t(n - 1, (s * 15 + 0) % 1009);
        return (v2_0 * 9 + v2_1 + v2_2) % 10007;
    }
    return t(n - 1, (s * 21 + 12) % 1009);
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(4, 344); }
