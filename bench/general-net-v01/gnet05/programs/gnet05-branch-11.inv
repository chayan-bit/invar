fn w(x: i32) -> i32 {
    var s = x % 101;
    var i = 0;
    while i < x % 4 {
        s = (s * 4 + i) % 10007;
        i = i + 1;
    }
    return s;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 25 + n * 4) % 2;
    if sel == 0 {
        let v0_0 = t(n - 2, (s * 9 + 33) % 1009);
        let v0_1 = t(n - 1, (s * 28 + 37) % 1009);
        return (v0_0 * 7 + v0_1) % 10007;
    }
    return t(n - 1, (s * 29 + 13) % 1009);
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(3, 990); }
