fn leaf(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 48) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 6 { return leaf(lo * 2 + hi); }
    if d <= 0 { return leaf(hi - lo + 5); }
    let m1 = lo + 1 + ((hi - lo - 2) * (2 + (lo % 3 + 3) % 3)) / 8;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, hi, d - 2);
    return (a * 3 + b) % 100003;
}
fn visit(v: i32, n: i32, d: i32) -> i32 {
    if d <= 0 { return dc(v % 17, v % 17 + 9, 2); }
    let deg = (v * 11 + d) % 4;
    if deg == 0 { return dc(v % 17, v % 17 + 9, 2); }
    if deg == 1 {
        let w1_0 = visit((v * 17 + 11) % n, n, d - 1);
        return (w1_0 + v) % 10007;
    }
    if deg == 2 {
        let w2_0 = visit((v * 40 + 88) % n, n, d - 1);
        let w2_1 = visit((v * 12 + 66) % n, n, d - 1);
        return (w2_0 + w2_1 + v) % 10007;
    }
    let w3_0 = visit((v * 28 + 35) % n, n, d - 1);
    let w3_1 = visit((v * 36 + 90) % n, n, d - 1);
    let w3_2 = visit((v * 41 + 18) % n, n, d - 1);
    return (w3_0 + w3_1 + w3_2 + v) % 10007;
}
fn run(a: i32, b: i32) -> i32 {
    let n = a + 23;
    return visit(b % n, n, 1 + (a + b) % 4);
}
fn main() -> i32 { return run(46, 65); }
