fn f(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 17) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn g(x: i32, k: i32) -> i32 { return (f(x) * 9 + k) % 10007; }
fn down(n: i32) -> i32 {
    if n <= 0 { return 0; }
    return 1 + down(n - 1);
}
fn run(a: i32, b: i32) -> i32 {
    let s1 = f(a);
    let s2 = g(s1 + b, 26);
    let s3 = f(s2 + 44);
    let q = s3 / (b % 6 - 3);
    let e = down(s3 % 3 + b);
    return (s3 + q + e) % 10007;
}
fn main() -> i32 { return run(23, 0); }
