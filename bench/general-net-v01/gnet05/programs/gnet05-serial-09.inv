fn f(x: i32) -> i32 {
    var v = x % 997 + 1;
    var k = 0;
    while v != 1 {
        if k == 44 { return k; }
        if v % 2 == 0 { v = v / 2; } else { v = v * 3 + 1; }
        k = k + 1;
    }
    return k;
}
fn g(x: i32, k: i32) -> i32 { return (f(x) * 10 + k) % 10007; }
fn down(n: i32) -> i32 {
    if n <= 0 { return 0; }
    return 1 + down(n - 1);
}
fn run(a: i32, b: i32) -> i32 {
    let s1 = f(a);
    let s2 = g(s1 + b, 65);
    let s3 = f(s2 + 30);
    let e = down(s3 % 3 + b);
    return (s3 + e) % 10007;
}
fn main() -> i32 { return run(132, 4); }
