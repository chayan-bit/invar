fn w(x: i32) -> i32 {
    var s = x % 101;
    var i = 0;
    while i < x % 9 {
        s = (s * 11 + i) % 10007;
        i = i + 1;
    }
    return s;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 4 + n * 7) % 3;
    if sel == 0 {
        let v0_0 = t(n - 2, (s * 15 + 50) % 1009);
        let v0_1 = t(n - 2, (s * 5 + 30) % 1009);
        if (v0_0 + v0_1) % 2 == 0 {
            let extra0 = t(n - 2, (s * 16 + 82) % 1009);
            return (extra0 * v0_0 + v0_1) % 10007;
        }
        return (v0_0 * 8 + v0_1) % 10007;
    }
    if sel == 1 {
        let v1_0 = t(n - 1, (s * 6 + 67) % 1009);
        let v1_1 = t(n - 2, (s * 29 + 52) % 1009);
        let v1_2 = t(n - 2, (s * 19 + 32) % 1009);
        if (v1_0 + v1_1) % 2 == 0 {
            let extra1 = t(n - 2, (s * 20 + 65) % 1009);
            return (extra1 * v1_0 + v1_1 + v1_2) % 10007;
        }
        return (v1_0 * 3 + v1_1 + v1_2) % 10007;
    }
    return (w(s) + n) % 10007;
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(3, 876); }
