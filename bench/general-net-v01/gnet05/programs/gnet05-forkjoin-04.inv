fn w(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 19) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 10 + n * 6) % 2;
    if sel == 0 {
        let v0_0 = t(n - 1, (s * 26 + 41) % 1009);
        let v0_1 = t(n - 1, (s * 29 + 12) % 1009);
        if (v0_0 + v0_1) % 5 == 0 {
            let extra0 = t(n - 2, (s * 3 + 69) % 1009);
            return (extra0 * v0_0 + v0_1) % 10007;
        }
        return (v0_0 * 9 + v0_1) % 10007;
    }
    return (w(s) + n) % 10007;
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(3, 213); }
