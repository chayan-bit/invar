fn w(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 18) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn t(n: i32, s: i32) -> i32 {
    if n <= 0 { return w(s); }
    let sel = (s * 16 + n * 1) % 3;
    if sel == 0 {
        let v0_0 = t(n - 2, (s * 25 + 67) % 1009);
        let v0_1 = t(n - 2, (s * 23 + 65) % 1009);
        return (v0_0 * 1 + v0_1) % 10007;
    }
    if sel == 1 {
        return t(n - 1, (s * 5 + 15) % 1009);
    }
    return t(n - 1, (s * 29 + 18) % 1009);
}
fn run(a: i32, b: i32) -> i32 { return t(a, b % 1009); }
fn main() -> i32 { return run(4, 508); }
