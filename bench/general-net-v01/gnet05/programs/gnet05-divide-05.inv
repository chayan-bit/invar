fn leaf(x: i32) -> i32 {
    if x % 2 == 0 { return (x / 2 + 44) % 10007; }
    return (x * 3 + 1) % 10007;
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 6 { return leaf(lo * 5 + hi); }
    if d <= 0 { return leaf(hi - lo + 5); }
    let m1 = lo + 1 + ((hi - lo - 2) * (2 + (lo % 3 + 3) % 3)) / 9;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, hi, d - 2);
    return (a * 2 + b) % 100003;
}
fn run(a: i32, b: i32) -> i32 { return dc(20, 20 + a, b); }
fn main() -> i32 { return run(34, 2); }
