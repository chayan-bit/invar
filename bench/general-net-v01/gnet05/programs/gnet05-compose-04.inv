fn leaf(x: i32) -> i32 {
    var s = x % 101;
    var i = 0;
    while i < x % 10 {
        s = (s * 13 + i) % 10007;
        i = i + 1;
    }
    return s;
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 5 { return leaf(lo * 1 + hi); }
    if d <= 0 { return leaf(hi - lo + 4); }
    let m1 = lo + 1 + ((hi - lo - 2) * (7 + (lo % 1 + 1) % 1)) / 9;
    let m2 = m1 + 1 + ((hi - m1 - 2) * 4) / 7;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, m2, d - 1);
    let c = dc(m2, hi, d - 2);
    return (a * 6 + b + c * 1) % 100003;
}
fn visit(v: i32, n: i32, d: i32) -> i32 {
    if d <= 0 { return dc(v % 17, v % 17 + 9, 2); }
    let deg = (v * 12 + d) % 4;
    if deg == 0 { return dc(v % 17, v % 17 + 9, 2); }
    if deg == 1 {
        let w1_0 = visit((v * 39 + 60) % n, n, d - 1);
        return (w1_0 + v) % 10007;
    }
    if deg == 2 {
        let w2_0 = visit((v * 2 + 95) % n, n, d - 1);
        let w2_1 = visit((v * 33 + 23) % n, n, d - 1);
        return (w2_0 + w2_1 + v) % 10007;
    }
    let w3_0 = visit((v * 12 + 80) % n, n, d - 1);
    let w3_1 = visit((v * 28 + 28) % n, n, d - 1);
    let w3_2 = visit((v * 41 + 4) % n, n, d - 1);
    return (w3_0 + w3_1 + w3_2 + v) % 10007;
}
fn run(a: i32, b: i32) -> i32 {
    let n = a + 35;
    return visit(b % n, n, 1 + (a + b) % 3);
}
fn main() -> i32 { return run(8, 60); }
