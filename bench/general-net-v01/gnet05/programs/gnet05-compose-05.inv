fn leaf(x: i32) -> i32 {
    var v = x % 997 + 1;
    var k = 0;
    while v != 1 {
        if k == 47 { return k; }
        if v % 2 == 0 { v = v / 2; } else { v = v * 3 + 1; }
        k = k + 1;
    }
    return k;
}
fn dc(lo: i32, hi: i32, d: i32) -> i32 {
    if hi - lo <= 3 { return leaf(lo * 7 + hi); }
    if d <= 0 { return leaf(hi - lo + 5); }
    let m1 = lo + 1 + ((hi - lo - 2) * (3 + (lo % 2 + 2) % 2)) / 6;
    let a = dc(lo, m1, d - 1);
    let b = dc(m1, hi, d - 2);
    return (a * 1 + b) % 100003;
}
fn visit(v: i32, n: i32, d: i32) -> i32 {
    if d <= 0 { return dc(v % 17, v % 17 + 9, 2); }
    let deg = (v * 19 + d) % 4;
    if deg == 0 { return dc(v % 17, v % 17 + 9, 2); }
    if deg == 1 {
        let w1_0 = visit((v * 5 + 95) % n, n, d - 1);
        return (w1_0 + v) % 10007;
    }
    if deg == 2 {
        let w2_0 = visit((v * 32 + 37) % n, n, d - 1);
        let w2_1 = visit((v * 35 + 47) % n, n, d - 1);
        return (w2_0 + w2_1 + v) % 10007;
    }
    let w3_0 = visit((v * 5 + 1) % n, n, d - 1);
    let w3_1 = visit((v * 3 + 54) % n, n, d - 1);
    let w3_2 = visit((v * 6 + 18) % n, n, d - 1);
    return (w3_0 + w3_1 + w3_2 + v) % 10007;
}
fn run(a: i32, b: i32) -> i32 {
    let n = a + 9;
    return visit(b % n, n, 1 + (a + b) % 3);
}
fn main() -> i32 { return run(30, 8); }
