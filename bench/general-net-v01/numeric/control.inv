fn recurse(x:f32,n:u32)->f32 {if n==0u32 {return x;}return recurse(x+0.000000059604644775390625,n-1u32);}
fn loop(x:f32,n:u32)->f32 {var acc=x;for i in 0u32..n {acc=acc+0.000000059604644775390625;}return acc;}
fn selected(a:f32,b:f32,side:Bool)->f32 {if side {return a;}let dead=0.0/0.0;return b;}
fn main()->i32 {if recurse(1.0,3u32)==1.0 and loop(1.0,4u32)==1.0 {return 7;}return 0;}
