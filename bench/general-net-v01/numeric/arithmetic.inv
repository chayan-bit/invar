fn add(a:f32,b:f32)->f32 {return a+b;}
fn sub(a:f32,b:f32)->f32 {return a-b;}
fn mul(a:f32,b:f32)->f32 {return a*b;}
fn div(a:f32,b:f32)->f32 {return a/b;}
fn fused(a:f32,b:f32,c:f32)->f32 {return fma(a,b,c);}
fn separate(a:f32,b:f32,c:f32)->f32 {return a*b+c;}
fn negate(a:f32)->f32 {return -a;}
fn echo(a:f32)->f32 {return a;}
fn main()->i32 {let x=fused(1.00000011920928955078125,0.99999988079071044921875,-1.0);if x<0.0 and add(1.0,0.000000059604644775390625)==1.0 {return 7;}return 0;}
