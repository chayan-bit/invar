fn loan(xs: mut Array<i32>, n: u32) -> i32 { for i in 0u32..n { let tmp = filled_i32(2u32, 3); xs[0u32] = xs[0u32] + tmp[0u32]; } return xs[0u32]; }
fn compact(n: u32) -> i32 { if true { let dead = filled_i32(2u32, 0); } var xs: Array<i32> = [1]; return loan(xs, n); }
fn main() -> i32 { return compact(4u32); }
