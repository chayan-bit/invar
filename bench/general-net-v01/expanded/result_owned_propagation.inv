fn decode_good() -> Result<String, Utf8Error> {
  let raw: Bytes = b"caf\xC3\xA9";
  let text: String = utf8_decode(raw)?;
  return Result::Ok(move text);
}

fn decode_bad() -> Result<String, Utf8Error> {
  let raw: Bytes = b"\xFF";
  let text: String = utf8_decode(raw)?;
  return Result::Ok(move text);
}

fn main() -> i32 {
  let good: Result<String, Utf8Error> = decode_good();
  let bad: Result<String, Utf8Error> = decode_bad();
  let a: u32 = match move good { Result::Ok(good_text) => len(good_text), Result::Err(good_error) => 0u32 };
  let b: u32 = match move bad { Result::Ok(bad_text) => 0u32, Result::Err(bad_error) => 1u32 };
  if a == 5u32 and b == 1u32 { return 7; }
  return 0;
}
