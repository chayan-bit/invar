{
  "schema": "invar-robotics-ros-mapping-v1",
  "records": [
    {"invar": "Point", "ros": "geometry_msgs/msg/Point", "field": "point"},
    {"invar": "Vector3", "ros": "geometry_msgs/msg/Vector3", "field": "vector"},
    {"invar": "Quaternion", "ros": "geometry_msgs/msg/Quaternion", "field": "orientation"},
    {"invar": "Pose", "ros": "geometry_msgs/msg/Pose", "field": "pose"},
    {"invar": "Twist", "ros": "geometry_msgs/msg/Twist", "field": "twist"},
    {"invar": "Wrench", "ros": "geometry_msgs/msg/Wrench", "field": "wrench"},
    {"invar": "JointPositions", "ros": "sensor_msgs/msg/JointState", "field": "position"},
    {"invar": "JointVelocities", "ros": "sensor_msgs/msg/JointState", "field": "velocity"},
    {"invar": "JointEfforts", "ros": "sensor_msgs/msg/JointState", "field": "effort"},
    {"invar": "JointState", "ros": "sensor_msgs/msg/JointState", "field": "joint_state"},
    {"invar": "JointWaypoint", "ros": "trajectory_msgs/msg/JointTrajectoryPoint", "field": "point"},
    {"invar": "JointTrajectory", "ros": "trajectory_msgs/msg/JointTrajectory", "field": "trajectory"},
    {"invar": "Distortion", "ros": "sensor_msgs/msg/CameraInfo", "field": "distortion_model,d"},
    {"invar": "CameraIntrinsics", "ros": "sensor_msgs/msg/CameraInfo", "field": "camera_info"},
    {"invar": "CameraExtrinsics", "ros": "geometry_msgs/msg/TransformStamped", "field": "transform"},
    {"invar": "Stamped", "ros": "std_msgs/msg/Header", "field": "header"}
  ],
  "pose_wrappers": ["geometry_msgs/msg/PoseStamped", "geometry_msgs/msg/TransformStamped"],
  "frame_id": "declared_frame_name",
  "numeric_units": "REP-103 SI; CameraInfo pixel coordinates remain nominal px",
  "unit_scale_rules": {
    "m": ["m", "1", "1", "0"],
    "mm": ["m", "1", "1000", "0"],
    "um": ["m", "1", "1000000", "0"],
    "rad": ["rad", "1", "1", "0"],
    "urad": ["rad", "1", "1000000", "0"],
    "deg": ["rad", "1", "180", "1"],
    "s": ["s", "1", "1", "0"],
    "ms": ["s", "1", "1000", "0"],
    "us": ["s", "1", "1000000", "0"],
    "ns": ["s", "1", "1000000000", "0"],
    "Hz": ["Hz", "1", "1", "0"],
    "N": ["N", "1", "1", "0"],
    "Nm": ["Nm", "1", "1", "0"],
    "px": ["px", "1", "1", "0"]
  },
  "joint_name_policy": "exactly_N_known_names_or_S1701",
  "joint_state_conversion_boundary": "invar::robotics::from_ros_joint_state",
  "joint_units": "rad_or_m_by_declared_robot_joint_kind",
  "quaternion_property": "declared_unit_norm",
  "pose_equivalent_type": "Transform<Child,Parent>",
  "stamped_frame_identity": "declared_frame_name"
}
