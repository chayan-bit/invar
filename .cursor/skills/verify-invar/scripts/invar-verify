class VerifyError(Exception):
    def __init__(self, message: str, exit_code: int = 2):
        super().__init__(message)
        self.exit_code = exit_code


def find_repo(start: Path) -> Path:
    for candidate in [start, *start.parents]:
        cargo = candidate / "Cargo.toml"
        toolchain = candidate / "rust-toolchain.toml"
        if not cargo.is_file() or not toolchain.is_file():
            continue
        text = cargo.read_text(encoding="utf-8", errors="replace")
        header = text.split("[workspace]", 1)[0]
        if 'name = "invar"' in header:
            return candidate
    raise VerifyError(
        f"could not find the Invar repo from {start}. "
        "Run this from a checkout, or pass --repo."
    )


def resolve_repo(explicit: Path | None) -> Path:
    if explicit is not None:
        return find_repo(explicit.resolve())
    try:
        return find_repo(Path.cwd().resolve())
    except VerifyError:
        return find_repo(Path(__file__).resolve())


def command_output(argv: list[str], timeout: float = 15) -> tuple[int, str, str]:
    try:
        completed = subprocess.run(
            argv,
            check=False,
            capture_output=True,
            timeout=timeout,
            text=True,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return 127, "", str(error)
    return completed.returncode, completed.stdout.strip(), completed.stderr.strip()


def llvm_probe() -> dict:
    prefix = os.environ.get("LLVM_SYS_211_PREFIX")
    if prefix and Path(prefix).is_dir():
        return {
            "available": True,
            "detail": f"LLVM_SYS_211_PREFIX={prefix}",
        }
    found = []
    for name in ("llvm-config-21", "llvm-config"):
        path = shutil.which(name)
        if path is None:
            continue
        code, out, err = command_output([path, "--version"])
        version = out or err or f"exit {code}"
        found.append(f"{path} {version}")
        if code == 0 and version.startswith("21."):
            return {"available": True, "detail": f"{path} {version}"}
    llvm18 = Path("/usr/lib/llvm-18")
    if llvm18.is_dir():
        found.append("/usr/lib/llvm-18")
    if not found:
        detail = "LLVM 21.1.8 is not installed"
    else:
        detail = (
            "native builds need LLVM 21.1.8; rustc's LLVM is not a substitute. Found "
            + "; ".join(found)
        )
    return {"available": False, "detail": detail}


def nvidia_probe() -> dict:
    path = shutil.which("nvidia-smi")
    if path is None:
        return {
            "present": False,
            "detail": "nvidia-smi is not installed and no NVIDIA device was queried",
        }
    code, out, err = command_output([path, "-L"], timeout=20)
    if code != 0:
        return {
            "present": False,
            "detail": f"{path} -L exited {code}: {err or out or 'no device list'}",
        }
    if not out:
        return {"present": False, "detail": f"{path} -L printed no devices"}
    return {"present": True, "detail": out.splitlines()[0]}


def cxx_probe() -> dict:
    """The device CPU model compiles C++20 that includes <barrier>.

    `invar gnet-device` reads `CXX` and otherwise runs `c++`. On this image
    `c++` is clang, which does not see libstdc++'s `<barrier>`, while `g++` does.
    """

    def compiles(compiler: str) -> bool:
        path = shutil.which(compiler)
        if path is None:
            return False
        with tempfile.TemporaryDirectory(prefix="invar-verify-cxx-") as tmp:
            source = Path(tmp) / "barrier.cpp"
            source.write_text("#include <barrier>\nint main(){return 0;}\n", encoding="utf-8")
            code, _, _ = command_output(
                [path, "-std=c++20", str(source), "-c", "-o", str(Path(tmp) / "barrier.o")],
                timeout=60,
            )
            return code == 0

    chosen = os.environ.get("CXX")
    if chosen:
        ok = compiles(chosen)
        return {
            "compiler": chosen if ok else None,
            "override": False,
            "detail": (
                f"CXX={chosen} can compile <barrier>"
                if ok
                else f"CXX={chosen} cannot compile a C++20 <barrier> program"
            ),
        }
    if compiles("c++"):
        return {
            "compiler": "c++",
            "override": False,
            "detail": "`c++ -std=c++20` can compile <barrier>",
        }
    if compiles("g++"):
        return {
            "compiler": "g++",
            "override": True,
            "detail": (
                "`c++` cannot compile <barrier> (on this host it is clang and does not "
                "see libstdc++'s header). g++ can. The drive sets CXX=g++ for "
                "gnet-device CPU models, which is the compiler switch invar already reads."
            ),
        }
    return {
        "compiler": None,
        "override": False,
        "detail": (
            "Neither `c++` nor `g++` can compile a C++20 program that includes <barrier>. "
            "gnet-device CPU models cannot run here."
        ),
    }


def host_probe() -> dict:
    rustc = shutil.which("rustc")
    cargo = shutil.which("cargo")
    rustc_version = ""
    cargo_version = ""
    if rustc:
        _, rustc_version, _ = command_output([rustc, "--version"])
    if cargo:
        _, cargo_version, _ = command_output([cargo, "--version"])
    return {
        "os": platform.system(),
        "arch": platform.machine(),
        "rustc": rustc_version or None,
        "cargo": cargo_version or None,
        "llvm21": llvm_probe(),
        "nvidia": nvidia_probe(),
        "metal_host": platform.system() == "Darwin",
        "ros2": shutil.which("ros2"),
        "nextest": shutil.which("cargo-nextest"),
        "just": shutil.which("just"),
        "cxx": cxx_probe(),
    }


class Session:
    def __init__(self, repo: Path, root: Path, dry_run: bool):
        self.repo = repo
        self.root = root
        self.scratch = root / "scratch"
        self.evidence = root / "evidence"
        self.checks_dir = self.evidence / "checks"
        self.dry_run = dry_run
        self.checks: list[dict] = []
        self.binary = Path(os.environ.get("INVAR_VERIFY_BIN", repo / "target" / "debug" / "invar"))
        self.host = host_probe()
        cxx = self.host["cxx"]
        if cxx.get("override") and cxx.get("compiler") and "CXX" not in os.environ:
            os.environ["CXX"] = cxx["compiler"]

    def prepare_dirs(self) -> None:
        self.scratch.mkdir(parents=True, exist_ok=True)
        self.checks_dir.mkdir(parents=True, exist_ok=True)
        if self.root.resolve() == self.repo.resolve():
            raise VerifyError(
                f"INVAR_VERIFY_ROOT is the repo ({self.repo}). "
                "Use a directory outside the checkout so cleanup cannot touch source."
            )

    def record(self, check: dict) -> dict:
        self.checks.append(check)
        self.checks_dir.mkdir(parents=True, exist_ok=True)
        path = self.checks_dir / f"{check['id']}.json"
        path.write_text(json.dumps(check, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return check

    def skip(self, check_id: str, feature: str, reason: str, command: list[str] | None = None) -> dict:
        return self.record(
            {
                "id": check_id,
                "feature": feature,
                "status": "skipped",
                "reason": reason,
                "command": command or [],
                "summary": reason,
            }
        )

    def dry(self, check_id: str, feature: str, summary: str, command: list[str]) -> dict:
        return self.record(
            {
                "id": check_id,
                "feature": feature,
                "status": "dry_run",
                "command": command,
                "summary": summary,
            }
        )

    def run(
        self,
        check_id: str,
        feature: str,
        argv: list[str],
        *,
        timeout: float,
        summary: str,
        expect,
        cwd: Path | None = None,
    ) -> dict:
        if self.dry_run:
            return self.dry(check_id, feature, summary, argv)
        try:
            completed = subprocess.run(
                argv,
                cwd=cwd or self.repo,
                check=False,
                capture_output=True,
                timeout=timeout,
            )
        except subprocess.TimeoutExpired as error:
            stdout = _decode(error.stdout)
            stderr = _decode(error.stderr)
            return self.record(
                {
                    "id": check_id,
                    "feature": feature,
                    "status": "fail",
                    "command": argv,
                    "summary": f"timed out after {timeout:.0f}s while {summary}",
                    "reason": f"timed out after {timeout:.0f}s",
                    "stdout_excerpt": stdout[-2000:],
                    "stderr_excerpt": stderr[-2000:],
                }
            )
        except OSError as error:
            return self.record(
                {
                    "id": check_id,
                    "feature": feature,
                    "status": "fail",
                    "command": argv,
                    "summary": f"could not run {argv[0]}: {error}",
                    "reason": str(error),
                }
            )
        stdout = _decode(completed.stdout)
        stderr = _decode(completed.stderr)
        document = _parse_json(stdout)
        problem = expect(
            completed.returncode,
            stdout,
            stderr,
            completed.stdout,
            document,
        )
        check = {
            "id": check_id,
            "feature": feature,
            "status": "fail" if problem else "pass",
            "command": argv,
            "exit_code": completed.returncode,
            "summary": problem or summary,
            "stdout_excerpt": stdout[:2000],
            "stderr_excerpt": stderr[:2000],
        }
        if problem:
            check["reason"] = problem
        if document is not None and not isinstance(document, str):
            check["document_status"] = document.get("status")
            if "result" in document:
                check["result"] = document.get("result")
        self.record(check)
        stored = dict(check)
        stored["stdout"] = stdout[:200_000]
        stored["stderr"] = stderr[:200_000]
        (self.checks_dir / f"{check_id}.json").write_text(
            json.dumps(stored, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        return check

    def require_binary(self) -> None:
        if self.dry_run:
            return
        if not self.binary.is_file():
            raise VerifyError(
                f"Invar binary is not at {self.binary}. Run `invar-verify build` first.",
                exit_code=1,
            )
        if not os.access(self.binary, os.X_OK):
            raise VerifyError(f"{self.binary} is not executable.", exit_code=1)


def _decode(data: bytes | None) -> str:
    if not data:
        return ""
    return data.decode("utf-8", errors="replace")


def _parse_json(stdout: str):
    text = stdout.strip()
    if not text:
        return None
    try:
        return json.loads(text)
    except json.JSONDecodeError as error:
        return f"stdout is not one JSON document: {error}"


def _ok(problem: str | None):
    return problem


def expect_help(code, stdout, stderr, raw, document) -> str | None:
    del stderr, raw, document
    if code != 0:
        return f"invar --help exited {code}, expected 0"
    if not stdout.startswith("Usage: invar --help"):
        return "help text does not start with 'Usage: invar --help'"
    for needle in (
        "invar check PATH",
        "invar run PATH --engine reference|native-serial|cuda|metal|auto",
        "invar run PATH --engine cpu-parallel --workers 1..64",
        "invar system gen ros2 PATH --out NEW_DIRECTORY",
        "invar source-device PATH",
        "invar gnet-device PATH",
    ):
        if needle not in stdout:
            return f"help text is missing {needle!r}"
    return None


def expect_usage(code, stdout, stderr, raw, document) -> str | None:
    del stdout, raw, document
    if code != 2:
        return f"usage error exited {code}, expected 2"
    if "Usage: invar --help" not in stderr:
        return "usage error did not print the help text on stderr"
    return None


def expect_json_status(
    expected_code,
    expected_status,
    code_field=None,
    value=None,
    empty_diagnostics=False,
):
    def expect(code, stdout, stderr, raw, document) -> str | None:
        del stdout, stderr, raw
        if code != expected_code:
            return f"exited {code}, expected {expected_code}"
        if isinstance(document, str):
            return document
        if not isinstance(document, dict):
            return "stdout was empty or not a JSON object"
        if document.get("status") != expected_status:
            return (
                f"status is {document.get('status')!r}, expected {expected_status!r}. "
                f"diagnostics={_diag_brief(document)}"
            )
        codes = _diag_codes(document)
        if empty_diagnostics and codes:
            return f"expected no diagnostics, found {codes}"
        if code_field is not None:
            trap = (document.get("trap") or {}).get("category")
            if code_field not in codes and trap != code_field:
                return f"diagnostic codes {codes} and trap {trap!r} do not include {code_field}"
        if value is not None:
            got = (document.get("result") or {}).get("value")
            if got != value:
                return f"result.value is {got!r}, expected {value!r}"
        return None

    return expect


def expect_checks_include(*names: str):
    def expect(code, stdout, stderr, raw, document) -> str | None:
        del stdout, stderr, raw
        base = expect_json_status(0, "ok")(code, "", "", b"", document)
        if base:
            return base
        completed = document.get("checks_completed")
        if not isinstance(completed, list):
            return "checks_completed is missing"
        missing = [name for name in names if name not in completed]
        if missing:
            return f"checks_completed {completed} is missing {missing}"
        return None

    return expect


def expect_region(function: str, status: str, kind: str):
    def expect(code, stdout, stderr, raw, document) -> str | None:
        del stdout, stderr, raw
        base = expect_json_status(0, "ok")(code, "", "", b"", document)
        if base:
            return base
        regions = document.get("regions")
        if not isinstance(regions, list):
            return "explain document has no regions array"
        for region in regions:
            if region.get("function") != function:
                continue
            execution = region.get("execution") if isinstance(region.get("execution"), dict) else {}
            got_kind = execution.get("kind", region.get("kind"))
            if region.get("status") != status or got_kind != kind:
                return (
                    f"region {function} is status {region.get('status')!r} "
                    f"kind {got_kind!r}, expected {status!r} {kind!r}"
                )
            return None
        return f"explain document has no region for {function}"

    return expect


def expect_source_device(result: int, completed_regions: int, fuel_limit: bool = False):
    def expect(code, stdout, stderr, raw, document) -> str | None:
        del stdout, stderr, raw
        if isinstance(document, str):
            return document
        if not isinstance(document, dict):
            return "source-device did not print a JSON object"
        if document.get("schema") != "invar-private-source-device-v1":
            return f"schema is {document.get('schema')!r}"
        if "gpu_execution_claim" in document:
            return "cpu-model report contains gpu_execution_claim; that would over-claim the run"
        if fuel_limit:
            if code == 0:
                return "fuel 1 was expected to fail and exited 0"
            error = document.get("error")
            if not isinstance(error, str) or "EvaluationLimit" not in error:
                return f"fuel-limit error is {error!r}"
            if document.get("completed_regions") != 0:
                return f"completed_regions is {document.get('completed_regions')!r}, expected 0"
            return None
        if code != 0:
            return f"source-device exited {code}: {document.get('error')}"
        if document.get("backend") != "cpu-model":
            return f"backend is {document.get('backend')!r}, expected cpu-model"
        if document.get("result") != result:
            return f"result is {document.get('result')!r}, expected {result}"
        if document.get("completed_regions") != completed_regions:
            return (
                f"completed_regions is {document.get('completed_regions')!r}, "
                f"expected {completed_regions}"
            )
        return None

    return expect


def expect_gnet(result: int, backend: str):
    def expect(code, stdout, stderr, raw, document) -> str | None:
        del stdout, stderr, raw
        if isinstance(document, str):
            return document
        if not isinstance(document, dict):
            return "gnet-device did not print a JSON object"
        if code != 0:
            return f"gnet-device exited {code}: {document.get('error')}"
        if document.get("result") != result:
            return f"result is {document.get('result')!r}, expected {result}"
        if document.get("status") != 0:
            return f"receipt status is {document.get('status')!r}, expected 0"
        execution = document.get("execution") if isinstance(document.get("execution"), dict) else {}
        if execution.get("evidence_backend") != "CpuGroupModel":
            return f"evidence_backend is {execution.get('evidence_backend')!r}, expected CpuGroupModel"
        if document.get("backend") != backend:
            return f"backend is {document.get('backend')!r}, expected {backend}"
        return None

    return expect


def expect_error_contains(needle: str):
    def expect(code, stdout, stderr, raw, document) -> str | None:
        del raw
        if code == 0:
            return f"expected a refusal containing {needle!r} and the command exited 0"
        blob = stdout + "\n" + stderr
        if isinstance(document, dict):
            blob += "\n" + json.dumps(document)
        if needle not in blob:
            return f"refusal text does not contain {needle!r}. stdout={stdout[:500]!r} stderr={stderr[:500]!r}"
        return None

    return expect


def expect_tool_code(code_name: str):
    def expect(code, stdout, stderr, raw, document) -> str | None:
        del stdout, stderr, raw
        if code != 2:
            return f"tool refusal exited {code}, expected 2"
        if isinstance(document, str):
            return document
        if not isinstance(document, dict):
            return "tool refusal did not print JSON"
        if document.get("status") != "tool_error":
            return f"status is {document.get('status')!r}, expected tool_error"
        codes = _diag_codes(document)
        if code_name not in codes:
            return f"diagnostic codes {codes} do not include {code_name}"
        return None

    return expect


def expect_generated(files: int):
    def expect(code, stdout, stderr, raw, document) -> str | None:
        del stdout, stderr, raw
        if code != 0:
            return f"system gen exited {code}"
        if isinstance(document, str):
            return document
        if not isinstance(document, dict):
            return "system gen did not print JSON"
        if document.get("status") != "ok":
            return f"status is {document.get('status')!r}"
        if document.get("generated_files") != files:
            return f"generated_files is {document.get('generated_files')!r}, expected {files}"
        return None

    return expect


def expect_sha256(expected: str):
    def expect(code, stdout, stderr, raw, document) -> str | None:
        del stdout, stderr, document
        if code != 0:
            return f"system ir exited {code}"
        digest = hashlib.sha256(raw).hexdigest()
        if digest != expected:
            return f"stdout sha256 is {digest}, expected {expected}"
        return None

    return expect


def expect_substring(code_expected: int, needle: str):
    def expect(code, stdout, stderr, raw, document) -> str | None:
        del raw, document
        if code != code_expected:
            return f"exited {code}, expected {code_expected}"
        if needle not in stdout and needle not in stderr:
            return f"output does not contain {needle!r}"
        return None

    return expect


def _diag_codes(document: dict) -> list:
    diagnostics = document.get("diagnostics")
    if not isinstance(diagnostics, list):
        return []
    return [item.get("code") for item in diagnostics if isinstance(item, dict)]


def _diag_brief(document: dict) -> str:
    diagnostics = document.get("diagnostics")
    if not isinstance(diagnostics, list) or not diagnostics:
        return "[]"
    first = diagnostics[0]
    if isinstance(first, dict):
        return f"{first.get('code')}: {first.get('message')}"
    return str(first)[:200]


def tree_hash(directory: Path) -> tuple[int, str]:
    files: list[tuple[str, Path]] = []
    for path in directory.rglob("*"):
        if path.is_file():
            files.append((path.relative_to(directory).as_posix(), path))
    files.sort()
    hasher = hashlib.sha256()
    for relative, path in files:
        data = path.read_bytes()
        hasher.update(f"{relative}\0{len(data)}\0".encode())
        hasher.update(data)
    return len(files), hasher.hexdigest()


def write_fixture(session: Session, name: str, text: str) -> Path:
    directory = session.scratch / "fixtures"
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / name
    path.write_text(text, encoding="utf-8")
    return path


def invar(session: Session, *args: str) -> list[str]:
    return [str(session.binary), *args]


def drive_parser(session: Session) -> None:
    feature = "parser"
    session.require_binary()
    good = session.repo / "examples" / "sum.inv"
    session.run(
        "parser.accept-sum",
        feature,
        invar(session, "check", str(good), "--format", "json"),
        timeout=60,
        summary="check examples/sum.inv accepts syntax, names, and types",
        expect=expect_checks_include("syntax", "names", "types"),
    )
    if session.dry_run:
        bad = session.scratch / "fixtures" / "parse-error.inv"
    else:
        bad = write_fixture(session, "parse-error.inv", PARSE_ERROR_SOURCE)
    session.run(
        "parser.reject-token",
        feature,
        invar(session, "check", str(bad), "--format", "json"),
        timeout=60,
        summary="a missing parameter type is PARSE_EXPECTED_TOKEN",
        expect=expect_json_status(1, "source_error", "PARSE_EXPECTED_TOKEN"),
    )


def drive_checker(session: Session) -> None:
    feature = "checker"
    session.require_binary()
    session.run(
        "checker.ownership-sum",
        feature,
        invar(session, "check", str(session.repo / "examples" / "sum.inv"), "--format", "json"),
        timeout=60,
        summary="sum.inv passes ownership, call loans, and view lifetimes",
        expect=expect_checks_include(
            "local_ownership",
            "call_loans",
            "view_lifetimes",
        ),
    )
    session.run(
        "checker.view-overlap",
        feature,
        invar(
            session,
            "check",
            str(session.repo / "examples" / "views" / "overlap.inv"),
            "--format",
            "json",
        ),
        timeout=60,
        summary="overlapping mutable views are OWN_BORROW_CONFLICT",
        expect=expect_json_status(1, "source_error", "OWN_BORROW_CONFLICT"),
    )
    session.run(
        "checker.view-return",
        feature,
        invar(
            session,
            "check",
            str(session.repo / "examples" / "views" / "invalid-return.inv"),
            "--format",
            "json",
        ),
        timeout=60,
        summary="returning a view of a local is OWN_RETURN_BORROW",
        expect=expect_json_status(1, "source_error", "OWN_RETURN_BORROW"),
    )
    session.run(
        "checker.foreign-callback",
        feature,
        invar(
            session,
            "check",
            str(session.repo / "examples" / "bytes" / "foreign-callback.inv"),
            "--format",
            "json",
        ),
        timeout=60,
        summary="a callback in a foreign signature is TYPE_MISMATCH",
        expect=expect_json_status(1, "source_error", "TYPE_MISMATCH"),
    )


def drive_reference(session: Session) -> None:
    feature = "reference"
    session.require_binary()
    cases = (
        ("reference.sum", "examples/sum.inv", 10, "examples/sum.inv returns 10"),
        ("reference.ownership", "examples/ownership.inv", 41, "examples/ownership.inv returns 41"),
        (
            "reference.recursion",
            "examples/language/recursion.inv",
            55,
            "examples/language/recursion.inv returns fib(10) = 55",
        ),
        (
            "reference.matrix",
            "examples/families/matrix-f32.inv",
            7,
            "examples/families/matrix-f32.inv returns 7",
        ),
        (
            "reference.transpose",
            "examples/families/transpose.inv",
            7,
            "examples/families/transpose.inv returns 7",
        ),
    )
    for check_id, relative, value, summary in cases:
        session.run(
            check_id,
            feature,
            invar(session, "run", str(session.repo / relative), "--engine", "reference", "--format", "json"),
            timeout=60,
            summary=summary,
            expect=expect_json_status(0, "ok", value=value),
        )
    session.run(
        "reference.checked-sum-traps",
        feature,
        invar(
            session,
            "run",
            str(session.repo / "examples" / "parallel" / "reduction-checked-sum.inv"),
            "--engine",
            "reference",
            "--format",
            "json",
        ),
        timeout=60,
        summary="the checked parallel sum traps with INTEGER_OVERFLOW on the reference engine",
        expect=expect_json_status(3, "trap", "INTEGER_OVERFLOW"),
    )


def drive_parallelism(session: Session) -> None:
    feature = "parallelism"
    session.require_binary()
    parallel = session.repo / "examples" / "parallel"
    for workers in (1, 2):
        session.run(
            f"parallelism.map-workers-{workers}",
            feature,
            invar(
                session,
                "run",
                str(parallel / "map-wrapping.inv"),
                "--engine",
                "cpu-parallel",
                "--workers",
                str(workers),
                "--format",
                "json",
            ),
            timeout=120,
            summary=f"wrapping map with {workers} workers returns 120",
            expect=expect_json_status(0, "ok", value=120),
        )
    session.run(
        "parallelism.reduction-workers-2",
        feature,
        invar(
            session,
            "run",
            str(parallel / "reduction-wrapping-sum.inv"),
            "--engine",
            "cpu-parallel",
            "--workers",
            "2",
            "--format",
            "json",
        ),
        timeout=120,
        summary="wrapping reduction with 2 workers returns 7",
        expect=expect_json_status(0, "ok", value=7),
    )
    session.run(
        "parallelism.scan-workers-2",
        feature,
        invar(
            session,
            "run",
            str(parallel / "scan-affine.inv"),
            "--engine",
            "cpu-parallel",
            "--workers",
            "2",
            "--format",
            "json",
        ),
        timeout=120,
        summary="affine scan with 2 workers returns 26",
        expect=expect_json_status(0, "ok", value=26),
    )
    session.run(
        "parallelism.checked-sum-still-traps",
        feature,
        invar(
            session,
            "run",
            str(parallel / "reduction-checked-sum.inv"),
            "--engine",
            "cpu-parallel",
            "--workers",
            "2",
            "--format",
            "json",
        ),
        timeout=120,
        summary="checked addition stays a trap under cpu-parallel",
        expect=expect_json_status(3, "trap", "INTEGER_OVERFLOW"),
    )
    session.run(
        "parallelism.sum-stays-serial",
        feature,
        invar(
            session,
            "run",
            str(session.repo / "examples" / "sum.inv"),
            "--engine",
            "cpu-parallel",
            "--workers",
            "2",
            "--format",
            "json",
        ),
        timeout=120,
        summary="the checked i32 sum still returns 10 when a parallel engine is requested",
        expect=expect_json_status(0, "ok", value=10),
    )
    session.run(
        "parallelism.explain-map",
        feature,
        invar(session, "explain", str(parallel / "map-wrapping.inv"), "--format", "json"),
        timeout=60,
        summary="explain admits main as a map",
        expect=expect_region("main", "admitted", "map"),
    )
    session.run(
        "parallelism.explain-sum",
        feature,
        invar(session, "explain", str(session.repo / "examples" / "sum.inv"), "--format", "json"),
        timeout=60,
        summary="explain rejects sum as serial because checked addition is not reassociated",
        expect=expect_region("sum", "rejected", "serial"),
    )
    session.run(
        "parallelism.auto-map",
        feature,
        invar(
            session,
            "run",
            str(parallel / "map-wrapping.inv"),
            "--engine",
            "auto",
            "--format",
            "json",
        ),
        timeout=120,
        summary="auto on the default build runs the wrapping map on CPU and returns 120",
        expect=expect_json_status(0, "ok", value=120),
    )
    if session.dry_run:
        source = session.scratch / "fixtures" / "gnet-entry.inv"
    else:
        source = write_fixture(session, "gnet-entry.inv", GNET_SOURCE)
    cxx = session.host["cxx"]
    if cxx.get("compiler") is None and not session.dry_run:
        for backend in ("cpu-model-cuda", "cpu-model-metal"):
            session.skip(
                f"parallelism.gnet-{backend}",
                feature,
                "Skipped gnet-device CPU model. " + cxx["detail"],
                ["invar", "gnet-device", str(source), "entry", backend, "[5]", GNET_CONFIG],
            )
    else:
        for backend in ("cpu-model-cuda", "cpu-model-metal"):
            session.run(
                f"parallelism.gnet-{backend}",
                feature,
                invar(
                    session,
                    "gnet-device",
                    str(source),
                    "entry",
                    backend,
                    "[5]",
                    GNET_CONFIG,
                ),
                timeout=300,
                summary=f"gnet-device {backend} returns 12 from the CPU group model",
                expect=expect_gnet(12, backend),
            )
    session.run(
        "parallelism.cpu-parallel-without-workers",
        feature,
        invar(
            session,
            "run",
            str(parallel / "map-wrapping.inv"),
            "--engine",
            "cpu-parallel",
            "--format",
            "json",
        ),
        timeout=30,
        summary="cpu-parallel without --workers is a usage error",
        expect=expect_usage,
    )


def drive_codegen(session: Session) -> None:
    feature = "codegen"
    session.require_binary()
    transpose = session.repo / "examples" / "families" / "transpose.inv"
    session.run(
        "codegen.transpose-cpu-model",
        feature,
        invar(
            session,
            "source-device",
            str(transpose),
            "transpose",
            "transpose",
            "cpu-model",
            "100000",
        ),
        timeout=180,
        summary="transpose source runs on the CUDA CPU model and returns 7",
        expect=expect_source_device(7, 1),
    )
    session.run(
        "codegen.transpose-fuel-limit",
        feature,
        invar(
            session,
            "source-device",
            str(transpose),
            "transpose",
            "transpose",
            "cpu-model",
            "1",
        ),
        timeout=60,
        summary="fuel 1 stops the CPU model before a completed region",
        expect=expect_source_device(0, 0, fuel_limit=True),
    )
    if session.dry_run:
        tensor = session.scratch / "fixtures" / "tensor-mat.inv"
    else:
        tensor = write_fixture(session, "tensor-mat.inv", TENSOR_SOURCE)
    session.run(
        "codegen.tensor-cpu-model",
        feature,
        invar(session, "source-device", str(tensor), "tensor", "mat", "cpu-model", "100000"),
        timeout=180,
        summary="tensor source runs on the CUDA CPU model and returns 7",
        expect=expect_source_device(7, 1),
    )
    session.run(
        "codegen.cuda-refuses-without-feature",
        feature,
        invar(
            session,
            "run",
            str(session.repo / "examples" / "sum.inv"),
            "--engine",
            "cuda",
            "--format",
            "json",
        ),
        timeout=60,
        summary="the default build refuses --engine cuda instead of pretending to run it",
        expect=expect_tool_code("CUDA_UNAVAILABLE"),
    )
    session.run(
        "codegen.metal-refuses-without-feature",
        feature,
        invar(
            session,
            "run",
            str(session.repo / "examples" / "sum.inv"),
            "--engine",
            "metal",
            "--format",
            "json",
        ),
        timeout=60,
        summary="the default build refuses --engine metal instead of pretending to run it",
        expect=expect_tool_code("METAL_UNAVAILABLE"),
    )
    session.run(
        "codegen.native-refuses-without-feature",
        feature,
        invar(
            session,
            "run",
            str(session.repo / "examples" / "sum.inv"),
            "--engine",
            "native-serial",
            "--format",
            "json",
        ),
        timeout=60,
        summary="the default build refuses --engine native-serial",
        expect=expect_tool_code("NATIVE_UNAVAILABLE"),
    )
    if session.dry_run:
        gnet = session.scratch / "fixtures" / "gnet-entry.inv"
    else:
        gnet = write_fixture(session, "gnet-entry.inv", GNET_SOURCE)
    session.run(
        "codegen.gnet-cuda-refuses",
        feature,
        invar(session, "gnet-device", str(gnet), "entry", "cuda", "[5]", GNET_CONFIG),
        timeout=60,
        summary="forced CUDA gnet-device refuses on a build without the cuda feature",
        expect=expect_error_contains("forced CUDA requires the cuda feature"),
    )
    session.run(
        "codegen.gnet-metal-refuses",
        feature,
        invar(session, "gnet-device", str(gnet), "entry", "metal", "[5]", GNET_CONFIG),
        timeout=60,
        summary="forced Metal gnet-device refuses on a build without the metal feature",
        expect=expect_error_contains("forced Metal requires the metal feature"),
    )
    llvm = session.host["llvm21"]
    if not llvm["available"]:
        session.skip(
            "codegen.native-serial-run",
            feature,
            "Skipped native LLVM execution. " + llvm["detail"],
            ["cargo", "build", "--locked", "--features", "native", "--bin", "invar"],
        )
    else:
        session.skip(
            "codegen.native-serial-run",
            feature,
            "LLVM 21 is visible, but this skill's binary is the default-feature build. "
            "A native-serial run needs a separate `cargo build --locked --features native` "
            "and is not part of the default proof.",
            ["cargo", "build", "--locked", "--features", "native", "--bin", "invar"],
        )
    nvidia = session.host["nvidia"]
    if not nvidia["present"]:
        session.skip(
            "codegen.cuda-hardware",
            feature,
            "Skipped CUDA hardware execution and `just test-gpu-cuda`. "
            + nvidia["detail"]
            + ". The default binary also has no cuda feature, so a GPU run would not be honest.",
            ["just", "test-gpu-cuda"],
        )
    else:
        session.skip(
            "codegen.cuda-hardware",
            feature,
            "An NVIDIA device is visible, but the verification binary was built without "
            "--features cuda. CUDA hardware tests stay skipped until that build exists.",
            ["just", "test-gpu-cuda"],
        )
    if not session.host["metal_host"]:
        session.skip(
            "codegen.metal-hardware",
            feature,
            "Skipped Metal hardware execution and `just test-metal`. "
            f"This host is {session.host['os']} {session.host['arch']}, not an Apple Silicon Mac.",
            ["just", "test-metal"],
        )
    else:
        session.skip(
            "codegen.metal-hardware",
            feature,
            "This is a Mac, but the verification binary was built without --features metal. "
            "Metal hardware tests stay skipped until that build exists.",
            ["just", "test-metal"],
        )


def drive_robotics(session: Session) -> None:
    feature = "robotics"
    session.require_binary()
    system = session.repo / "examples" / "system"
    session.run(
        "robotics.two-components",
        feature,
        invar(session, "system", "check", str(system / "two-components.inv"), "--format", "json"),
        timeout=60,
        summary="two-components.inv passes the system checker with no diagnostics",
        expect=expect_json_status(0, "ok", empty_diagnostics=True),
    )
    session.run(
        "robotics.two-producers",
        feature,
        invar(session, "system", "check", str(system / "two-producers.inv"), "--format", "json"),
        timeout=60,
        summary="two producers on one input are S1004",
        expect=expect_json_status(1, "source_error", "S1004"),
    )
    session.run(
        "robotics.twelve-warning",
        feature,
        invar(session, "system", "check", str(system / "twelve-components.inv"), "--format", "json"),
        timeout=60,
        summary="twelve-components.inv checks ok and reports the S1011 warning",
        expect=expect_json_status(0, "ok", "S1011"),
    )
    session.run(
        "robotics.two-components-ir",
        feature,
        invar(session, "system", "ir", str(system / "two-components.inv")),
        timeout=60,
        summary="system ir stdout matches the example index sha256",
        expect=expect_sha256(TWO_COMPONENTS_IR_SHA256),
    )
    generated_root = session.scratch / "generated"
    if not session.dry_run:
        generated_root.mkdir(parents=True, exist_ok=True)
    hashes = []
    for attempt in (1, 2):
        out = generated_root / f"twelve-ros2-{os.getpid()}-{attempt}"
        command = invar(
            session,
            "system",
            "gen",
            "ros2",
            str(system / "twelve-components.inv"),
            "--out",
            str(out),
        )
        if session.dry_run:
            session.dry(
                f"robotics.ros2-gen-{attempt}",
                feature,
                "would generate a ROS 2 workspace and hash the new directory",
                command,
            )
            continue
        session.run(
            f"robotics.ros2-gen-{attempt}",
            feature,
            command,
            timeout=60,
            summary=f"generate ROS 2 workspace attempt {attempt} writes {TWELVE_ROS2_FILES} files",
            expect=expect_generated(TWELVE_ROS2_FILES),
        )
        if not out.is_dir():
            session.record(
                {
                    "id": f"robotics.ros2-tree-{attempt}",
                    "feature": feature,
                    "status": "fail",
                    "command": command,
                    "summary": f"generated directory {out} is missing, so the tree was not hashed",
                    "reason": "generator did not publish the output directory",
                }
            )
            continue
        count, digest = tree_hash(out)
        hashes.append((count, digest))
        problem = None
        if count != TWELVE_ROS2_FILES or digest != TWELVE_ROS2_TREE_SHA256:
            problem = (
                f"tree is {count} files {digest}, expected "
                f"{TWELVE_ROS2_FILES} files {TWELVE_ROS2_TREE_SHA256}"
            )
        session.record(
            {
                "id": f"robotics.ros2-tree-{attempt}",
                "feature": feature,
                "status": "fail" if problem else "pass",
                "command": ["tree-sha256", str(out)],
                "summary": problem
                or f"ROS 2 tree matches the example index ({count} files)",
                "reason": problem,
                "files": count,
                "tree_sha256": digest,
            }
        )
    if not session.dry_run and len(hashes) == 2 and hashes[0] != hashes[1]:
        session.record(
            {
                "id": "robotics.ros2-deterministic",
                "feature": feature,
                "status": "fail",
                "summary": f"two generations differ: {hashes[0]} vs {hashes[1]}",
                "reason": "ROS 2 generation was not deterministic",
            }
        )
    elif session.dry_run:
        session.dry(
            "robotics.ros2-deterministic",
            feature,
            "would compare the two generated trees",
            ["tree-sha256", "attempt-1", "attempt-2"],
        )
    else:
        session.record(
            {
                "id": "robotics.ros2-deterministic",
                "feature": feature,
                "status": "pass" if len(hashes) == 2 else "fail",
                "summary": "two ROS 2 generations produced the same tree hash"
                if len(hashes) == 2
                else "could not compare two generations",
                "reason": None if len(hashes) == 2 else "a generation did not publish a tree",
            }
        )
    if session.host["ros2"] is None:
        session.skip(
            "robotics.ros2-runtime",
            feature,
            "Skipped colcon/ROS 2 runtime and robot hardware. `ros2` is not on PATH, "
            "and this VM has no robot controller. Workspace generation above is the check that can run.",
            ["ros2", "launch"],
        )
    else:
        session.skip(
            "robotics.ros2-runtime",
            feature,
            "ros2 is on PATH, but this drive does not launch a controller or claim a hardware run.",
            ["ros2", "launch"],
        )
    session.skip(
        "robotics.component-test",
        feature,
        "Skipped `invar component test`. The cell fixtures load a foreign shared library "
        "and a separate-process planner; this drive does not build that library or start the fixture server.",
        [
            "invar",
            "component",
            "test",
            "examples/cells/reach_place/components/process_fixture/manifest.inv",
        ],
    )


def drive_cli(session: Session) -> None:
    feature = "cli"
    session.require_binary()
    session.run(
