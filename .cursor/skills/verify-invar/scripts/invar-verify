            "--format",
            "json",
        ),
        timeout=60,
        summary="invar check on a system file uses the system checker and returns status ok",
        expect=expect_json_status(0, "ok"),
    )


def drive_tests(session: Session, jobs: int) -> None:
    feature = "tests"
    script = session.repo / "scripts" / "check-file-size"
    session.run(
        "tests.file-size",
        feature,
        [str(script)],
        timeout=120,
        summary="the file-size ratchet reports 0 violations",
        expect=expect_substring(0, "0 violations"),
    )
    cargo = [
        "cargo",
        "test",
        "--locked",
        "--bin",
        "invar",
        "--jobs",
        str(jobs),
        FOCUSED_TEST,
    ]

    def expect_one_pass(code, stdout, stderr, raw, document) -> str | None:
        del raw, document
        blob = stdout + "\n" + stderr
        if code != 0:
            tail = "\n".join(blob.splitlines()[-30:])
            return f"cargo test exited {code}.\n{tail}"
        if "1 passed" not in blob:
            return f"cargo test did not report '1 passed'. tail:\n" + "\n".join(blob.splitlines()[-20:])
        if "0 passed" in blob and "1 passed" not in blob:
            return "cargo test matched no tests"
        return None

    if session.dry_run:
        session.dry("tests.focused-bin", feature, "would run one invar binary test", cargo)
    else:
        _cargo_locked(
            session,
            "tests.focused-bin",
            feature,
            cargo,
            timeout=3600,
            summary=f"cargo test --bin invar {FOCUSED_TEST} passes one test",
            expect=expect_one_pass,
        )
    if session.host["nextest"] is None:
        session.skip(
            "tests.full-nextest",
            feature,
            "Skipped the CI suite (`cargo nextest` Debug, Release, and doctests). "
            "cargo-nextest is not installed. `just test` is the full gate and is not part of "
            "the cloud proof; it runs the whole corpus and takes far longer than this drive.",
            [
                "cargo",
                "nextest",
                "run",
                "--locked",
                "--profile",
                "ci",
                "-p",
                "invar",
                "-p",
                "invar-tools",
            ],
        )
    else:
        session.skip(
            "tests.full-nextest",
            feature,
            "cargo-nextest is installed, but the default drive does not launch the full "
            "Debug+Release corpus. Run `invar-verify test --profile full` for that gate.",
            ["invar-verify", "test", "--profile", "full"],
        )


def _cargo_locked(session: Session, check_id, feature, argv, *, timeout, summary, expect) -> dict:
    import fcntl

    lock_path = session.root / "cargo.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+") as handle:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise VerifyError(
                "another invar-verify build or test holds the cargo target lock at "
                f"{lock_path}. Refusing to share one target directory.",
            ) from error
        return session.run(
            check_id,
            feature,
            argv,
            timeout=timeout,
            summary=summary,
            expect=expect,
        )


DRIVERS = {
    "parser": drive_parser,
    "checker": drive_checker,
    "reference": drive_reference,
    "parallelism": drive_parallelism,
    "codegen": drive_codegen,
    "robotics": drive_robotics,
    "cli": drive_cli,
}


def do_doctor(session: Session) -> dict:
    binary_ok = False
    help_problem = None
    if session.binary.is_file():
        code, out, err = command_output([str(session.binary), "--help"], timeout=30)
        binary_ok = code == 0 and out.startswith("Usage: invar --help")
        if not binary_ok:
            help_problem = f"`{session.binary} --help` exited {code}: {(err or out)[:300]}"
    else:
        help_problem = f"no binary at {session.binary}"
    rustc = session.host.get("rustc") or ""
    toolchain_ok = rustc.startswith("rustc 1.95.")
    ready = binary_ok and toolchain_ok and session.host.get("cargo") is not None
    report = {
        "schema": SCHEMA,
        "command": "doctor",
        "ready": ready,
        "repo": str(session.repo),
        "binary": str(session.binary),
        "binary_ok": binary_ok,
        "toolchain_ok": toolchain_ok,
        "host": session.host,
        "evidence_dir": str(session.evidence),
        "scratch_dir": str(session.scratch),
        "reason": None if ready else help_problem or "rustc is not 1.95 or cargo is missing",
    }
    if not toolchain_ok:
        report["reason"] = (
            f"rustc is {rustc or 'missing'}; rust-toolchain.toml pins 1.95.0. "
            + (help_problem or "")
        ).strip()
    session.evidence.mkdir(parents=True, exist_ok=True)
    (session.evidence / "doctor.json").write_text(
        json.dumps(report, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return report


def do_build(session: Session, jobs: int) -> dict:
    argv = [
        "cargo",
        "build",
        "--locked",
        "--bin",
        "invar",
        "--jobs",
        str(jobs),
    ]
    if session.dry_run:
        check = session.dry("build.default", "build", "would build the default-feature invar binary", argv)
        return {"schema": SCHEMA, "command": "build", "ok": True, "checks": [check]}

    def expect(code, stdout, stderr, raw, document) -> str | None:
        del stdout, raw, document
        if code != 0:
            tail = "\n".join((stderr or "").splitlines()[-40:])
            return f"cargo build exited {code}.\n{tail}"
        if not session.binary.is_file():
            return f"cargo build exited 0 but {session.binary} is missing"
        return None

    check = _cargo_locked(
        session,
        "build.default",
        "build",
        argv,
        timeout=7200,
        summary=f"cargo build --locked --bin invar -j {jobs} produced {session.binary}",
        expect=expect,
    )
    return {
        "schema": SCHEMA,
        "command": "build",
        "ok": check["status"] == "pass",
        "checks": [check],
        "binary": str(session.binary),
    }


def do_cleanup(session: Session) -> dict:
    scratch = session.scratch.resolve()
    root = session.root.resolve()
    if scratch != root and root not in scratch.parents:
        raise VerifyError(f"refusing to clean {scratch}; it is not under {root}")
    if session.repo.resolve() in scratch.parents or scratch == session.repo.resolve():
        raise VerifyError(f"refusing to clean {scratch}; it overlaps the repo")
    planned = []
    if scratch.exists():
        planned.append(str(scratch))
    if session.dry_run:
        return {
            "schema": SCHEMA,
            "command": "cleanup",
            "ok": True,
            "dry_run": True,
            "would_remove": planned,
            "preserved": [str(session.evidence)],
        }
    if scratch.exists():
        shutil.rmtree(scratch)
    return {
        "schema": SCHEMA,
        "command": "cleanup",
        "ok": True,
        "dry_run": False,
        "removed": planned,
        "preserved": [str(session.evidence)],
        "evidence_still_present": session.evidence.is_dir(),
    }


def do_test(session: Session, jobs: int, profile: str) -> dict:
    if profile == "focused":
        before = len(session.checks)
        drive_tests(session, jobs)
        checks = session.checks[before:]
        ok = all(item["status"] in ("pass", "skipped", "dry_run") for item in checks)
        return {"schema": SCHEMA, "command": "test", "profile": profile, "ok": ok, "checks": checks}
    if session.host["nextest"] is None or session.host["just"] is None:
        missing = []
        if session.host["nextest"] is None:
            missing.append("cargo-nextest")
        if session.host["just"] is None:
            missing.append("just")
        raise VerifyError(
            "the full suite is `just test` (cargo nextest Debug and Release, then doctests). "
            f"Missing: {', '.join(missing)}. Install them and rerun, or use --profile focused.",
            exit_code=2,
        )
    if session.dry_run:
        check = session.dry("tests.full-nextest", "tests", "would run just test", ["just", "test"])
        return {"schema": SCHEMA, "command": "test", "profile": profile, "ok": True, "checks": [check]}
    env = os.environ.copy()
    env.setdefault("NEXTEST_TEST_THREADS", "8")
    env.setdefault("INVAR_TEST_TIMEOUT_SCALE", "8")
    env.setdefault("INVAR_FULL_CORPUS", "1")
    # `just test` is the documented full gate. It is intentionally not the default.
    completed = subprocess.run(
        ["just", "test"],
        cwd=session.repo,
        check=False,
        capture_output=True,
        timeout=86400,
        env=env,
    )
    stdout = _decode(completed.stdout)
    stderr = _decode(completed.stderr)
    problem = None if completed.returncode == 0 else f"just test exited {completed.returncode}"
    check = session.record(
        {
            "id": "tests.full-nextest",
            "feature": "tests",
            "status": "fail" if problem else "pass",
            "command": ["just", "test"],
            "exit_code": completed.returncode,
            "summary": problem or "just test passed",
            "reason": problem,
            "stdout_excerpt": stdout[-2000:],
            "stderr_excerpt": stderr[-2000:],
        }
    )
    return {
        "schema": SCHEMA,
        "command": "test",
        "profile": profile,
        "ok": check["status"] == "pass",
        "checks": [check],
    }


def do_drive(session: Session, feature: str, jobs: int) -> dict:
    before = len(session.checks)
    if feature == "all":
        for name in FEATURES:
            if name == "tests":
                drive_tests(session, jobs)
            else:
                DRIVERS[name](session)
    elif feature == "tests":
        drive_tests(session, jobs)
    else:
        DRIVERS[feature](session)
    checks = session.checks[before:]
    failed = [item["id"] for item in checks if item["status"] == "fail"]
    return {
        "schema": SCHEMA,
        "command": "drive",
        "feature": feature,
        "ok": not failed,
        "failed": failed,
        "checks": [_public_check(item) for item in checks],
    }


def do_suite(session: Session, jobs: int) -> dict:
    build_report = do_build(session, jobs)
    if not session.dry_run and not build_report["ok"]:
        return {
            "schema": SCHEMA,
            "command": "suite",
            "ok": False,
            "failed": ["build.default"],
            "checks": [_public_check(item) for item in session.checks],
            "evidence_dir": str(session.evidence),
        }
    drive_report = do_drive(session, "all", jobs)
    doctor = do_doctor(session)
    failed = [item["id"] for item in session.checks if item["status"] == "fail"]
    skipped = [item["id"] for item in session.checks if item["status"] == "skipped"]
    report = {
        "schema": SCHEMA,
        "command": "suite",
        "ok": not failed and (session.dry_run or doctor["ready"]),
        "ready": doctor["ready"],
        "failed": failed,
        "skipped": skipped,
        "passed": [item["id"] for item in session.checks if item["status"] == "pass"],
        "dry_run": [item["id"] for item in session.checks if item["status"] == "dry_run"],
        "checks": [_public_check(item) for item in session.checks],
        "evidence_dir": str(session.evidence),
        "binary": str(session.binary),
        "host": session.host,
    }
    if not doctor["ready"] and not session.dry_run:
        report["ok"] = False
        report["reason"] = doctor["reason"]
    (session.evidence / "suite.json").write_text(
        json.dumps(report, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    # drive_report is reflected in report["checks"]; keep the name used so a
    # reader can see suite includes every feature drive.
    del drive_report
    return report


def _public_check(item: dict) -> dict:
    keep = (
        "id",
        "feature",
        "status",
        "summary",
        "reason",
        "command",
        "exit_code",
        "document_status",
        "result",
        "files",
        "tree_sha256",
    )
    return {key: item[key] for key in keep if key in item and item[key] is not None}


def emit(report: dict, fmt: str) -> int:
    ok = bool(report.get("ok", report.get("ready", False)))
    if fmt == "json":
        json.dump(report, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
    else:
        command = report.get("command", "verify")
        print(f"{command}: {'ok' if ok else 'FAILED'}")
        if report.get("reason"):
            print(report["reason"])
        if report.get("ready") is not None and command == "doctor":
            print(f"ready: {report['ready']}")
            print(f"binary: {report.get('binary')}")
            host = report.get("host") or {}
            print(f"rustc: {host.get('rustc')}")
            print(f"llvm21: {host.get('llvm21')}")
            print(f"nvidia: {host.get('nvidia')}")
            print(f"ros2: {host.get('ros2')}")
            print(f"cxx: {host.get('cxx')}")
        for check in report.get("checks") or []:
            status = check["status"].upper()
            line = f"{status} {check['id']}: {check.get('summary') or check.get('reason') or ''}"
            print(line)
        if "would_remove" in report:
            print("would remove:")
            for path in report["would_remove"]:
                print(f"  {path}")
            print("preserved:")
            for path in report["preserved"]:
                print(f"  {path}")
        if "removed" in report:
            print(f"removed: {report['removed'] or '(nothing)'}")
            print(f"evidence still present: {report['evidence_still_present']}")
            print(f"preserved: {report['preserved']}")
        if report.get("evidence_dir"):
            print(f"evidence: {report['evidence_dir']}")
    if report.get("command") == "doctor":
        return 0 if report.get("ready") else 1
    return 0 if ok else 1


def build_parser() -> argparse.ArgumentParser:
    # Defaults are SUPPRESS so a global flag is accepted on either side of the
    # subcommand without the side that did not see it writing over the other.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--format", choices=("text", "json"), default=argparse.SUPPRESS)
    common.add_argument(
        "--repo",
        type=Path,
        default=argparse.SUPPRESS,
        help="checkout root (default: walk up from the cwd, then from this script)",
    )
    common.add_argument(
        "--root",
        type=Path,
        default=argparse.SUPPRESS,
        help="scratch and evidence root (default: $INVAR_VERIFY_ROOT or /tmp/invar-verify)",
    )
    common.add_argument(
        "--dry-run",
        action="store_true",
        default=argparse.SUPPRESS,
        help="print the side-effecting commands and do not run them",
    )
    common.add_argument(
        "--jobs",
        type=int,
        default=argparse.SUPPRESS,
        help="cargo build/test parallelism (default: 2, or $INVAR_VERIFY_JOBS)",
    )
    parser = argparse.ArgumentParser(
        prog="invar-verify",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        parents=[common],
        description=textwrap.dedent(
            """\
            Build and drive Invar from a checkout, then write JSON evidence.

            The compiler is a short-lived CLI. There is no server to keep up.
            `build` produces target/debug/invar with default features. `drive`
            and `suite` run that binary on real examples. GPU, Metal, LLVM
            native, and ROS 2 hardware runs are recorded as skipped when this
            host cannot perform them. CPU reference, cpu-parallel, and the
            device CPU models still run.

            Evidence is written to $INVAR_VERIFY_ROOT/evidence (default
            /tmp/invar-verify/evidence). `cleanup` deletes only
            $INVAR_VERIFY_ROOT/scratch.
            """
        ),
        epilog=textwrap.dedent(
            """\
            examples:
              invar-verify doctor --format json
              invar-verify build --jobs 2 --format json
              invar-verify drive parser --format json
              invar-verify drive parallelism --format json
              invar-verify suite --format json
              invar-verify run -- check examples/sum.inv --format json
              invar-verify cleanup --dry-run --format json
              invar-verify cleanup --format json

            destructive commands (honour --dry-run):
              build     writes target/
              drive robotics   writes a generated ROS 2 tree under scratch
              test      writes target/ (cargo test profile)
              cleanup   deletes the scratch directory
            """
        ),
    )
    sub = parser.add_subparsers(dest="command", required=True)

    def command(name: str, help_text: str) -> argparse.ArgumentParser:
        return sub.add_parser(name, help=help_text, parents=[common])

    command("doctor", "read-only check that the binary and toolchain are worth driving")
    command("build", "cargo build --locked --bin invar (default features)")
    drive = command("drive", "run one feature recipe, or 'all'")
    drive.add_argument("feature", choices=(*FEATURES, "all"))
    command("suite", "build, then drive every feature, including the focused test")
    test = command("test", "run the focused cargo test, or the full just test gate")
    test.add_argument("--profile", choices=("focused", "full"), default="focused")
    run = command("run", "run the built binary with the following arguments and capture JSON evidence")
    run.add_argument("argv", nargs=argparse.REMAINDER, help="arguments after --")
    command("cleanup", "delete scratch files and keep evidence")
    parser.set_defaults(
        format="text",
        repo=None,
        root=None,
        dry_run=False,
        jobs=int(os.environ.get("INVAR_VERIFY_JOBS", "2")),
    )
    return parser


def normalize_argv(argv: list[str]) -> list[str]:
    """Accept global flags on either side of the subcommand.

    Argparse keeps a parent flag that appears before the subcommand, then the
    subparser's defaults replace it. Moving those flags to just after the
    subcommand makes both orders apply.
    """
    if not argv or argv[0] in {"-h", "--help"}:
        return argv
    valued = {"--format", "--repo", "--root", "--jobs"}
    options: list[str] = []
    positionals: list[str] = []
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--":
            positionals.extend(argv[index:])
            break
        if arg in valued and index + 1 < len(argv):
            options.extend((arg, argv[index + 1]))
            index += 2
            continue
        if arg == "--dry-run":
            options.append(arg)
            index += 1
            continue
        positionals.append(arg)
        index += 1
    if not positionals:
        return options
    return [positionals[0], *options, *positionals[1:]]


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(normalize_argv(list(sys.argv[1:] if argv is None else argv)))
    if args.jobs < 1 or args.jobs > 16:
        raise VerifyError("--jobs must be from 1 to 16")
    jobs = args.jobs
    repo = resolve_repo(args.repo)
    root = args.root or Path(os.environ.get("INVAR_VERIFY_ROOT", str(DEFAULT_ROOT)))
    session = Session(repo, root, args.dry_run)
    session.prepare_dirs()
    if args.command == "doctor":
        report = do_doctor(session)
    elif args.command == "build":
        report = do_build(session, jobs)
    elif args.command == "drive":
        report = do_drive(session, args.feature, jobs)
    elif args.command == "suite":
        report = do_suite(session, jobs)
    elif args.command == "test":
        report = do_test(session, jobs, args.profile)
    elif args.command == "cleanup":
        report = do_cleanup(session)
    elif args.command == "run":
        forwarded = list(args.argv)
        if forwarded and forwarded[0] == "--":
            forwarded = forwarded[1:]
        if not forwarded:
            raise VerifyError("run needs the invar arguments after --")
        session.require_binary()
        check = session.run(
            "run.once",
            "run",
            invar(session, *forwarded),
            timeout=180,
            summary="captured one invar invocation",
            expect=lambda code, stdout, stderr, raw, document: None,
        )
        report = {
            "schema": SCHEMA,
            "command": "run",
            "ok": check["status"] in {"pass", "dry_run"},
            "checks": [_public_check(check)],
            "evidence_dir": str(session.evidence),
        }
    else:
        raise VerifyError(f"unknown command {args.command}")
    return emit(report, args.format)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except VerifyError as error:
        print(f"invar-verify: {error}", file=sys.stderr)
        sys.exit(error.exit_code)
    except KeyboardInterrupt:
        print("invar-verify: interrupted", file=sys.stderr)
        sys.exit(130)
