#!/usr/bin/env python3
"""Drive the Invar compiler the way a user does, and record the evidence.

The binary is a short-lived CLI. Each check is its own process. Scratch files
live under $INVAR_VERIFY_ROOT/scratch. Proof transcripts live under
$INVAR_VERIFY_ROOT/evidence and survive `cleanup`.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import shutil
import subprocess
import sys
import tempfile
import textwrap
from pathlib import Path

SCHEMA = "invar-verify-v1"
DEFAULT_ROOT = Path("/tmp/invar-verify")
FEATURES = (
    "parser",
    "checker",
    "reference",
    "parallelism",
    "codegen",
    "robotics",
    "cli",
    "tests",
)

