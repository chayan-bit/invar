#include "node.hpp"
#include <exception>
#include <iostream>
#include <memory>
#include <rclcpp/rclcpp.hpp>
int main(int argc, char ** argv) {
  rclcpp::init(argc, argv);
  int result = 0;
  try {
    auto node = std::make_shared<@NAMESPACE@::ComponentNode>(rclcpp::NodeOptions{});
    rclcpp::spin(node);
    node->stop_planner();
  } catch (const std::exception &) {
    // The planner boundary prints its typed failure before throwing. Never claim success here.
    std::cerr << "planner process failed\n";
    result = 1;
  }
  rclcpp::shutdown();
  return result;
}
